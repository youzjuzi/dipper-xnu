+int
+lx_ath10k_translate(const struct ath10k_qmi_wlan_enable_cfg *in, struct lx_ath10k_cfg *out)
+{
+	if (!out)
+		return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	if (!in || in->num_ce_tgt_cfg > 12 || in->num_ce_svc_pipe_cfg > 24 ||
+	    in->num_shadow_reg_cfg > 24 || (in->num_ce_tgt_cfg && !in->ce_tgt_cfg) ||
+	    (in->num_ce_svc_pipe_cfg && !in->ce_svc_cfg) || (in->num_shadow_reg_cfg && !in->shadow_reg_cfg))
+		return -EINVAL;
+	for (u32 i = 0; i < in->num_ce_tgt_cfg; i++) {
+		const struct ath10k_tgt_pipe_cfg *p = &in->ce_tgt_cfg[i];
+		out->tgt[i] = (struct lx_wlfw_ce_tgt) {
+			le32_to_cpu(p->pipe_num), le32_to_cpu(p->pipe_dir), le32_to_cpu(p->nentries),
+			le32_to_cpu(p->nbytes_max), le32_to_cpu(p->flags)
+		};
+	}
+	for (u32 i = 0; i < in->num_ce_svc_pipe_cfg; i++) {
+		const struct ath10k_svc_pipe_cfg *p = &in->ce_svc_cfg[i];
+		out->svc[i] = (struct lx_wlfw_ce_svc) {
+			le32_to_cpu(p->service_id), le32_to_cpu(p->pipe_dir), le32_to_cpu(p->pipe_num)
+		};
+	}
+	for (u32 i = 0; i < in->num_shadow_reg_cfg; i++) {
+		const struct ath10k_shadow_reg_cfg *p = &in->shadow_reg_cfg[i];
+		out->shadow[i] = (struct lx_wlfw_shadow) { le16_to_cpu(p->ce_id), le16_to_cpu(p->reg_offset) };
+	}
+	out->cfg = (struct lx_wlfw_cfg) { in->num_ce_tgt_cfg, in->num_ce_svc_pipe_cfg,
+		in->num_shadow_reg_cfg, out->tgt, out->svc, out->shadow };
