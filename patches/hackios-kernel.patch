+	bus.napi = n;
+}
+void linuxkpi_napi_synchronize(struct napi_struct *n) { mutex_lock(&bus.service); mutex_unlock(&bus.service); }
+void linuxkpi_napi_disable(struct napi_struct *n)
+{
+	lx_os_lock(); bus.napi_enabled = false; bus.pending = false; lx_os_unlock();
+	linuxkpi_napi_synchronize(n);
+}
+void linuxkpi_napi_enable(struct napi_struct *n) { lx_os_lock(); bus.napi_enabled = true; lx_os_unlock(); }
+void linuxkpi_netif_napi_del(struct napi_struct *n) { linuxkpi_napi_disable(n); bus.napi = NULL; }
+bool linuxkpi_napi_schedule(struct napi_struct *n)
+{
