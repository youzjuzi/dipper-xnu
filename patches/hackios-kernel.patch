+			l->mpidr = m;
+			l->el = 1;
+			{
+				uint64_t c0, c1, t0, t1, want = READ_SYSREG(CNTFRQ_EL0) / 50;
+
+				__asm__ volatile ("msr pmcr_el0, %0\n msr pmcntenset_el0, %1\n isb" : : "r" (5ULL), "r" (1ULL << 31));
+				t0 = READ_SYSREG(CNTVCT_EL0);
+				__asm__ volatile ("mrs %0, pmccntr_el0" : "=r" (c0));
+				while (READ_SYSREG(CNTVCT_EL0) - t0 < want) {
+				}
+				__asm__ volatile ("mrs %0, pmccntr_el0" : "=r" (c1));
+				t1 = READ_SYSREG(CNTVCT_EL0);
+				l->cycles = c1 - c0;
+				l->ticks = t1 - t0;
+			}
+			l->done = 1;
+		} else {
+			memset(l, 0, sizeof(*l));
+			clean_dcache((uint64_t)(uintptr_t)l, (uint64_t)(uintptr_t)l + sizeof(*l));
+			status = psci_call(PSCI_CPU_ON, mpidr, (uint64_t)(uintptr_t)&id_probe_entry, (uint64_t)(uintptr_t)l);
+			t = READ_SYSREG(CNTVCT_EL0);
+			while (status == 0 && seconds_since(t) < 3) {
+				flush_dcache((uint64_t)(uintptr_t)l, (uint64_t)(uintptr_t)l + sizeof(*l));
+				if (l->done) {
+					break;
+				}
+			}
+			flush_dcache((uint64_t)(uintptr_t)l, (uint64_t)(uintptr_t)l + sizeof(*l));
+		}
+		if (!l->done) {
+			print("idprobe: core %d (mpidr %x): firmware says %d, no answer\n", (uint64_t)core, mpidr, (uint64_t)status);
+			continue;
+		}
+		print("idprobe: core %d mpidr %x EL%d MIDR %x part %x\n", (uint64_t)core, l->mpidr & 0xFFFFFF, l->el, l->midr,
+		    (l->midr >> 4) & 0xFFF);
+		print("  clock: %d cycles in %d ticks of %d Hz = %d MHz\n", l->cycles, l->ticks, READ_SYSREG(CNTFRQ_EL0),
+		    l->ticks ? l->cycles * (READ_SYSREG(CNTFRQ_EL0) / 1000) / l->ticks / 1000 : 0);
+		print("  MMFR0 %x TGran16 %d TGran4 %d TGran64 %d | ISAR0 %x ISAR1 %x APA %d API %d GPA %d GPI %d | PFR0 %x\n",
+		    l->mmfr0, (l->mmfr0 >> 20) & 0xF, (l->mmfr0 >> 28) & 0xF, (l->mmfr0 >> 24) & 0xF, l->isar0, l->isar1,
+		    (l->isar1 >> 4) & 0xF, (l->isar1 >> 8) & 0xF, (l->isar1 >> 24) & 0xF, (l->isar1 >> 28) & 0xF, l->pfr0);
+	}
+	print("idprobe: done\n");
+}
+
+static uint64_t
+mmio_r64(uint64_t a)
+{
+	return *(volatile uint64_t *)a;
+}
+
+static void
+timer_probe(void)
+{
+	uint64_t mpidr = READ_SYSREG(MPIDR_EL1), freq = READ_SYSREG(CNTFRQ_EL0);
+	uint64_t aff = (mpidr & 0xFFFFFF) | (((mpidr >> 32) & 0xFF) << 24);
+	uint64_t rd = 0;
+
+	print("tprobe: mpidr %x cntfrq %d\n", mpidr, freq);
+	for (unsigned i = 0; i < 16; i++) {
+		uint64_t frame = PLAT->gic_redist + (uint64_t)i * 0x20000;
+		uint64_t typer = mmio_r64(frame + 0x08);
+
+		print("tprobe: gicr[%d] at %x typer %x\n", (uint64_t)i, frame, typer);
+		if ((typer >> 32) == aff) {
+			rd = frame;
+			break;
+		}
+		if (typer & 0x10) {
+			break;
+		}
+	}
+	if (rd == 0) {
+		print("tprobe: no redistributor frame for this core\n");
+		return;
+	}
+
+	uint64_t sgi = rd + 0x10000;
+	uint64_t daif, ctl0, ctl1, pend0, pend1, pend2, enabled, t;
+
+	print("tprobe: rd %x waker %x\n", rd, (uint64_t)mmio_r32(rd + 0x14));
+	print("tprobe: igroupr0 %x grpmodr0 %x isenabler0 %x icfgr1 %x\n", (uint64_t)mmio_r32(sgi + 0x80),
+	    (uint64_t)mmio_r32(sgi + 0xD00), (uint64_t)mmio_r32(sgi + 0x100), (uint64_t)mmio_r32(sgi + 0xC04));
+
+	__asm__ volatile ("mrs %0, daif" : "=r" (daif));
+	__asm__ volatile ("msr daifset, #3" ::: "memory");
+	__asm__ volatile ("msr cntv_ctl_el0, %0; isb" :: "r" (0ULL) : "memory");
+	ctl0 = READ_SYSREG(CNTV_CTL_EL0);
+	pend0 = mmio_r32(sgi + 0x200);
+	__asm__ volatile ("msr cntv_tval_el0, %0" :: "r" (freq / 1000) : "memory");
+	__asm__ volatile ("msr cntv_ctl_el0, %0; isb" :: "r" (1ULL) : "memory");
+	t = READ_SYSREG(CNTVCT_EL0);
+	while (READ_SYSREG(CNTVCT_EL0) - t < freq / 200) {
+	}
+	ctl1 = READ_SYSREG(CNTV_CTL_EL0);
+	pend1 = mmio_r32(sgi + 0x200);
+	enabled = mmio_r32(sgi + 0x100);
+	__asm__ volatile ("msr cntv_ctl_el0, %0; isb" :: "r" (0ULL) : "memory");
+	pend2 = mmio_r32(sgi + 0x200);
+	__asm__ volatile ("msr daif, %0" :: "r" (daif) : "memory");
+
+	print("tprobe: CNTV_CTL before %x, after 5 ms %x (bit 2 = ISTATUS: the timer fired)\n", ctl0, ctl1);
+	print("tprobe: ISPENDR0 before %x, with timer %x, timer off %x; ISENABLER0 %x\n", pend0, pend1, pend2, enabled);
+	for (unsigned n = 16; n < 32; n++) {
+		if (((pend1 & ~pend0) >> n) & 1) {
+			print("tprobe: INTID %d went pending because of the virtual timer\n", (uint64_t)n);
+		}
+	}
+	if ((pend1 & ~pend0) == 0) {
+		print("tprobe: no PPI went pending (ISTATUS says %d)\n", (ctl1 >> 2) & 1);
+	}
+}
