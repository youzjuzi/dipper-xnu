+        "  msr daifset, #0xf\n"
+        /* a register this core may not touch must not send it nowhere: other_cpu_fault switches the core off */
+        "  adrp x9, other_cpu_vectors\n"
+        "  add  x9, x9, :lo12:other_cpu_vectors\n"
+        "  msr vbar_el1, x9\n"
+        "  isb\n"
+        "  mrs x9, CurrentEL\n"
+        "  lsr x9, x9, #2\n"
+        "  str x9, [x0, #8]\n"
+        "  mrs x9, midr_el1\n"
+        "  str x9, [x0, #16]\n"
+        "  mrs x9, mpidr_el1\n"
+        "  str x9, [x0, #24]\n"
+        "  mrs x9, id_aa64pfr0_el1\n"
+        "  str x9, [x0, #32]\n"
