+/* A token outlives deinit if the kernel still owes it a callback. */
+struct ready_token {
+	struct ath10k_qmi qmi;
+	bool ready, armed, cancelled, running;
+	unsigned refs;
+};
+
+static void
+token_put(struct ready_token *t)
+{
+	bool last;
+	lx_os_lock();
+	last = --t->refs == 0;
+	lx_os_unlock();
+	if (last)
+		kfree(t);
+}
+
+static void
+fw_ready(void *arg)
+{
+	struct ready_token *t = arg;
+	lx_os_lock();
+	t->ready = true;
+	lx_os_unlock();
+	token_put(t);
+}
+
+/* The kernel may call inline; dispatch only after the complete platform probe succeeded. */
+void
+lx_ath10k_qmi_arm(struct ath10k *ar)
+{
+	struct ready_token *t = container_of(ath10k_snoc_priv(ar)->qmi, struct ready_token, qmi);
+	lx_os_lock();
+	t->armed = true;
+	lx_os_unlock();
+}
+
+static void
+ready_worker(void *arg)
+{
+	struct ready_token *t = arg;
+	for (;;) {
+		lx_os_lock();
+		if (t->cancelled || (t->armed && t->ready)) {
+			bool cancelled = t->cancelled;
+			t->running = !cancelled;
+			lx_os_unlock();
+			if (!cancelled) {
+				t->qmi.fw_ready = true;
+				lx_tell("lx-ath10k: fw ready -> snoc\n");
+				int ret = ath10k_snoc_fw_indication(t->qmi.ar, ATH10K_QMI_EVENT_FW_READY_IND);
+				if (ret)
+					lx_tell("lx-ath10k: FAIL fw indication %d\n", ret);
+			}
+			lx_os_lock();
+			t->running = false;
+			lx_os_unlock();
+			break;
+		}
+		lx_os_unlock();
+		lx_pause_ms(1);
+	}
+	token_put(t);
+}
+
+void
+lx_ath10k_qmi_cancel(struct ath10k *ar)
+{
+	struct ath10k_qmi *qmi = ath10k_snoc_priv(ar)->qmi;
+	if (!qmi)
+		return;
+	struct ready_token *t = container_of(qmi, struct ready_token, qmi);
+	for (;;) {
+		lx_os_lock();
+		t->cancelled = true;
+		bool running = t->running;
+		lx_os_unlock();
+		if (!running)
+			return;
+		lx_pause_ms(1);
+	}
+}
+
+int
+ath10k_qmi_init(struct ath10k *ar, u32 msa_size)
+{
+	struct ready_token *t = kzalloc(sizeof(*t), GFP_KERNEL);
+	int ret;
+	if (!t)
+		return -ENOMEM;
+	t->qmi.ar = ar;
+	t->qmi.state = ATH10K_QMI_STATE_INIT_DONE;
+	t->refs = 2; /* owner and kernel callback */
+	ath10k_snoc_priv(ar)->qmi = &t->qmi;
+	ret = lx_os_wlfw_wait_ready(fw_ready, t);
+	if (ret) {
+		ath10k_snoc_priv(ar)->qmi = NULL;
+		token_put(t);
+		token_put(t);
+		return ret;
+	}
+	lx_os_lock();
+	t->refs++;
+	lx_os_unlock();
+	ret = lx_os_thread("ath10k-ready", ready_worker, t);
+	if (ret) {
+		token_put(t);
+		ath10k_qmi_deinit(ar);
+		return -ret;
+	}
+	return 0;
+}
+
+int
+ath10k_qmi_deinit(struct ath10k *ar)
+{
+	struct ath10k_qmi *qmi = ath10k_snoc_priv(ar)->qmi;
+	if (qmi) {
+		lx_ath10k_qmi_cancel(ar);
+		ath10k_snoc_priv(ar)->qmi = NULL;
+		token_put(container_of(qmi, struct ready_token, qmi));
+	}
+	return 0;
+}
+
+int
+ath10k_qmi_wlan_enable(struct ath10k *ar, struct ath10k_qmi_wlan_enable_cfg *config,
+    enum wlfw_driver_mode_enum_v01 mode, const char *version)
+{
+	struct lx_ath10k_cfg cfg;
+	int ret = lx_ath10k_translate(config, &cfg);
+	lx_tell("lx-ath10k: wlan_enable mode=%d\n", mode);
+	if (!ret) {
+		if (mode != QMI_WLFW_MISSION_V01)
+			lx_ath10k_bus_mission(false);
+		ret = lx_os_wlfw_enable(&cfg.cfg, mode);
+	}
+	if (!ret)
+		lx_ath10k_bus_mission(mode == QMI_WLFW_MISSION_V01);
+	if (ret)
+		lx_tell("lx-ath10k: FAIL wlan_enable %d\n", ret);
+	return ret;
+}
+
+int
+ath10k_qmi_wlan_disable(struct ath10k *ar)
+{
+	lx_ath10k_bus_mission(false);
+	return lx_os_wlfw_enable(NULL, QMI_WLFW_OFF_V01);
+}
