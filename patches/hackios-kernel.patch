+			__asm__ volatile ("mrs %0, id_aa64mmfr0_el1" : "=r" (l->mmfr0));
+			__asm__ volatile ("mrs %0, id_aa64mmfr1_el1" : "=r" (l->mmfr1));
+			__asm__ volatile ("mrs %0, id_aa64isar0_el1" : "=r" (l->isar0));
+			__asm__ volatile ("mrs %0, id_aa64isar1_el1" : "=r" (l->isar1));
