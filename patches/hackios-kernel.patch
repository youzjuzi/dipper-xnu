+/* No work may touch a CE after the kernel takes the firmware out of mission mode. */
+void lx_ath10k_bus_mission(bool on)
+{
+	mutex_lock(&bus.service);
+	__atomic_store_n(&bus.mission, on, __ATOMIC_RELEASE);
+	mutex_unlock(&bus.service);
+	for (unsigned v = 0; v < 12; v++)
+		if (bus.irq[v].attached) {
+			if (!on) lx_os_irq_disable(v);
+			else if (__atomic_load_n(&bus.irq[v].enabled, __ATOMIC_ACQUIRE)) lx_os_irq_enable(v);
+		}
+}
+
+static void rings(void *unused)
+{
+	for (;;) {
+		lx_os_lock();
+		bool run = bus.run;
+		lx_os_unlock();
+		if (!run) break;
+		mutex_lock(&bus.service);
+		if (__atomic_load_n(&bus.mission, __ATOMIC_ACQUIRE)) {
+			if (bus.fallback)
+				for (unsigned v = 0; v < 12; v++)
+					if (__atomic_load_n(&bus.irq[v].enabled, __ATOMIC_ACQUIRE) && bus.irq[v].fn)
+						bus.irq[v].fn(v, bus.irq[v].arg);
+			lx_os_lock();
+			bool poll = bus.napi_enabled && bus.pending;
+			bus.pending = false;
+			lx_os_unlock();
+			if (poll && bus.napi && bus.napi->poll(bus.napi, 64) >= 64) {
+				lx_os_lock();
+				bus.pending = true;
+				lx_os_unlock();
+			}
+		}
+		mutex_unlock(&bus.service);
+		lx_pause_ms(1);
+	}
+	lx_os_lock();
+	bus.worker = false;
+	lx_os_unlock();
+}
