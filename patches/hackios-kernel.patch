+int platform_driver_register(struct platform_driver *drv)
+{
+	bus.drv = drv;
+	bus.pdev.name = "ath10k_snoc";
+	bus.pdev.dev.kobj.name = "wifi";
+	bus.pdev.dev.of_node = &node;
+	bus.pdev.dev.driver = &drv->driver;
+	bus.pdev.dev.dma_priv = &bus;
+	int ret = drv->probe(&bus.pdev);
+	if (ret) { release_managed(); bus.drv = NULL; dev_set_drvdata(&bus.pdev.dev, NULL); return ret; }
+	bus.up = true;
+	lx_tell("lx-ath10k: bus up membase 0x18800000 size 0x800000\n");
+	lx_ath10k_qmi_arm(platform_get_drvdata(&bus.pdev));
+	return 0;
+}
+void platform_driver_unregister(struct platform_driver *drv)
+{
+	if (!bus.up) return;
+	lx_ath10k_qmi_cancel(platform_get_drvdata(&bus.pdev));
+	drv->remove(&bus.pdev);
+	bus.up = false;
+	bus.drv = NULL;
+	dev_set_drvdata(&bus.pdev.dev, NULL);
+	lx_os_irq_detach_all();
+	release_managed();
+}
+int lx_prepare(void) { return lx_base_init() || lx_pool_init() ? ENOMEM : 0; }
+void lx_stop(void)
+{
+	if (!bus.initialized) return;
+	lx_os_lock();
+	bool active = bus.up || bus.worker;
+	lx_os_unlock();
+	if (!active) return;
+	if (bus.up) {
+		lx_station_withdraw();
+		lx_station_leave();
+		lx_ath10k_platform_stop();
+	}
+	lx_os_lock(); bus.run = false; lx_os_unlock();
+	for (;;) {
+		lx_os_lock(); bool running = bus.worker; lx_os_unlock();
+		if (!running) break;
+		lx_pause_ms(1);
+	}
+	lx_os_irq_detach_all();
+}
+int lx_start(void)
+{
+	int ret;
+	if (bus.up) return EBUSY;
+	if ((ret = lx_prepare())) return ret;
+	if (lx_os_option("wifi_lx") < 2) {
+		lx_tell("lx-ath10k: FAIL snoc requires wifi_lx=2\n");
+		return EINVAL;
+	}
+	if (!bus.initialized) { mutex_init(&bus.service); bus.initialized = true; }
+	memset(bus.irq, 0, sizeof(bus.irq));
+	bus.fallback = false; bus.mission = false; bus.pending = false;
+	bus.run = bus.worker = true;
+	ret = lx_os_thread("ath10k-rings", rings, NULL);
+	if (ret) { bus.worker = bus.run = false; return ret; }
+	ath10k_debug_mask = lx_os_option("wifi_quiet") ? 0 : ATH10K_DBG_BOOT | ATH10K_DBG_QMI | ATH10K_DBG_SNOC;
+	ret = lx_ath10k_platform_start();
+	if (ret) { lx_tell("lx-ath10k: FAIL probe %d\n", ret); lx_stop(); return -ret; }
+	struct ath10k *ar = platform_get_drvdata(&bus.pdev);
+	unsigned long long began = lx_os_nanoseconds();
+	while (!test_bit(ATH10K_FLAG_CORE_REGISTERED, &ar->dev_flags) && lx_os_nanoseconds() - began < 60000000000ull)
+		lx_pause_ms(10);
+	if (!test_bit(ATH10K_FLAG_CORE_REGISTERED, &ar->dev_flags)) { ret = ETIMEDOUT; goto fail; }
+	if (lx_os_option("wifi_station")) ret = lx_station_offer();
+	else if (lx_os_option("wifi_join")) ret = lx_station_join();
+	else {
+		ret = lx_os_option("wifi_scan") ? lx_station_scan() : 0;
+		lx_stop();
+		return ret;
+	}
+	if (!ret) return 0;
+fail:
+	lx_tell("lx-ath10k: FAIL start %d\n", ret);
+	lx_stop();
+	return ret;
+}
+int lx_transmit(const unsigned char *frame, unsigned long size) { return bus.up ? lx_station_send(frame, size) : ENETDOWN; }
