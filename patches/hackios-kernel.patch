+/* Only managed allocations made by this single platform device are retained here. */
+struct managed { struct managed *next; void (*release)(struct device *, void *); };
+static struct managed *managed;
+void *lkpi_devres_alloc(void (*release)(struct device *, void *), size_t size, gfp_t gfp)
+{
+	struct managed *m = kzalloc(sizeof(*m) + size, gfp);
+	if (m) m->release = release;
+	return m ? m + 1 : NULL;
+}
+void lkpi_devres_add(struct device *d, void *p) { struct managed *m = (struct managed *)p - 1; m->next = managed; managed = m; }
+void lkpi_devres_free(void *p) { if (p) kfree((struct managed *)p - 1); }
