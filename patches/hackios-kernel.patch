+static void irq_dispatch(void *arg)
+{
+	unsigned v = *(unsigned *)arg;
+	mutex_lock(&bus.service);
+	if (__atomic_load_n(&bus.mission, __ATOMIC_ACQUIRE) && __atomic_load_n(&bus.irq[v].enabled, __ATOMIC_ACQUIRE) && bus.irq[v].fn)
+		bus.irq[v].fn(v, bus.irq[v].arg);
+	if (__atomic_load_n(&bus.mission, __ATOMIC_ACQUIRE) && __atomic_load_n(&bus.irq[v].enabled, __ATOMIC_ACQUIRE) && bus.irq[v].attached)
+		lx_os_irq_enable(v);
+	mutex_unlock(&bus.service);
+}
+int lkpi_request_irq(struct device *d, unsigned v, irq_handler_t fn, irq_handler_t thread,
+    unsigned long flags, const char *name, void *arg)
+{
+	if (v >= 12 || !fn || thread || !(flags & IRQF_NO_AUTOEN)) return -EINVAL;
+	bus.irq[v].fn = fn;
+	bus.irq[v].arg = arg;
+	bus.irq[v].vector = v;
+	if (!bus.fallback) {
+		int ret = lx_os_irq_attach(v, irq_dispatch, &bus.irq[v].vector);
+		if (ret) {
+			lx_os_irq_detach_all();
+			for (unsigned i = 0; i < 12; i++) bus.irq[i].attached = false;
+			bus.fallback = true;
+			lx_tell("lx-ath10k: IRQ unavailable (%d); poll CE every 1 ms\n", ret);
+		} else bus.irq[v].attached = true;
+	}
+	return 0;
+}
+int lkpi_enable_irq(unsigned v)
+{
+	if (v >= 12) return -EINVAL;
+	lx_os_lock();
+	__atomic_store_n(&bus.irq[v].enabled, true, __ATOMIC_RELEASE);
+	bool enable = __atomic_load_n(&bus.mission, __ATOMIC_ACQUIRE) && bus.irq[v].attached;
+	lx_os_unlock();
+	if (enable) lx_os_irq_enable(v);
+	return 0;
+}
+void lkpi_disable_irq(unsigned v)
+{
+	if (v >= 12) return;
+	lx_os_lock();
+	__atomic_store_n(&bus.irq[v].enabled, false, __ATOMIC_RELEASE);
+	lx_os_unlock();
+	if (bus.irq[v].attached) lx_os_irq_disable(v);
+	mutex_lock(&bus.service);
+	mutex_unlock(&bus.service);
+}
+void lkpi_free_irq(unsigned v, void *arg)
+{
+	if (v >= 12) return;
+	lkpi_disable_irq(v);
+	mutex_lock(&bus.service);
+	bus.irq[v].fn = NULL;
+	bus.irq[v].arg = NULL;
+	mutex_unlock(&bus.service);
+}
+int enable_irq_wake(unsigned v) { return 0; }
+int disable_irq_wake(unsigned v) { return 0; }
