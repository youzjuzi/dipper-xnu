+void DELAY(int usec)
+{
+	unsigned long long start = lx_os_nanoseconds();
+	while (usec > 0 && lx_os_nanoseconds() - start < (unsigned long long)usec * 1000)
+		__asm __volatile("yield");
+}
+void nanouptime(struct timespec *t)
+{
+	unsigned long long ns = lx_os_nanoseconds();
+	t->tv_sec = ns / 1000000000;
+	t->tv_nsec = ns % 1000000000;
+}
