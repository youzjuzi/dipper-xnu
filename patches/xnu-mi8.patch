+}
+
+static bool
+svc_item(__unused void *ctx, uint32_t item, uint32_t *offset, uint32_t *size)
+{
+	uint32_t cacheline = 0, psize = 0, partition = smem_partition(SMEM_US, SMEM_MODEM, &cacheline, &psize), at;
+
+	if (partition == 0 || (at = item_find(partition, cacheline, item, size)) == 0) {
+		return false;
+	}
+	*offset = at;
+	return true;
+}
