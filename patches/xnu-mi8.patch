+
+/* ---- servreg-notifier client (QRTR service 66 instance 180; Linux pdr_interface.c / qcom_pdr_msg.c): on Android the service-notifier registers as a listener for the modem's
+ * msm/modem/wlan_pd and ACKs its state changes, and only then does icnss reach WLFW (EXP-0204, Android dmesg 10.02 s); without it msa_info answered INCOMPATIBLE_STATE (EXP-0203) ---- */
+
+#define SRN_SERVICE             66
+#define SRN_INSTANCE            180
+#define SRN_STATE_UP            0x1fffffffu
+#define SRN_REGISTER_LISTENER   0x20
+#define SRN_STATE_UPDATED_IND   0x22
+#define SRN_SET_ACK             0x23
+
+static const struct redwood_qrtr_ops *srn_ops;
+static struct redwood_qrtr_port *srn_port;
+static uint32_t srn_node, srn_remote;
+static uint16_t srn_txn;
+static volatile bool servreg_up, servreg_registered;
+static uint64_t servreg_tried_us;
+
+static unsigned
+srn_tlv(uint8_t *b, unsigned n, uint8_t type, const void *v, unsigned len)
+{
+	b[n] = type;
+	b[n + 1] = (uint8_t)len;
+	b[n + 2] = (uint8_t)(len >> 8);
+	memcpy(b + n + 3, v, len);
+	return n + 3 + len;
+}
+
+/* a string that is a TLV of its own has no length byte: the TLV's length is the string's (Linux qmi_encdec.c, enc_level 1); with one, the modem answered INVALID_HANDLE (EXP-0203g) */
+static unsigned
+srn_string(uint8_t *b, unsigned n, uint8_t type, const char *name)
+{
+	return srn_tlv(b, n, type, name, (unsigned)strlen(name));
+}
+
+static void
+srn_send(uint16_t msg, const uint8_t *tlvs, unsigned len)
+{
+	uint8_t pkt[7 + 100];
+	uint16_t txn = ++srn_txn;
+	int r;
+
+	pkt[0] = 0;                     /* request */
+	pkt[1] = (uint8_t)txn;
+	pkt[2] = (uint8_t)(txn >> 8);
+	pkt[3] = (uint8_t)msg;
+	pkt[4] = (uint8_t)(msg >> 8);
+	pkt[5] = (uint8_t)len;
+	pkt[6] = (uint8_t)(len >> 8);
+	memcpy(pkt + 7, tlvs, len);
+	r = srn_ops->send(srn_port, srn_node, srn_remote, pkt, 7 + len);
+	say("mi8rp: servreg: sent message %#x to %u:%u: %d\n", msg, srn_node, srn_remote, r);
+}
+
+static const char *srn_last;
+
+/* error 9 for every try at "msm/modem/wlan_pd" (EXP-0203g): the retries walk through the names the modem might know */
+static const char *const srn_names[] = { "msm/modem/wlan_pd" };
+
+static void
+srn_listen(const char *name)
+{
+	srn_last = name;
+	uint8_t t[100];
+	uint8_t one = 1;
+	unsigned n = srn_tlv(t, 0, 0x01, &one, 1);
+
+	n = srn_string(t, n, 0x02, name);
+	srn_send(SRN_REGISTER_LISTENER, t, n);
+}
+
+static void
+srn_receive(__unused void *ctx, __unused uint32_t node, __unused uint32_t port, const void *data, size_t length)
+{
+	const uint8_t *d = data;
+	uint16_t msg, total;
+	unsigned at = 7;
+
+	if (length < 7) {
+		return;
+	}
+	msg = (uint16_t)(d[3] | d[4] << 8);
+	total = (uint16_t)(d[5] | d[6] << 8);
+	if (7u + total > length) {
+		total = (uint16_t)(length - 7);
+	}
+	if (d[0] == 2) {                /* a response */
+		uint32_t state = 0;
+		uint16_t result = 0xffff, error = 0xffff;
+		bool have_state = false;
+
+		while (at + 3 <= 7u + total) {
+			uint16_t l = (uint16_t)(d[at + 1] | d[at + 2] << 8);
+			const uint8_t *v = d + at + 3;
+
+			if (at + 3 + l > 7u + total) {
+				break;
+			}
+			if (d[at] == 0x02 && l >= 4) {
+				result = (uint16_t)(v[0] | v[1] << 8);
+				error = (uint16_t)(v[2] | v[3] << 8);
+			} else if (d[at] == 0x10 && l >= 4) {
+				state = (uint32_t)(v[0] | v[1] << 8 | v[2] << 16 | (uint32_t)v[3] << 24);
+				have_state = true;
+			}
+			at += 3 + l;
+		}
+		say("mi8rp: servreg: response to %#x (\"%s\"): result %u error %u%s %#x\n", msg, srn_last ? srn_last : "?", result, error, have_state ? ", current state" : ", no state", state);
+		{
+			char hex[3 * 48 + 1];
+			unsigned n = length < 48 ? (unsigned)length : 48;
+
+			for (unsigned i = 0; i < n; i++) {
+				snprintf(hex + 3 * i, 4, "%02x ", d[i]);
+			}
+			say("mi8rp: servreg: response bytes: %s\n", hex);
+		}
+		if (msg == SRN_REGISTER_LISTENER && result == 0) {
+			servreg_registered = true;      /* error 9 before: the modem's wlan_pd was not there yet (EXP-0203f) */
+			if (have_state && state == SRN_STATE_UP) {
+				servreg_up = true;
+			}
+		}
+	} else if (d[0] == 4 && msg == SRN_STATE_UPDATED_IND) {
+		uint32_t state = 0;
+		uint16_t transaction = 0;
+		char name[65] = "";
+
+		while (at + 3 <= 7u + total) {
+			uint16_t l = (uint16_t)(d[at + 1] | d[at + 2] << 8);
+			const uint8_t *v = d + at + 3;
+
+			if (at + 3 + l > 7u + total) {
+				break;
+			}
+			if (d[at] == 0x01 && l >= 4) {
+				state = (uint32_t)(v[0] | v[1] << 8 | v[2] << 16 | (uint32_t)v[3] << 24);
+			} else if (d[at] == 0x02 && l >= 1) {
+				unsigned n = l > 64 ? 64 : l;
+
+				memcpy(name, v, n);
+				name[n] = 0;
+			} else if (d[at] == 0x03 && l >= 2) {
+				transaction = (uint16_t)(v[0] | v[1] << 8);
+			}
+			at += 3 + l;
+		}
+		say("mi8rp: servreg: %s changed to state %#x (transaction %u)\n", name, state, transaction);
+		{
+			uint8_t t[100];
+			unsigned n = srn_string(t, 0, 0x01, name);
+
+			n = srn_tlv(t, n, 0x02, &transaction, 2);
+			srn_send(SRN_SET_ACK, t, n);
+		}
+		if (state == SRN_STATE_UP && strcmp(name, "msm/modem/wlan_pd") == 0) {
+			servreg_up = true;
+		}
+	} else {
+		say("mi8rp: servreg: type %u message %#x, %u bytes, ignored\n", d[0], msg, (unsigned)length);
+	}
+}
+
+static void
+srn_server(__unused void *ctx, bool arrived, uint32_t service, __unused uint32_t version, uint32_t instance, uint32_t node, uint32_t port)
+{
+	say("mi8rp: servreg: service %u instance %u %s at %u:%u\n", service, instance, arrived ? "is at" : "is gone from", node, port);
+	if (arrived && service == SRN_SERVICE && instance == SRN_INSTANCE) {
+		srn_node = node;
+		srn_remote = port;
+		servreg_tried_us = now_us();
+		srn_listen("msm/modem/wlan_pd");
+	}
+}
+
+static void
+servreg_start(void)
+{
+	srn_ops = mi8_glink_qrtr_ops(modem_gl);
+	srn_port = srn_ops->open(srn_receive, srn_server, NULL);
+	if (srn_port == NULL) {
+		say("mi8rp: servreg: no port\n");
+		return;
+	}
+	say("mi8rp: servreg: lookup of service %u instance %u: %d\n", SRN_SERVICE, SRN_INSTANCE, srn_ops->lookup(srn_port, SRN_SERVICE, 1, SRN_INSTANCE));
+}
+
+/* ---- boot-arg mi8rp_wsmmu: the radio's stream 0x40/0x41 in the apps SMMU (EXP-0205, U-098) ----
+ * EXP-0201: no match register covers it and an unmatched stream faults, while Android has the stream attached with
+ * qcom,smmu-s1-bypass by the time FW_READY comes.
+ *   1: read-only: the SMMU's global fault record (SGFSR; SGFSYNR1 [15:0] names the stream) when the supplies go on and
+ *      whenever it changes after that, so the log tells whether the radio's requests are being refused.
+ *   2: ... and before the supplies go on, a free match register sends the stream past translation, as Linux
+ *      arm-smmu-qcom.c does for a bypass stream: S2CR BYPASS, or -- when the firmware turns a BYPASS write into FAULT
+ *      (qcom_smmu_cfg_probe "bypass_quirk") -- S2CR TRANSLATE to a free context with SCTLR 0 and CBAR "S1 translate,
+ *      S2 bypass". Physical addresses reach the memory unchanged, which is what the radio was given (MSA 0x8c100000).
+ *      Nothing is put back: the run ends with a reset (the modem cannot be stopped cleanly, EXP-0198).
+ * Layout from EXP-0201 (IDR1 0x5000002d): 4K pages, 64 of them before the contexts'; context n at 0x15040000 + n * 4K.
+ */
+#define WSMMU_PHYS              0x15000000ul
+#define WSMMU_SGFAR             0x040
+#define WSMMU_SGFSR             0x048           /* bit 1 USF: a stream nobody matches; bit 31: more than one fault */
+#define WSMMU_SGFSYNR0          0x050
+#define WSMMU_SGFSYNR1          0x054           /* [15:0] the stream of the recorded fault */
+#define WSMMU_SMR(n)            (0x800 + 4 * (n))       /* bit 31 valid, [30:16] mask, [14:0] stream */
+#define WSMMU_S2CR(n)           (0xc00 + 4 * (n))       /* [17:16] 0 translate, 1 bypass, 2 fault; [7:0] context */
+#define WSMMU_CBAR(n)           (0x1000 + 4 * (n))      /* second page; [17:16] 1 = S1 translate, S2 bypass */
+#define WSMMU_CONTEXTS          (WSMMU_PHYS + 0x40000)
+#define WSMMU_CB_SCTLR          0x00
+#define WSMMU_CB_FSR            0x58
+#define WSMMU_CB_FAR            0x60
+#define WSMMU_CB_FSYNR0         0x68
+/* mi8rp_wsmmu=3: the context translates with page tables of ours, input address = physical address (identity), as
+ * HackiOS redwood_wifi.c radio_space_on() does for the WCN6750 (the hypervisor granted it there); formats from Linux
+ * io-pgtable-arm.c / arm-smmu.c. EXP-0209: the emulated bypass (SCTLR 0) gave the radio translation faults. */
+#define WSMMU_CBA2R(n)          (0x1800 + 4 * (n))
+#define WSMMU_CB_TCR2           0x10
+#define WSMMU_CB_TTBR0          0x20
+#define WSMMU_CB_TTBR1          0x28
+#define WSMMU_CB_TCR            0x30
+#define WSMMU_CB_MAIR0          0x38
+#define WSMMU_CB_MAIR1          0x3c
+#define WSMMU_CB_TLBIASID       0x610
+#define WSMMU_CB_TLBSYNC        0x7f0
+#define WSMMU_CB_TLBSTATUS      0x7f4
+#define WSMMU_CBAR_S1           (1u << 16 | 3u << 8 | 0xfu << 12)       /* S1 translate S2 bypass; weakest defaults */
+#define WSMMU_SCTLR_ON          (1u << 0 | 1u << 1 | 1u << 2 | 1u << 5 | 1u << 8 | 1u << 12)
+#define WSMMU_TCR_39            (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)    /* T0SZ 25, walks WBWA inner-shareable, no TTBR1 */
+#define WSMMU_TCR2_VAL          (1u | 1u << 4 | 7u << 15)       /* 36-bit PA, 16-bit ASID */
+#define WSMMU_MAIR0_VAL         0xf404ff44u     /* Linux's: 0 non-cacheable, 1 write-back, 2 device */
+#define WSMMU_PTE               (3ull | 1ull << 6 | 2ull << 8 | 1ull << 10 | 1ull << 11)  /* page, EL0+, outer-shareable, AF, nG; MAIR 0 */
+#define WSMMU_TABLES            64              /* 4K each: root, level 2s, level 3s (2 MB of addresses each) */
+
+static uint32_t wsmmu_level, wsmmu_last_sgfsr = ~0u, wsmmu_last_cbfsr, wsmmu_context = ~0u;
+static vm_offset_t wsmmu, wsmmu_cb, wsmmu_tables;
+static uint32_t wsmmu_table_count;
+static bool wsmmu_translating;
+static LCK_GRP_DECLARE(wsmmu_lock_group, "mi8-wsmmu");
+static LCK_MTX_DECLARE(wsmmu_lock, &wsmmu_lock_group);
+
+static void
+wsmmu_watch(void)
+{
+	uint32_t sgfsr, cbfsr = 0;
+
+	if (wsmmu == 0) {
+		return;
+	}
+	sgfsr = rd(wsmmu + WSMMU_SGFSR);
+	if (wsmmu_cb != 0) {
+		cbfsr = rd(wsmmu_cb + WSMMU_CB_FSR);
+	}
+	if (sgfsr == wsmmu_last_sgfsr && cbfsr == wsmmu_last_cbfsr) {
+		return;
+	}
+	wsmmu_last_sgfsr = sgfsr;
+	wsmmu_last_cbfsr = cbfsr;
+	say("mi8rp: wsmmu: sgfsr %#x sgfsynr0 %#x sgfsynr1 %#x sgfar %#llx%s; context fsr %#x\n", sgfsr, rd(wsmmu + WSMMU_SGFSYNR0),
+	    rd(wsmmu + WSMMU_SGFSYNR1), (uint64_t)rd(wsmmu + WSMMU_SGFAR + 4) << 32 | rd(wsmmu + WSMMU_SGFAR),
+	    sgfsr != 0 && ((rd(wsmmu + WSMMU_SGFSYNR1) & 0xfffe) == 0x40) ? ": THE RADIO'S STREAM WAS REFUSED" : "", cbfsr);
+	if (cbfsr != 0) {
+		/* FSR bit 1 TF translation, 2 AFF access flag, 3 PF permission; FAR the input address; FSYNR0 bit 4 WNR */
+		say("mi8rp: wsmmu: CONTEXT %u FAULT: fsr %#x far %#llx fsynr0 %#x (EXP-0209: 0x2 with SCTLR 0)\n", wsmmu_context, cbfsr,
+		    (uint64_t)rd(wsmmu_cb + WSMMU_CB_FAR + 4) << 32 | rd(wsmmu_cb + WSMMU_CB_FAR), rd(wsmmu_cb + WSMMU_CB_FSYNR0));
+	}
+}
+
+static uint64_t *
+wsmmu_table(uint32_t n)
+{
+	return (uint64_t *)(wsmmu_tables + 4096ul * n);
+}
+
+/* The next-level table an entry leads to; made when the entry is empty. */
+static uint64_t *
+wsmmu_next(uint64_t *entry)
+{
+	if (*entry & 1) {
+		for (uint32_t i = 0; i < wsmmu_table_count; i++) {
+			if (kvtophys((vm_offset_t)wsmmu_table(i)) == (*entry & 0x0000fffffffff000ull)) {
+				return wsmmu_table(i);
+			}
+		}
+		return NULL;
+	}
+	if (wsmmu_table_count == WSMMU_TABLES) {
+		return NULL;
+	}
+	*entry = kvtophys((vm_offset_t)wsmmu_table(wsmmu_table_count)) | 3;
+	return wsmmu_table(wsmmu_table_count++);
+}
+
+/* Memory of ours that the radio is to reach, at its own physical address (redwood_lx.c, lx_os_radio_memory). */
+bool
+mi8_wsmmu_map(uint64_t physical, uint64_t size)
+{
+	bool ok = true;
+
+	if (!wsmmu_translating) {
+		return true;                    /* levels 0..2: nothing to enter */
+	}
+	lck_mtx_lock(&wsmmu_lock);
+	for (uint64_t at = physical & ~0xfffull; at < physical + size; at += 4096) {
+		uint64_t *l2 = wsmmu_next(&wsmmu_table(0)[at >> 30 & 0x1ff]);
+		uint64_t *l3 = l2 == NULL ? NULL : wsmmu_next(&l2[at >> 21 & 0x1ff]);
+
+		if (l3 == NULL) {
+			say("mi8rp: wsmmu: NO PAGE TABLE LEFT for %#llx\n", at);
+			ok = false;
+			break;
+		}
+		l3[at >> 12 & 0x1ff] = at | WSMMU_PTE;
+	}
+	for (vm_offset_t line = wsmmu_tables; line < wsmmu_tables + 4096ul * WSMMU_TABLES; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+	wr(wsmmu_cb + WSMMU_CB_TLBIASID, wsmmu_context);
+	wr(wsmmu_cb + WSMMU_CB_TLBSYNC, 1);
+	for (unsigned n = 0; (rd(wsmmu_cb + WSMMU_CB_TLBSTATUS) & 1) && n < 1000; n++) {
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+	lck_mtx_unlock(&wsmmu_lock);
+	say("mi8rp: wsmmu: radio sees %#llx..%#llx (%u tables)%s\n", physical, physical + size, wsmmu_table_count, ok ? "" : ": NOT ALL");
+	return ok;
+}
+
+/* Level 3: the chosen context (wsmmu_cb, SCTLR already 0) translates with our tables. */
+static bool
+wsmmu_translate(void)
+{
+	uint64_t root;
+
+	if (kmem_alloc(kernel_map, &wsmmu_tables, 4096ul * WSMMU_TABLES, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		say("mi8rp: wsmmu: no memory for page tables: nothing written for the stream\n");
+		return false;
+	}
+	wsmmu_table_count = 1;
+	root = kvtophys(wsmmu_tables) | (uint64_t)wsmmu_context << 48;   /* ASID = the context's number */
+	wr(wsmmu + WSMMU_CBA2R(wsmmu_context), 1);                         /* 64-bit descriptors */
+	wr(wsmmu + WSMMU_CBAR(wsmmu_context), WSMMU_CBAR_S1);
+	wr(wsmmu_cb + WSMMU_CB_TCR2, WSMMU_TCR2_VAL);
+	wr(wsmmu_cb + WSMMU_CB_TCR, WSMMU_TCR_39);
+	wr(wsmmu_cb + WSMMU_CB_TTBR0, (uint32_t)root);
+	wr(wsmmu_cb + WSMMU_CB_TTBR0 + 4, (uint32_t)(root >> 32));
+	wr(wsmmu_cb + WSMMU_CB_TTBR1, 0);
+	wr(wsmmu_cb + WSMMU_CB_TTBR1 + 4, 0);
+	wr(wsmmu_cb + WSMMU_CB_MAIR0, WSMMU_MAIR0_VAL);
+	wr(wsmmu_cb + WSMMU_CB_MAIR1, 0);
+	wr(wsmmu_cb + WSMMU_CB_FSR, 0xc00001feu);                         /* clear old faults */
+	wr(wsmmu_cb + WSMMU_CB_TLBIASID, wsmmu_context);
+	wr(wsmmu_cb + WSMMU_CB_TLBSYNC, 1);
+	for (unsigned n = 0; (rd(wsmmu_cb + WSMMU_CB_TLBSTATUS) & 1) && n < 1000; n++) {
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+	wr(wsmmu_cb + WSMMU_CB_SCTLR, WSMMU_SCTLR_ON);
+	wsmmu_translating = true;
+	say("mi8rp: wsmmu: context %u translates: root %#llx; read back cbar %#x cba2r %#x tcr %#x tcr2 %#x ttbr0 %#x:%#x sctlr %#x\n",
+	    wsmmu_context, root & 0x0000fffffffff000ull, rd(wsmmu + WSMMU_CBAR(wsmmu_context)), rd(wsmmu + WSMMU_CBA2R(wsmmu_context)),
+	    rd(wsmmu_cb + WSMMU_CB_TCR), rd(wsmmu_cb + WSMMU_CB_TCR2), rd(wsmmu_cb + WSMMU_CB_TTBR0 + 4), rd(wsmmu_cb + WSMMU_CB_TTBR0),
+	    rd(wsmmu_cb + WSMMU_CB_SCTLR));
+	return true;
+}
+
+/* Level 2: the stream goes past translation. */
+static void
+wsmmu_bypass(void)
+{
+	bool used[256] = { false };
+	uint32_t matches = rd(wsmmu + 0x020) & 0xff, contexts = rd(wsmmu + 0x024) & 0xff, n, slot = ~0u, s2cr, smr;
+	vm_offset_t cbs;
+
+	for (n = 0; n < matches && WSMMU_SMR(n) < 0xc00; n++) {
+		smr = rd(wsmmu + WSMMU_SMR(n));
+		s2cr = rd(wsmmu + WSMMU_S2CR(n));
+		if (smr >> 31) {
+			used[s2cr & 0xff] = true;
+		} else if (slot == ~0u) {
+			slot = n;
+		}
+	}
+	if (slot == ~0u) {
+		say("mi8rp: wsmmu: NO FREE MATCH REGISTER: nothing written\n");
+		return;
+	}
+	say("mi8rp: wsmmu: WRITING THE SMMU: match register %u (smr %#x s2cr %#x) for stream 0x40 mask 1\n", slot,
+	    rd(wsmmu + WSMMU_SMR(slot)), rd(wsmmu + WSMMU_S2CR(slot)));
+	if (wsmmu_level >= 3) {
+		s2cr = 1u << 16;                /* (not BYPASS: go straight to a context) */
+	} else {
+		wr(wsmmu + WSMMU_S2CR(slot), 1u << 16 | 0xff);
+		s2cr = rd(wsmmu + WSMMU_S2CR(slot));
+	}
+	if (wsmmu_level >= 3 || (s2cr >> 16 & 3) != 1) {
+		/* the hypervisor did not keep BYPASS: emulate it with a context that does not translate (Linux bypass_cbndx = the last free one) */
+		cbs = ml_io_map(WSMMU_CONTEXTS, 0x1000ul * contexts);
+		for (n = contexts; n-- > 0;) {
+			vm_offset_t cb = cbs + 0x1000ul * n;
+
+			if (!used[n] && !(rd(cb + WSMMU_CB_SCTLR) & 1)) {
+				wsmmu_cb = cb;
+				wsmmu_context = n;
+				break;
+			}
+		}
+		if (wsmmu_cb == 0) {
+			say("mi8rp: wsmmu: s2cr read back %#x (BYPASS not kept) and no free context\n", s2cr);
+			return;
+		}
+		say("mi8rp: wsmmu: %s: context %u (cbar %#x)\n", wsmmu_level >= 3 ? "translating with our tables" :
+		    "s2cr BYPASS not kept, the context is used as a bypass", wsmmu_context, rd(wsmmu + WSMMU_CBAR(wsmmu_context)));
+		wr(wsmmu_cb + WSMMU_CB_SCTLR, 0);
+		if (wsmmu_level >= 3) {
+			if (!wsmmu_translate()) {
+				return;
+			}
+		} else {
+			wr(wsmmu + WSMMU_CBAR(wsmmu_context), 1u << 16);
+		}
+		wr(wsmmu + WSMMU_S2CR(slot), wsmmu_context);
+		s2cr = rd(wsmmu + WSMMU_S2CR(slot));
+	}
+	wr(wsmmu + WSMMU_SMR(slot), 1u << 31 | 1u << 16 | 0x40);
+	smr = rd(wsmmu + WSMMU_SMR(slot));
+	say("mi8rp: wsmmu: read back smr %#x s2cr %#x%s: %s\n", smr, s2cr,
+	    wsmmu_cb ? "" : " (bypass)", smr == (1u << 31 | 1u << 16 | 0x40) ? "THE RADIO'S STREAM PASSES" : "THE SMMU DID NOT TAKE IT");
+}
+
+/* At MSA_READY, before the radio's supplies go on. */
+static void
+wsmmu_before_power(void)
+{
+	if (wsmmu_level == 0 || wsmmu != 0) {
+		return;
+	}
+	wsmmu = ml_io_map(WSMMU_PHYS, 0x2000);
+	wsmmu_watch();
+	if (wsmmu_level >= 2) {
+		wsmmu_bypass();
+	}
+}
+
+/* ---- the radio's firmware service (WLFW, QRTR service 69; TASK-004): mi8rp_wlfw=1 goes up to FW_READY, 2 also powers the chip and sends WLAN_CFG + WLAN_MODE ---- */
+
+#define WLAN_MSA_MEMORY         0x8c100000u     /* 1 MB of the unused dt camera_region (0x8bf00000..0x8c400000; rmtfs has the first 2 MB). Android icnss only gives a size (qcom,wlan-msa-memory) and DMA-allocates it; the modem answered error 90 to msa_info for wlan_fw_region 0x8e300000 (EXP-0203) */
+#define WLAN_MSA_SIZE           0x00100000u
+
+static bool wlan_power(bool on);
+
+static struct mi8_wlfw *modem_wl;
+static volatile bool modem_glink_up, wl_run, wl_fw_ready, wl_failed, wl_powered;
+static uint32_t wl_level;
+static volatile uint32_t wl_servreg;    /* mi8rp_servreg: 1 registers as a listener, 2 also holds WLFW back until wlan_pd is up */
+
+static void
+wl_event(__unused void *ctx, enum mi8_wlfw_event ev)
+{
+	static const char *const names[] = { "SERVER_ARRIVE", "MSA_READY", "FW_READY", "FW_DOWN", "SERVER_EXIT", "ERROR" };
+
+	say("mi8rp: wlfw: event %s\n", ev < 6 ? names[ev] : "?");
+	if (ev == MI8_WLFW_MSA_READY && !wl_powered) {
+		/* Android icnss_driver_event_server_arrive: after CAP, icnss_hw_power_on, then FW_READY comes */
+		wl_powered = true;
+		wsmmu_before_power();
+		/* with our page tables (wsmmu=3) the radio reaches only what is entered; Android's S1 bypass lets it reach the MSA */
+		mi8_wsmmu_map(WLAN_MSA_MEMORY, WLAN_MSA_SIZE);
+		say("mi8rp: wlfw: switching the radio's supplies on (as icnss does after CAP): %s\n", wlan_power(true) ? "on" : "NOT ALL ON");
+		if (wl_level == 5) {
+			uint32_t address = 0;
+
+			/* Linux sdm845.dtsi wifi: clocks = <&rpmhcc RPMH_RF_CLK2> (cxo_ref_clk_pin); an RPMh VRM clock is on with +4 = 1 (clk-rpmh.c) */
+			if (rail_position("rfclka2", 0, &address, false) == 0 || address != 0) {
+				say("mi8rp: wlfw: rfclka2 (%#x) on: %s\n", address, rpmh_write("rfclka2", address + 4, 1) ? "done" : "NOT DONE");
+			}
+		}
+	}
+	if (ev == MI8_WLFW_FW_READY) {
+		wl_fw_ready = true;
+	} else if (ev == MI8_WLFW_ERROR) {
+		wl_failed = true;
+	}
+}
+
+/* ---- boot-arg mi8rp_lx=1: the driver (Linux ath10k on the lx layer, TASK-006) over our WLFW client; sys/mi8_lx.h ----
+ * After FW_READY, redwood_lx_start() runs on a thread of its own; the driver's qmi.c is replaced by lx_ath10k_qmi.c, which
+ * asks here for mission mode (lx_os_wlfw_enable) and to hear of FW_READY (lx_os_wlfw_wait_ready). The WLFW client is not
+ * safe to call from two threads (its replies are taken by modem_wlfw_thread's mi8_wlfw_process), so requests are handed to
+ * that thread and waited for. mi8rp_lxirq=1: the copy engines' interrupts (SPI 414..425, Android dt qcom,icnss
+ * interrupts 0x19e..0x1a9) instead of the bus looking at its rings. */
+#define MI8_LX_FIRST_INTID      (414u + 32u)    /* GIC INTID of CE0's SPI */
+
+bool mi8_lx_on;
+static uint32_t mi8_lx_level, mi8_lx_irq;
+static volatile int wl_req;                     /* 0 none, 1 enable, 2 disable; set by the driver, cleared by the thread */
+static volatile int wl_req_mode, wl_req_rc;
+static struct mi8_wlfw_wlan_cfg wl_req_cfg;
+/* copies: the driver's arrays are its own, and a request that timed out may still be on its way (QMI_WLFW_MAX_NUM_CE/SVC/SHADOW 12/24/24) */
+static struct mi8_wlfw_ce_tgt_pipe_cfg_s_v01 wl_req_tgt[12];
+static struct mi8_wlfw_ce_svc_pipe_cfg_s_v01 wl_req_svc[24];
+static struct mi8_wlfw_shadow_reg_cfg_s_v01 wl_req_shadow[24];
+static void (*volatile wl_ready_fn)(void *);
+static void *wl_ready_arg;
+
+bool
+mi8_lx_fw_ready(void)
+{
+	return wl_fw_ready;
+}
+
+bool
+mi8_lx_irq_lines(uint32_t *first)
+{
+	if (!mi8_lx_irq) {
+		return false;
+	}
+	*first = MI8_LX_FIRST_INTID;
+	return true;
+}
+
+int
+lx_os_wlfw_enable(const struct lx_wlfw_cfg *cfg, int mode)
+{
+	if (modem_wl == NULL || !wl_fw_ready) {
+		say("mi8rp: lx: wlfw_enable mode %d before FW_READY\n", mode);
+		return -ENXIO;
+	}
+	if (__atomic_load_n(&wl_req, __ATOMIC_ACQUIRE) != 0) {
+		say("mi8rp: lx: wlfw_enable: the request before is still under way\n");
+		return -EBUSY;
+	}
+	if (cfg != NULL) {
+		if (cfg->n_tgt > 12 || cfg->n_svc > 24 || cfg->n_shadow > 24 || (cfg->n_tgt && !cfg->tgt) || (cfg->n_svc && !cfg->svc) ||
+		    (cfg->n_shadow && !cfg->shadow)) {
+			return -EINVAL;
+		}
+		/* the layouts are the same (sys/mi8_lx.h) */
+		memcpy(wl_req_tgt, cfg->tgt, cfg->n_tgt * sizeof(wl_req_tgt[0]));
+		memcpy(wl_req_svc, cfg->svc, cfg->n_svc * sizeof(wl_req_svc[0]));
+		memcpy(wl_req_shadow, cfg->shadow, cfg->n_shadow * sizeof(wl_req_shadow[0]));
+		wl_req_cfg.num_ce_tgt_cfg = cfg->n_tgt;
+		wl_req_cfg.num_ce_svc_pipe_cfg = cfg->n_svc;
+		wl_req_cfg.num_shadow_reg_cfg = cfg->n_shadow;
+		wl_req_cfg.ce_tgt_cfg = wl_req_tgt;
+		wl_req_cfg.ce_svc_cfg = wl_req_svc;
+		wl_req_cfg.shadow_reg_cfg = wl_req_shadow;
+		say("mi8rp: lx: wlfw_enable mode %d: %u target pipes, %u services, %u shadow registers\n", mode, cfg->n_tgt, cfg->n_svc,
+		    cfg->n_shadow);
+	} else {
+		say("mi8rp: lx: wlfw_disable\n");
+	}
+	wl_req_mode = mode;
+	wl_req_rc = 0;
+	__atomic_store_n(&wl_req, cfg != NULL ? 1 : 2, __ATOMIC_RELEASE);
+	for (unsigned ms = 0; __atomic_load_n(&wl_req, __ATOMIC_ACQUIRE) != 0; ms += 10) {
+		if (ms >= 10000) {
+			say("mi8rp: lx: wlfw_enable: no answer in 10 s\n");
+			return -ETIMEDOUT;
+		}
+		delay_for_interval(10, NSEC_PER_MSEC);
+	}
+	say("mi8rp: lx: wlfw_enable rc=%d\n", wl_req_rc);
+	return wl_req_rc;
+}
+
+int
+lx_os_wlfw_wait_ready(void (*ready)(void *), void *arg)
+{
+	wl_ready_arg = arg;
+	__atomic_store_n(&wl_ready_fn, ready, __ATOMIC_RELEASE);
+	say("mi8rp: lx: the driver waits for FW_READY%s\n", wl_fw_ready ? " (already here)" : "");
+	return 0;
+}
+
+/* The modem's partition (image/<name>) first -- board files are there --, then fw/ of the small image (ath10k's
+ * firmware-5.bin from linux-firmware, which says what the firmware can do; nothing of it runs). Kept: the driver
+ * asks a few times and never gives them back. */
+extern const uint8_t *redwood_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+
+int
+mi8_lx_firmware(const char *name, const void **data, unsigned long *size)
+{
+	static struct {
+		char name[48];
+		void *data;
+		uint64_t size;
+	} kept[8];
+	const char *last = strrchr(name, '/');
+	char path[64];
+	uint64_t n = 0;
+	const uint8_t *image;
+	void *buffer;
+	unsigned i;
+
+	last = last == NULL ? name : last + 1;
+	for (i = 0; i < 8 && kept[i].data != NULL; i++) {
+		if (strcmp(kept[i].name, last) == 0) {
+			*data = kept[i].data;
+			*size = (unsigned long)kept[i].size;
+			return 0;
+		}
+	}
+	snprintf(path, sizeof(path), "image/%s", last);
+	if (svc_file_size(NULL, path, &n) == 0 && n != 0 && n < (8u << 20) && i < 8 &&
+	    (buffer = kalloc_data(n, Z_WAITOK)) != NULL) {
+		if (svc_file_read(NULL, path, 0, buffer, n) != 0) {
+			kfree_data(buffer, n);
+		} else {
+			strlcpy(kept[i].name, last, sizeof(kept[i].name));
+			kept[i].data = buffer;
+			kept[i].size = n;
+			*data = buffer;
+			*size = (unsigned long)n;
+			say("mi8rp: lx: firmware %s: modem partition %s, %llu bytes\n", name, path, n);
+			return 0;
+		}
+	}
+	if ((image = redwood_image_file("fw", last, &n, NULL)) != NULL) {
+		*data = image;
+		*size = (unsigned long)n;
+		say("mi8rp: lx: firmware %s: fw/%s of the small image, %llu bytes\n", name, last, n);
+		return 0;
+	}
+	say("mi8rp: lx: firmware %s: NOT FOUND (image/%s, fw/%s)\n", name, last, last);
+	return ENOENT;
+}
+
+extern int redwood_lx_start(void);
+
+static void
+mi8_lx_start_thread(__unused void *parameter, __unused wait_result_t wr)
+{
+	say("mi8rp: lx: starting the driver (redwood_lx_start)\n");
+	say("mi8rp: lx: redwood_lx_start rc=%d\n", redwood_lx_start());
+	thread_terminate(current_thread());
+}
+
+static void
+mi8_lx_ready_thread(__unused void *parameter, __unused wait_result_t wr)
+{
+	void (*fn)(void *) = __atomic_load_n(&wl_ready_fn, __ATOMIC_ACQUIRE);
+
+	say("mi8rp: lx: FW_READY -> the driver\n");
+	fn(wl_ready_arg);
+	thread_terminate(current_thread());
+}
+
+/* In modem_wlfw_thread, every turn: start the driver once FW_READY is here, pass FW_READY on, serve its requests. */
+static void
+mi8_lx_turn(void)
+{
+	static bool started, told;
+	thread_t thread;
+	int req;
+
+	if (!mi8_lx_on || !wl_fw_ready) {
+		return;
+	}
+	if (!started) {
+		started = true;
+		if (kernel_thread_start(mi8_lx_start_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+	if (!told && __atomic_load_n(&wl_ready_fn, __ATOMIC_ACQUIRE) != NULL) {
+		told = true;
+		if (kernel_thread_start(mi8_lx_ready_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+	if ((req = __atomic_load_n(&wl_req, __ATOMIC_ACQUIRE)) != 0) {
+		wl_req_rc = req == 1 ? mi8_wlfw_enable(modem_wl, &wl_req_cfg, wl_req_mode) : mi8_wlfw_disable(modem_wl);
+		__atomic_store_n(&wl_req, 0, __ATOMIC_RELEASE);
+	}
+}
+
+/* Linux ath10k_qmi_map_msa_permission / Android icnss_setup_msa_permissions: a region goes to MSS_MSA and WLAN, and a region that is not secure to WLAN_CE too.
+ * With MSS_MSA alone (EXP-0203k/l) everything up to CAP worked but FW_READY never came. */
+#define VMID_WLAN               0x18
+#define VMID_WLAN_CE            0x19
+static int
+wl_msa_assign(__unused void *ctx, uint64_t phys, uint32_t size, bool secure, bool to_firmware)
+{
+	static uint64_t owners[4] = { 1ull << VMID_HLOS, 1ull << VMID_HLOS, 1ull << VMID_HLOS, 1ull << VMID_HLOS };
+	static uint64_t at[4];
+	unsigned k;
+
+	for (k = 0; k < 4 && at[k] != 0 && at[k] != phys; k++) {
+	}
+	if (k == 4 || phys >= 0x100000000ull) {
+		return ENOSPC;
+	}
+	at[k] = phys;
+	say("mi8rp: wlfw: msa %#llx +%#x secure=%d -> %s\n", phys, size, secure, to_firmware ? "firmware" : "host");
+	return assign_owners("wlfw-msa", (uint32_t)phys, size, &owners[k], !to_firmware ? 1ull << VMID_HLOS :
+	    (1ull << VMID_MSS_MSA) | (1ull << VMID_WLAN) | (secure ? 0 : 1ull << VMID_WLAN_CE)) ? 0 : EIO;
+}
+
+/* The board data file (bdwlan.<id>) the firmware wants; a wrong one would give wrong transmit limits, so an id with no file is an error, not a guess. */
+static int
+wl_board_name(__unused void *ctx, uint32_t board_id, uint32_t chip_id, char *name, unsigned n)
+{
+	struct fs_file f;
+	char path[40];
+
+	say("mi8rp: wlfw: the firmware reports board id %#x chip id %#x\n", board_id, chip_id);
+	/* Android cnss-daemon (EXP-0206 disassembly): board 0xff with ro.boot.hwversion 3.x -> bdwlan.bin; below 0x100 bdwlan.bXX, else bdwlan.XXX */
+	if (board_id == 0xff) {
+		snprintf(path, sizeof(path), "image/bdwlan.bin");
+	} else if (board_id < 0x100) {
+		snprintf(path, sizeof(path), "image/bdwlan.b%02x", board_id);
+	} else {
+		snprintf(path, sizeof(path), "image/bdwlan.%03x", board_id);
+	}
+	if (!fs_lookup(path, &f) || f.dir) {
+		say("mi8rp: wlfw: no board file %s for board id %#x\n", path, board_id);
+		return ENOENT;
+	}
+	if (strlcpy(name, path, n) >= n) {
+		return ENAMETOOLONG;
+	}
+	say("mi8rp: wlfw: board file %s\n", path);
+	return 0;
+}
+
+/* mi8rp_wlfw=3: the chip is powered 3 s into the retries of msa_info (in case the modem's WLAN firmware waits for the chip), so that the log tells which of the two helped. */
+static void
+wl_sleep_ms(__unused void *ctx, uint32_t ms)
+{
+	static uint32_t slept;
+	static bool powered;
+
+	delay_for_interval(ms, NSEC_PER_MSEC);
+	slept += ms;
+	if (wl_level == 3 && !powered && slept >= 3000) {
+		powered = true;
+		say("mi8rp: wlfw: %u ms of retries: switching the radio's supplies on now: %s\n", slept, wlan_power(true) ? "on" : "NOT ALL ON");
+	}
+}
+
+static void
+modem_wlfw_thread(__unused void *parameter, __unused wait_result_t wr)
+{
+	bool started = false, enabled = false;
+	uint64_t began = now_us();
+
+	while (wl_run) {
+		if (!started && modem_glink_up && (wl_servreg != 2 || servreg_up || (now_us() - began) / 1000000 > 300)) {
+			int r = mi8_wlfw_start(modem_wl);
+
+			say("mi8rp: wlfw: start rc=%d\n", r);
+			started = true;
+		}
+		if (started) {
+			mi8_wlfw_process(modem_wl, 10000);
+		}
+		wsmmu_watch();
+		mi8_lx_turn();
+		if (wl_fw_ready && wl_level == 2 && !enabled) {
+			int r;
+
+			enabled = true;
+			announce(9, "(wlfw) switches the radio's supplies on, then sends WLAN_CFG and WLAN_MODE(on)");
+			say("mi8rp: wlfw: supplies %s\n", wlan_power(true) ? "on" : "NOT ALL ON");
+			delay_for_interval(20, NSEC_PER_MSEC);
+			r = mi8_wlfw_enable(modem_wl, mi8_wlfw_wcn3990_default_cfg(), QMI_WLFW_MISSION_V01);    /* 0; EXP-0207/0208 sent 1 = FTM by mistake */
+			say("mi8rp: wlfw: enable rc=%d\n", r);
+		}
+		if (!started && !modem_glink_up && (now_us() - began) / 1000000 > 400) {
+			say("mi8rp: wlfw: the GLINK link never came up\n");
+			break;
+		}
+		delay_for_interval(20, NSEC_PER_MSEC);
+	}
+	thread_terminate(current_thread());
+}
+
+static void
+modem_wlfw_start(uint32_t level)
+{
+	struct mi8_wlfw_cfg wc;
+	thread_t thread;
+
+	bzero(&wc, sizeof(wc));
+	wc.qrtr = mi8_glink_qrtr_ops(modem_gl);
+	wc.msa_phys = WLAN_MSA_MEMORY;
+	wc.msa_size = WLAN_MSA_SIZE;
+	wc.msa_assign = wl_msa_assign;
+	wc.file_size = svc_file_size;
+	wc.file_read = svc_file_read;
+	wc.board_file_name = wl_board_name;
+	wc.sleep_ms = wl_sleep_ms;
+	wc.event = wl_event;
+	wc.log = svc_log;
+	wc.skip_bdf = true;              /* Android's icnss sends no BDF_DOWNLOAD (EXP-0203) -- but its cnss-daemon does (EXP-0206): mi8rp_bdf=1 sends it */
+	{
+		uint32_t bdf = 0;
+
+		if (PE_parse_boot_argn("mi8rp_bdf", &bdf, sizeof(bdf)) && bdf != 0) {
+			wc.skip_bdf = false;
+		}
+	}
+	wc.skip_host_cap = true;         /* Android's icnss (icnss_driver_event_server_arrive) sends no HOST_CAP: ind_register, then msa_info; with it msa_info said INCOMPATIBLE_STATE (EXP-0203) */
+	wc.host_cap_8bit = true;        /* the modem answered the 32-bit HOST_CAP with MALFORMED_MSG (EXP-0203); sdm845 boards in Linux set qcom,snoc-host-cap-8bit-quirk */
+	modem_wl = mi8_wlfw_create(&wc);
+	if (modem_wl == NULL) {
+		say("mi8rp: wlfw: create failed\n");
+		return;
+	}
+	wl_level = level;
+	PE_parse_boot_argn("mi8rp_wsmmu", &wsmmu_level, sizeof(wsmmu_level));
+	PE_parse_boot_argn("mi8rp_lx", &mi8_lx_level, sizeof(mi8_lx_level));
+	PE_parse_boot_argn("mi8rp_lxirq", &mi8_lx_irq, sizeof(mi8_lx_irq));
+	mi8_lx_on = mi8_lx_level != 0;
+	wl_run = true;
+	if (kernel_thread_start(modem_wlfw_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* The link is polled here; it starts when the modem has made its GLINK items (478..480), and the services start with it. */
+static void
+modem_svc_thread(__unused void *parameter, __unused wait_result_t wr)
+{
+	bool glink_up = false, hs_up = false;
+	unsigned hs_tries = 0;
+
+	while (modem_svc_run) {
+		if (!glink_up && mi8_glink_start(modem_gl) == 0) {
+			glink_up = true;
+			modem_glink_up = true;
+			say("mi8rp: mss: the GLINK link to the modem is started\n");
+			if (wl_servreg) {
+				servreg_start();
+			}
+		}
+		if (glink_up) {
+			if (!hs_up && hs_tries < 5) {
+				hs_tries++;
+				hs_up = mi8_hostsvc_start(modem_hs) == 0;
+				say("mi8rp: mss: host services %s\n", hs_up ? "started" : "DID NOT START");
+			}
+			mi8_glink_poll_once(modem_gl);
+			if (wl_servreg && srn_remote != 0 && !servreg_registered && now_us() - servreg_tried_us > 1000000) {
+				static unsigned name_at;
+
+				servreg_tried_us = now_us();
+				srn_listen(srn_names[name_at++ % (sizeof(srn_names) / sizeof(srn_names[0]))]);
+			}
+		}
+		delay_for_interval(glink_up ? 200 : 100000, NSEC_PER_USEC);
+	}
+	thread_terminate(current_thread());
+}
+
+static bool
+modem_services_start(void)
+{
+	static uint64_t rmtfs_owners = 1ull << VMID_HLOS;
+	struct mi8_glink_cfg gc;
+	struct mi8_hostsvc_cfg hc;
+	thread_t thread;
+	vm_offset_t rmtfs;
+
+	bzero(&gc, sizeof(gc));
+	gc.name = "modem";
+	gc.remote_pid = SMEM_MODEM;
+	gc.smem_item = svc_item;
+	gc.smem_read = svc_read;
+	gc.smem_write32 = svc_write32;
+	gc.ring = svc_ring;
+	gc.sleep_us = svc_sleep_us;
+	gc.now_us = svc_now_us;
+	gc.log = svc_log;
+	modem_gl = mi8_glink_create(&gc);
+	if (modem_gl == NULL) {
+		say("mi8rp: mss: mi8_glink_create failed\n");
+		return false;
+	}
+	rmtfs = ml_io_map_unmappable(RMTFS_MEMORY, RMTFS_SIZE, VM_WIMG_WCOMB);
+	memset((void *)rmtfs, 0, RMTFS_SIZE);
+	settle();
+	if (!assign_mem("rmtfs", RMTFS_MEMORY, RMTFS_SIZE, &rmtfs_owners, true, true)) {
+		say("mi8rp: mss: the rmtfs memory could not be shared with the MSS\n");
+		return false;
+	}
+	bzero(&hc, sizeof(hc));
+	hc.qrtr = mi8_glink_qrtr_ops(modem_gl);
+	hc.publish = svc_publish;
+	hc.part_size = svc_part_size;
+	hc.part_read = svc_part_read;
+	hc.file_size = svc_file_size;
+	hc.file_read = svc_file_read;
+	hc.rmtfs_virt = (void *)rmtfs;
+	hc.rmtfs_phys = RMTFS_MEMORY;
+	hc.rmtfs_size = RMTFS_SIZE;
+	hc.log = svc_log;
+	modem_hs = mi8_hostsvc_create(&hc);
+	if (modem_hs == NULL) {
+		say("mi8rp: mss: mi8_hostsvc_create failed\n");
+		return false;
+	}
+	modem_svc_run = true;
+	{
+		uint32_t wlfw = 0;
+
+		uint32_t srv = 0;
+
+		PE_parse_boot_argn("mi8rp_servreg", &srv, sizeof(srv));
+		wl_servreg = srv;
+		if (PE_parse_boot_argn("mi8rp_wlfw", &wlfw, sizeof(wlfw)) && wlfw != 0) {
+			modem_wlfw_start(wlfw);
+		}
+	}
+	if (kernel_thread_start(modem_svc_thread, NULL, &thread) != KERN_SUCCESS) {
+		return false;
+	}
+	thread_deallocate(thread);
+	return true;
+}
+
+/* Our SMP2P item for the modem, made before the Q6 starts so that the modem finds it when it comes up. */
+static bool
+modem_prepare_smp2p(void)
+{
+	static const char *const names[] = { "master-kernel", "ipa-ap-to-modem" };
+	uint32_t cacheline = 0, psize = 0, size = 0, partition = smem_partition(SMEM_US, SMEM_MODEM, &cacheline, &psize);
+
+	rem.remote = SMEM_MODEM;
+	rem.theirs_item = ITEM_SMP2P_THEIRS_ALT;
+	rem.doorbell = IPC_SMP2P_MODEM;
+	if (partition == 0) {
+		return false;
+	}
+	our_item = item_find(partition, cacheline, ITEM_SMP2P_OURS_ALT, &size);
+	if (our_item == 0) {
+		make_our_item(SMEM_MODEM, ITEM_SMP2P_OURS_ALT, names, 2);
+		our_item = item_find(partition, cacheline, ITEM_SMP2P_OURS_ALT, &size);
+	} else {
+		smp2p_fill(our_item, SMEM_MODEM, names, 2);
+	}
+	smp2p_agreed = smp2p_restart_acks = smp2p_restart_acked = false;
+	say("mi8rp: mss: our SMP2P item for the modem (428) is %s\n", our_item ? "ready" : "NOT THERE");
+	/* Linux's qcom_glink_smem_register() allocates the GLINK descriptor (478, 32 bytes) and the first FIFO (479, 16 KB) itself;
+	 * the modem makes 480 and waits for ours (EXP-0200: without 479 it gave up after 37 s). Made before the modem starts, zeroed. */
+	{
+		static const struct { uint32_t item, size; } glink[] = { { ITEM_GLINK_DESCRIPTOR, 32 }, { ITEM_GLINK_FIFO, 16384 } };
+
+		for (unsigned i = 0; i < 2; i++) {
+			uint32_t at = item_find(partition, cacheline, glink[i].item, &size);
+
+			if (at == 0 && lock_take()) {
+				bool made = item_make_locked(partition, glink[i].item, glink[i].size);
+
+				lock_give();
+				at = made ? item_find(partition, cacheline, glink[i].item, &size) : 0;
+			}
+			for (uint32_t off = 0; at != 0 && off + 4 <= size && off < glink[i].size; off += 4) {
+				smem_poke(at + off, 0);
+			}
+			settle();
+			say("mi8rp: mss: GLINK item %u of the modem: %s (%u bytes)\n", glink[i].item, at ? "ours, zeroed" : "NOT MADE", at ? size : 0);
+		}
+	}
+	return our_item != 0;
+}
+
+/* Wait for MBA_STATUS to be `want` (or negative): returns the status, or 0 on timeout. */
+static int32_t
+mba_wait(vm_offset_t rmb, int32_t want, uint32_t ms)
+{
+	int32_t status = 0;
+
+	for (uint32_t t = 0; t < ms; t++) {
+		status = (int32_t)rd(rmb + RMB_MBA_STATUS);
+		if (status < 0 || status == want) {
+			return status;
+		}
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	return status == want ? status : 0;
+}
+
+/* Copy `length` bytes (or zeros) to physical memory in the modem's region through a short-lived mapping. */
+static bool
+put_phys(uint64_t phys, const void *from, uint32_t length)
+{
+	uint64_t base = phys & ~(uint64_t)(PAGE_SIZE - 1);      /* the kernel's pages are 16 KB: a 4 KB-aligned map panics on unmap (EXP-0198) */
+	uint32_t off = (uint32_t)(phys - base), span = (off + length + PAGE_SIZE - 1) & ~(uint32_t)(PAGE_SIZE - 1);
+	vm_offset_t va = ml_io_map_unmappable((vm_offset_t)base, span, VM_WIMG_WCOMB);
+
+	if (va == 0) {
+		return false;
+	}
+	if (from) {
+		memcpy((void *)(va + off), from, length);
+	} else {
+		memset((void *)(va + off), 0, length);
+	}
+	settle();
+	ml_io_unmap(va, span);
+	return true;
+}
+
+static bool modem_kept;
+
+static bool
+modem_watch(uint32_t seconds, uint32_t after_ready_ms)
+{
+	struct smp2p words, last;
+	uint64_t started = now_us(), limit = started + seconds * 1000000ull, now, ready_at = 0;
+	uint32_t changes = 0, state, beat = 0;
+	bool have = false;
+
+	bzero(&last, sizeof(last));
+	ring(rem.doorbell);
+	for (;;) {
+		now = now_us();
+		if (now >= limit) {
+			break;
+		}
+		if (ready_at != 0 && (now - ready_at) / 10000000ull >= beat + 1) {
+			uint32_t size = 0;
+
+			beat++;
+			say("mi8rp: mss: +%u s after ready: \"slave-kernel\" %#x, GLINK items 478 %s, 479 %s, 480 %s\n", beat * 10, dsp_words(&words) ? dsp_state(&words) : 0,
+			    adsp_item(ITEM_GLINK_DESCRIPTOR, &size) ? "yes" : "no", adsp_item(ITEM_GLINK_FIFO, &size) ? "yes" : "no", adsp_item(480, &size) ? "yes" : "no");
+		}
+		if (dsp_words(&words) && (!have || memcmp(&words, &last, sizeof(words)) != 0)) {
+			char when[64];
+
+			snprintf(when, sizeof(when), "mss: +%llu.%03llu ms: the modem's item %s", (now - started) / 1000, (now - started) % 1000, have ? "changes" : "APPEARS");
+			if (changes++ < 40) {
+				show_words(when, &words);
+			}
+			last = words;
+			have = true;
+			dsp_listen(&words);
+			state = dsp_state(&words);
+			if ((state & DSP_READY) && ready_at == 0) {
+				ready_at = now;
+				limit = now + after_ready_ms * 1000ull;
+				say("mi8rp: mss: THE MODEM SAYS IT IS UP: \"slave-kernel\" %#x, %llu.%03llu ms after the wait began\n", state, (now - started) / 1000, (now - started) % 1000);
+			}
+			if (state & DSP_FATAL) {
+				say("mi8rp: mss: THE MODEM SAYS IT HAS GIVEN UP\n");
+				show_crash_reason();
+				return false;
+			}
+		}
+		delay_for_interval(200, NSEC_PER_USEC);
+	}
+	if (ready_at == 0) {
+		say("mi8rp: mss: %s\n", have ? "THE MODEM RUNS BUT HAS NOT SAID \"UP\"" : "NOT A WORD FROM THE MODEM");
+		show_crash_reason();
+	}
+	return ready_at != 0;
+}
+
+/* Linux q6v5_mpss_init_image + q6v5_mpss_load + qcom_q6v5_wait_for_start, then the stop request. The MBA is running already. */
+static bool
+modem_load_and_run(vm_offset_t rmb, uint64_t *mpss_owners)
+{
+	struct {
+		uint32_t paddr, file_size, memory_size, index;
+	} seg[MAX_SEGMENTS];
+	unsigned segments = 0;
+	uint8_t *mdt, *chunk = NULL;
+	uint32_t mdt_size = 0, count, ehdr_size = 0, hash_size = 0, lowest = ~0u, wait_seconds = 10, used = 0, hold = 0;
+	uint64_t loaded = 0;
+	bool relocate = false, ok = false;
+	const uint32_t chunk_size = 256 * 1024;
+	int32_t status;
+	uint32_t mpss_reloc, boot_addr;
+	uint64_t started;
+
+	PE_parse_boot_argn("mi8rp_wait", &wait_seconds, sizeof(wait_seconds));
+	PE_parse_boot_argn("mi8rp_hold", &hold, sizeof(hold));
+	announce(6, "(W2f) modem.mdt: the header and hashes go to the MBA, which authenticates them");
+	mdt = fs_slurp("image/modem.mdt", &mdt_size);
+	if (mdt == NULL || mdt_size > PAGE_SIZE) {
+		say("mi8rp: mss: modem.mdt not read or too big\n");
+		return false;
+	}
+	count = mdt[44] | mdt[45] << 8;
+	for (uint32_t i = 0; i < count; i++) {
+		struct elf_phdr ph;
+
+		memcpy(&ph, mdt + 52 + 32 * i, sizeof(ph));
+		if (i == 0) {
+			ehdr_size = ph.file_size;
+		} else if (MDT_HASH(ph.flags) && hash_size == 0) {
+			hash_size = ph.file_size;
+		}
+		if (ph.type != 1 || MDT_HASH(ph.flags) || ph.memory_size == 0 || segments >= MAX_SEGMENTS) {
+			continue;
+		}
+		relocate |= (ph.flags & MDT_RELOCATABLE) != 0;
+		lowest = MIN(lowest, ph.paddr);
+		seg[segments].paddr = ph.paddr;
+		seg[segments].file_size = ph.file_size;
+		seg[segments].memory_size = ph.memory_size;
+		seg[segments].index = i;
+		segments++;
+	}
+	mpss_reloc = relocate ? lowest : MPSS_MEMORY;
+	boot_addr = relocate ? MPSS_MEMORY : lowest;
+	for (unsigned i = 0; i < segments; i++) {
+		if (seg[i].paddr < mpss_reloc || (uint64_t)seg[i].paddr - mpss_reloc + seg[i].memory_size > MPSS_SIZE || seg[i].file_size > seg[i].memory_size) {
+			say("mi8rp: mss: segment %u is outside the modem region\n", seg[i].index);
+			goto done;
+		}
+	}
+	say("mi8rp: mss: modem.mdt: %u bytes (header %u + hashes %u), %u segments from %#x, %s\n", mdt_size, ehdr_size, hash_size, segments, lowest,
+	    relocate ? "relocatable" : "fixed");
+	if (segments == 0 || ehdr_size + hash_size != mdt_size) {
+		say("mi8rp: mss: the .mdt is not the packed header+hash layout: stops\n");
+		goto done;
+	}
+	/* the metadata is in the MBA region already (+1 MB, written with the MBA image: TrustZone refuses MP_ASSIGN of a page of ours, EXP-0198) */
+	wr(rmb + RMB_CODE_LENGTH, 0);
+	wr(rmb + RMB_META_DATA, MBA_MEMORY + MBA_META_OFFSET);
+	wr(rmb + RMB_COMMAND, 1);
+	status = mba_wait(rmb, MBA_META_AUTH_OK, 1000);
+	say("mi8rp: mss: after META_DATA_READY the MBA says %d (3 is: %s)\n", status, "header authenticated");
+	if (status != MBA_META_AUTH_OK) {
+		goto done;
+	}
+	/* the image: shared between us and the MSS while it is written */
+	announce(6, "(W2f) writes the modem's segments (28 files) into its 120 MB, telling the MBA after each one");
+	assign_mem("mpss", MPSS_MEMORY, MPSS_SIZE, mpss_owners, true, false);
+	if (!assign_mem("mpss", MPSS_MEMORY, MPSS_SIZE, mpss_owners, true, true)) {
+		goto done;
+	}
+	chunk = kalloc_data(chunk_size, Z_WAITOK);
+	if (chunk == NULL) {
+		goto done;
+	}
+	started = now_us();
+	for (unsigned i = 0; i < segments; i++) {
+		struct fs_file f;
+		char path[40];
+
+		if (seg[i].file_size) {
+			snprintf(path, sizeof(path), "image/modem.b%02u", seg[i].index);
+			if (!fs_lookup(path, &f) || f.size != seg[i].file_size) {
+				say("mi8rp: mss: %s missing or of another size\n", path);
+				goto done;
+			}
+		}
+		say("mi8rp: mss: segment %u: %#x, %u bytes in memory, %u from %s\n", seg[i].index, seg[i].paddr, seg[i].memory_size, seg[i].file_size, seg[i].file_size ? path : "nothing");
+		for (uint32_t at = 0; at < seg[i].memory_size; at += chunk_size) {
+			uint32_t take = MIN(chunk_size, seg[i].memory_size - at), from_file = 0;
+
+			if (at < seg[i].file_size) {
+				from_file = MIN(take, seg[i].file_size - at);
+				if (fs_file_read(&f, at, chunk, from_file) != 0) {
+					say("mi8rp: mss: %s: read error\n", path);
+					goto done;
+				}
+			}
+			memset(chunk + from_file, 0, take - from_file);
+			if (!put_phys((uint64_t)MPSS_MEMORY + (seg[i].paddr - mpss_reloc) + at, chunk, take)) {
+				say("mi8rp: mss: no mapping for segment %u\n", seg[i].index);
+				goto done;
+			}
+		}
+		loaded += seg[i].memory_size;
+		used += seg[i].file_size;
+		if (rd(rmb + RMB_CODE_LENGTH) == 0) {
+			wr(rmb + RMB_CODE_START, boot_addr);
+			wr(rmb + RMB_COMMAND, 2);
+		}
+		wr(rmb + RMB_CODE_LENGTH, (uint32_t)loaded);
+		status = (int32_t)rd(rmb + RMB_MBA_STATUS);
+		if (status < 0) {
+			say("mi8rp: mss: THE MBA REJECTS SEGMENT %u (status %d)\n", seg[i].index, status);
+			goto done;
+		}
+	}
+	say("mi8rp: mss: %u segments, %llu bytes of memory (%u from files) written in %llu ms; MBA status %d\n", segments, loaded, used,
+	    (now_us() - started) / 1000, (int32_t)rd(rmb + RMB_MBA_STATUS));
+	if (!assign_mem("mpss", MPSS_MEMORY, MPSS_SIZE, mpss_owners, false, true)) {
+		goto done;
+	}
+	status = mba_wait(rmb, MBA_AUTH_COMPLETE, 10000);
+	say("mi8rp: mss: %s (MBA status %d)\n", status == MBA_AUTH_COMPLETE ? "THE MBA HAS AUTHENTICATED THE MODEM IMAGE AND STARTED IT" : "THE MBA DOES NOT REPORT AUTH COMPLETE", status);
+	if (status != MBA_AUTH_COMPLETE) {
+		goto done;
+	}
+	{
+		uint32_t services = 0;
+
+		PE_parse_boot_argn("mi8rp_svc", &services, sizeof(services));
+		if (services) {
+			announce(6, "(W2f) starts the GLINK link and the host services (rmtfs, tqftpserv, pd-mapper) for the modem");
+			modem_services_start();
+		}
+	}
+	announce(6, "(W2f) waits for the modem's SMP2P 'up' (bit 1 of slave-kernel), then watches a few seconds more");
+	ok = modem_watch(wait_seconds, hold ? hold * 1000 : 4000);
+	modem_kept = ok && hold;
+	{
+		uint32_t size = 0;
+
+		say("mi8rp: mss: SMEM items now: 435 (SMP2P) %s, 478 (GLINK descriptor) %s, 479 (GLINK fifo) %s\n", adsp_item(ITEM_SMP2P_THEIRS_ALT, &size) ? "yes" : "no",
+		    adsp_item(ITEM_GLINK_DESCRIPTOR, &size) ? "yes" : "no", adsp_item(ITEM_GLINK_FIFO, &size) ? "yes" : "no");
+	}
+	if (ok && !hold) {
+		dsp_ask_to_stop(5000);
+	}
+done:
+	kfree_data(mdt, mdt_size);
+	if (chunk) {
+		kfree_data(chunk, chunk_size);
+	}
+	return ok;
+}
+
+static void
+mss_w2e(bool load)
+{
+	bool turned[MSS_CLOCKS] = { false };
+	bool rails = false, qmp = false, released = false, ok = false;
+	uint64_t mba_owners = 1ull << VMID_HLOS, mpss_owners = 1ull << VMID_HLOS;
+	vm_offset_t rmb = 0, pdc = 0, restart = 0, q6 = 0, tcsr = 0, image;
+	uint8_t *mba_file;
+	uint32_t file_size = 0, value;
+	uint32_t address, back = 7;
+	bool halted = true;
+
+	PE_parse_boot_argn("mi8rp_back", &back, sizeof(back));
+	announce(5, "(W2e) writes mba.mbn into the MBA region, then brings the modem up as Linux q6v5_mba_load does and starts its Q6 (no modem image)");
+	mba_file = fs_slurp("image/mba.mbn", &file_size);
+	if (mba_file == NULL || file_size > MBA_SIZE) {
+		say("mi8rp: mss: mba.mbn not read or too big\n");
+		return;
+	}
+	image = ml_io_map_unmappable(MBA_MEMORY, MBA_SIZE, VM_WIMG_WCOMB);
+	memcpy((void *)image, mba_file, file_size);
+	settle();
+	if (memcmp((void *)image, mba_file, file_size) != 0) {
+		say("mi8rp: mss: THE MBA IMAGE READS BACK DIFFERENTLY: stops\n");
+		ml_io_unmap(image, MBA_SIZE);
+		kfree_data(mba_file, file_size);
+		return;
+	}
+	say("mi8rp: mss: mba.mbn (%u bytes) is in the MBA region and reads back the same\n", file_size);
+	if (load) {
+		uint32_t meta_size = 0;
+		uint8_t *meta = fs_slurp("image/modem.mdt", &meta_size);
+
+		if (meta == NULL || meta_size > MBA_SIZE - MBA_META_OFFSET) {
+			say("mi8rp: mss: modem.mdt not read or too big\n");
+			ml_io_unmap(image, MBA_SIZE);
+			kfree_data(mba_file, file_size);
+			return;
+		}
+		memcpy((void *)(image + MBA_META_OFFSET), meta, meta_size);
+		settle();
+		if (memcmp((void *)(image + MBA_META_OFFSET), meta, meta_size) != 0) {
+			say("mi8rp: mss: THE METADATA READS BACK DIFFERENTLY: stops\n");
+			ml_io_unmap(image, MBA_SIZE);
+			kfree_data(mba_file, file_size);
+			kfree_data(meta, meta_size);
+			return;
+		}
+		say("mi8rp: mss: modem.mdt (%u bytes) is in the MBA region at +1 MB\n", meta_size);
+		kfree_data(meta, meta_size);
+	}
+	ml_io_unmap(image, MBA_SIZE);                   /* the region goes to the MSS: nothing of ours may touch it */
+	kfree_data(mba_file, file_size);
+
+	rmb = ml_io_map(RMB_PHYS, 0x1000);
+	pdc = ml_io_map(PDC_PHYS, 0x1000);
+	restart = ml_io_map(AOSS_CC_PHYS, 0x1000);
+	q6 = ml_io_map(QDSP6SS_PHYS, 0x1000);
+	tcsr = ml_io_map(TCSR_HALT_PHYS, 0x10000);
+
+	qmp = qmp_send("{class: image, res: load_state, name: modem, val: on}");
+	if (!qmp) {
+		return;
+	}
+	rails = rpmh_level_pos("cx.lvl", 0xffffffffu) && rpmh_level_pos("mx.lvl", 0xffffffffu) && rpmh_level_pos("mss.lvl", 0xffffffffu);
+	if (!rails || !mss_clocks_on(0, 3, turned)) {
+		goto out;
+	}
+	announce(5, "(W2e) takes the modem out of reset");
+	mss_reset_deassert(rmb, pdc, restart);
+	released = true;
+	if (!mss_clocks_on(3, MSS_CLOCKS, turned)) {
+		goto out;
+	}
+	announce(5, "(W2e) hands the modem region and the MBA region to the MSS");
+	if (!assign_mem("mpss", MPSS_MEMORY, MPSS_SIZE, &mpss_owners, false, true) || !assign_mem("mba", MBA_MEMORY, MBA_SIZE, &mba_owners, false, true)) {
+		goto out;
+	}
+	if (load && !modem_prepare_smp2p()) {
+		goto out;
+	}
+	wr(rmb, MBA_MEMORY);
+	announce(5, "(W2e) starts the Q6: SLEEP clock, BOOT_CORE_START, BOOT_CMD; waits for the boot FSM, the PBL and the MBA");
+	wr(q6 + QDSP6SS_SLEEP, rd(q6 + QDSP6SS_SLEEP) | Q6SS_CBCR_CLKEN);
+	settle();
+	for (unsigned t = 0; t < 2000 && (rd(q6 + QDSP6SS_SLEEP) & Q6SS_CBCR_CLKOFF); t++) {
+		delay_for_interval(1, NSEC_PER_USEC);
+	}
+	value = rd(q6 + QDSP6SS_SLEEP);
+	say("mi8rp: mss: QDSP6SS sleep clock word %#x (%s)\n", value, value & Q6SS_CBCR_CLKOFF ? "STILL OFF" : "on");
+	if (value & Q6SS_CBCR_CLKOFF) {
+		goto out;
+	}
+	wr(q6 + QDSP6SS_BOOT_CORE_START, 1);
+	wr(q6 + QDSP6SS_BOOT_CMD, 1);
+	settle();
+	for (unsigned t = 0; t < 2000 && !(rd(rmb + RMB_MSS_STATUS) & 1); t++) {
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+	say("mi8rp: mss: boot FSM: MSS_STATUS %#x\n", rd(rmb + RMB_MSS_STATUS));
+	if (!(rd(rmb + RMB_MSS_STATUS) & 1)) {
+		say("mi8rp: mss: THE BOOT FSM DID NOT COMPLETE\n");
+		goto out;
+	}
+	for (unsigned t = 0; t < 1000 && rd(rmb + RMB_PBL_STATUS) == 0; t++) {
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	value = rd(rmb + RMB_PBL_STATUS);
+	say("mi8rp: mss: PBL_STATUS %#x (1 is success)\n", value);
+	if (value != 1) {
+		goto out;
+	}
+	for (unsigned t = 0; t < 5000 && (value = rd(rmb + RMB_MBA_STATUS)) == 0; t++) {
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	say("mi8rp: mss: MBA_STATUS %d (1 or 2: XPU unlocked), PBL %#x, MSS_STATUS %#x\n", (int32_t)value, rd(rmb + RMB_PBL_STATUS), rd(rmb + RMB_MSS_STATUS));
+	ok = value == 1 || value == 2;
+	if (ok) {
+		say("mi8rp: mss: THE MBA RUNS ON THE MODEM'S Q6 AND SAYS IT UNLOCKED THE XPU\n");
+		if (load) {
+			ok = modem_load_and_run(rmb, &mpss_owners);
+			if (modem_kept) {
+				say("mi8rp: mss: mi8rp_hold: the modem is LEFT RUNNING (no stop, nothing taken back); reset the phone to stop it\n");
+				return;
+			}
+		} else {
+			delay_for_interval(1000, NSEC_PER_MSEC);
+			say("mi8rp: mss: a second later MBA_STATUS %d, PBL %#x\n", (int32_t)rd(rmb + RMB_MBA_STATUS), rd(rmb + RMB_PBL_STATUS));
+		}
+	}
+out:
+	announce(5, "(W2e) takes it all back as Linux q6v5_mba_reclaim does: halt the AXI ports, reset, clocks, memory, rails, QMP");
+	if (released) {
+		announce(5, "(W2e) back 1: halts the q6 AXI port (after half a second for the modem to settle after its stop-ack)");
+		delay_for_interval(500, NSEC_PER_MSEC);
+		halted &= halt_port("q6", tcsr + 0x3000);
+		announce(5, "(W2e) back 2: halts the modem AXI port");
+		halted &= halt_port("modem", tcsr + 0x5000);
+		announce(5, "(W2e) back 3: halts the nc AXI port");
+		halted &= halt_port("nc", tcsr + 0x4000);
+		announce(5, "(W2e) back 4: puts the modem into reset");
+		mss_reset_assert(pdc, restart);
+	}
+	announce(5, "(W2e) back 5: turns the clocks off");
+	mss_clocks_off(1, 3, turned);
+	mss_clocks_off(3, MSS_CLOCKS, turned);
+	mss_clocks_off(0, 1, turned);
+	if (!halted) {
+		say("mi8rp: mss: A PORT DID NOT HALT: the memory is NOT given back (TrustZone took the phone down with it, EXP-0198); reset the phone before the next run\n");
+		return;
+	}
+	if (back < 6) {
+		say("mi8rp: mss: mi8rp_back=%u: stops before giving the memory back (the regions stay the modem's until the phone is reset)\n", back);
+		return;
+	}
+	announce(5, "(W2e) back 6: gives the MBA and modem memory back to the kernel");
+	if (mba_owners != (1ull << VMID_HLOS)) {
+		assign_mem("mba", MBA_MEMORY, MBA_SIZE, &mba_owners, true, false);
+	}
+	if (mpss_owners != (1ull << VMID_HLOS)) {
+		assign_mem("mpss", MPSS_MEMORY, MPSS_SIZE, &mpss_owners, true, false);
+	}
+	announce(5, "(W2e) back 7: rails and QMP");
+	if (back < 7) {
+		say("mi8rp: mss: mi8rp_back=%u: stops before the rails and QMP\n", back);
+		return;
+	}
+	gcc_show();
+	if (rails) {
+		rpmh_level_pos("mss.lvl", 0);
+		rail_position("mss.lvl", 0, &address, false);
+	}
+	qmp_send("{class: image, res: load_state, name: modem, val: off}");
+	if (mba_owners != (1ull << VMID_HLOS) || mpss_owners != (1ull << VMID_HLOS)) {
+		say("mi8rp: mss: A REGION IS STILL THE MODEM'S: DO NOT TOUCH IT (mba %#llx, mpss %#llx)\n", mba_owners, mpss_owners);
+	}
+	say("mi8rp: mss: W2%c done: %s\n", load ? 'f' : 'e', ok ? (load ? "the modem came up and everything was taken back" : "the MBA ran and everything was taken back") : "A STEP FAILED, everything was taken back");
+}
+
+static void
+mss_w2e_thread(void *parameter, __unused wait_result_t wr)
+{
+	uint8_t probe;
+
+	unsigned waited;
+
+	for (waited = 0; waited < 600; waited++) {
+		if (redwood_ufs_read_named("modem", 0, &probe, 1) == 0) {
+			break;
+		}
+		delay_for_interval(100, NSEC_PER_MSEC);
+	}
+	say("mi8rp: mss: the modem partition is %s after %u ms of waiting\n", waited < 600 ? "readable" : "STILL NOT readable", waited * 100);
+	mss_w2e(parameter != NULL);
+	thread_terminate(current_thread());
+}
+
+/* The partitions are there some time after the system starts; steps 5 and on run on a thread that waits for them. */
+static void
+steps_from_five(void *parameter, __unused wait_result_t wr)
+{
+	uint32_t last = (uint32_t)(uintptr_t)parameter;
+	uint8_t probe;
+
+	for (unsigned i = 0; i < 600; i++) {
+		if (redwood_ufs_read_named("modem", 0, &probe, 1) == 0) {
+			break;
+		}
+		delay_for_interval(100, NSEC_PER_MSEC);
+	}
+	if (last >= 5) {
+		step_firmware();
+	}
+	if (last >= 6) {
+		step_aop();
+	}
+	if (last >= 7 && step_header() && step_image() && last >= 8) {
+		bool up = step_start();
+
+		if (adsp_started) {
+			dsp_shutdown(up ? "the watch is over" : "it did not come up");
+		}
+		say("mi8rp: step 8 done%s\n", up ? ": the audio DSP came up and was stopped" : ": THE AUDIO DSP DID NOT COME UP");
+	}
+	thread_terminate(current_thread());
+}
+
+/* ---- boot-arg mi8rp_wlan=1: read-only look at what the radio (WCN3990) will need: its SMMU stream and the RPMh resources (docs/wifi-power-irq.md) ---- */
+
+#define APPS_SMMU_PHYS          0x15000000ul    /* dt: apps-smmu@0x15000000, qsmmu-v500 (the hypervisor owns its setup: qcom,skip-init) */
+#define SMMU_SCR0               0x000
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_SMR(n)             (0x800 + 4 * (n))
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))
+#define WLAN_STREAM             0x40            /* dt: qcom,icnss iommus = <&apps_smmu 0x40 0x01> */
+#define WLAN_STREAM_MASK        0x01
+
+static void
+wlan_look(void)
+{
+	static const char *const kinds[] = { "translated by context", "PASSED UNTRANSLATED (bypass)", "MADE TO FAULT", "of a reserved kind" };
+	static const char *const rpmh[] = { "ldoa5", "ldoa7", "ldoa17", "ldoa25", "rfclka2", "smpa4" };
+	vm_offset_t smmu;
+	uint32_t scr0, idr0, idr1, matches, valid = 0, covering = 0, address;
+
+	announce(9, "(wlan) reads the global registers of the application processors' SMMU (0x15000000): the first access of ours to that block");
+	smmu = ml_io_map(APPS_SMMU_PHYS, 0x4000);
+	scr0 = rd(smmu + SMMU_SCR0);
+	idr0 = rd(smmu + SMMU_IDR0);
+	idr1 = rd(smmu + SMMU_IDR1);
+	matches = idr0 & 0xff;
+	say("mi8rp: wlan: SCR0 %#x IDR0 %#x IDR1 %#x: the SMMU is %s; %u stream match registers, %u contexts; a stream nobody matches %s\n", scr0, idr0, idr1,
+	    scr0 & 1 ? "OFF" : "on", matches, idr1 & 0xff, scr0 & (1u << 10) ? "faults" : "passes untranslated");
+	for (uint32_t n = 0; n < matches && 0x800 + 4 * n < 0xc00; n++) {
+		uint32_t smr = rd(smmu + SMMU_SMR(n)), s2cr = rd(smmu + SMMU_S2CR(n));
+		bool wide = (scr0 & (1u << 3)) != 0;
+		uint32_t stream = smr & (wide ? 0xffff : 0x7fff), mask = (smr >> 16) & (wide ? 0xffff : 0x7fff);
+
+		if (!(wide ? s2cr & (1u << 10) : smr >> 31)) {
+			continue;
+		}
+		valid++;
+		if (((stream ^ WLAN_STREAM) & ~(mask | WLAN_STREAM_MASK)) != 0) {
+			continue;
+		}
+		say("mi8rp: wlan: match register %u covers the radio's stream %#x: stream %#x mask %#x (smr %#x), %s (%u); s2cr %#x\n", n, WLAN_STREAM, stream, mask,
+		    smr, kinds[(s2cr >> 16) & 3], s2cr & 0xff, s2cr);
+		covering++;
+	}
+	say("mi8rp: wlan: %u of the %u match registers are in use; %u cover stream %#x%s\n", valid, matches, covering, WLAN_STREAM,
+	    covering ? "" : ": NOTHING IS SET UP FOR THE RADIO'S STREAM");
+	announce(9, "(wlan) looks the radio's RPMh resources up in the command database (nothing is sent)");
+	for (unsigned i = 0; i < sizeof(rpmh) / sizeof(rpmh[0]); i++) {
+		address = 0;
+		if (rail_position(rpmh[i], 0, &address, false) == 0 || address != 0) {
+			say("mi8rp: wlan: cmd-db \"%s\" is at %#x\n", rpmh[i], address);
+		}
+	}
+	say("mi8rp: wlan: done: nothing was written\n");
+}
+
+/* The radio's four supplies (docs/wifi-power-irq.md §2): pm8998 LDOs through RPMh VRM registers: +0 voltage in mV, +4 enable, +8 mode (7 = HPM). */
+static const struct wlan_supply {
+	const char *name;
+	uint32_t millivolts;
+} wlan_supplies[] = { { "ldoa5", 800 }, { "ldoa7", 1800 }, { "ldoa17", 1300 }, { "ldoa25", 3300 } };    /* dt: cx-mx, xo, rfa, ch0 */
+
+static bool
+wlan_power(bool on)
+{
+	bool ok = true;
+	unsigned n = sizeof(wlan_supplies) / sizeof(wlan_supplies[0]);
+
+	for (unsigned k = 0; k < n; k++) {
+		const struct wlan_supply *v = &wlan_supplies[on ? k : n - 1 - k];
+		uint32_t address = 0;
+
+		if (rail_position(v->name, 0, &address, false) != 0 && address == 0) {
+			say("mi8rp: wlan: no \"%s\" in the command database\n", v->name);
+			return false;
+		}
+		if (on) {
+			ok = rpmh_write(v->name, address + 0, v->millivolts) && ok;         /* voltage, mV */
+			ok = rpmh_write(v->name, address + 8, 7) && ok;                     /* mode: HPM */
+			ok = rpmh_write(v->name, address + 4, 1) && ok;                     /* enable */
+		} else {
+			ok = rpmh_write(v->name, address + 4, 0) && ok;
+		}
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	return ok;
+}
+
+#define WLAN_PHYS               0x18800000ul    /* dt: qcom,icnss membase, 8 MB; the copy engines are at +0x240000 (ath10k hw.c wcn3990_regs) */
+
+static void
+wlan_power_experiment(uint32_t level)
+{
+	bool ok;
+
+	announce(9, "(wlan) switches the radio's four supplies on through RPMh: 0.8 V (ldoa5), 1.8 V (ldoa7), 1.3 V (ldoa17), 3.3 V (ldoa25)");
+	ok = wlan_power(true);
+	say("mi8rp: wlan: the supplies are %s\n", ok ? "ON (every RPMh command was said done)" : "NOT ALL ON");
+	delay_for_interval(20, NSEC_PER_MSEC);
+	if (ok && level >= 3) {
+		vm_offset_t ce;
+
+		announce(9, "(wlan) reads the radio's copy-engine registers (0x18a40000..): the first access of ours to the chip");
+		ce = ml_io_map(WLAN_PHYS + 0x240000, 0x10000);
+		for (unsigned i = 0; i < 6; i++) {
+			say("mi8rp: wlan: chip +%#x = %#x\n", 0x240000 + 4 * i, rd(ce + 4 * i));
+		}
+		say("mi8rp: wlan: chip wrapper +0x24c000 = %#x\n", rd(ce + 0xc000));
+	}
+	announce(9, "(wlan) switches the supplies off again");
+	ok = wlan_power(false);
+	say("mi8rp: wlan: the supplies are %s\n", ok ? "OFF (every RPMh command was said done)" : "not all said off");
+}
+
+/* Called while the system starts (bsd/dev/redwood_input.c). */
+void
+mi8_rproc_init(void)
+{
+	uint32_t last = 0;
+
+	uint32_t mss = 0;
+
+	PE_parse_boot_argn("mi8rp_pause", &pause_ms, sizeof(pause_ms));
+	{
+		uint32_t pre = 0;
+
+		/* mi8rp_wlfw=4: the radio's supplies are on before the modem starts (EXP-0203: msa_info said INCOMPATIBLE_STATE for 20 s with the chip off, and with it switched on 3 s late) */
+		if (PE_parse_boot_argn("mi8rp_wlfw", &pre, sizeof(pre)) && pre == 4) {
+			announce(9, "(wlfw) switches the radio's four supplies on before the modem is started, and leaves them on");
+			say("mi8rp: wlfw: supplies %s\n", wlan_power(true) ? "on" : "NOT ALL ON");
+		}
+	}
+	{
+		uint32_t wlan = 0;
+
+		if (PE_parse_boot_argn("mi8rp_wlan", &wlan, sizeof(wlan)) && wlan != 0) {
+			if (wlan == 1) {
+				wlan_look();
+			} else {
+				wlan_power_experiment(wlan);
+			}
+		}
+	}
+	if (PE_parse_boot_argn("mi8rp_mss", &mss, sizeof(mss)) && mss != 0) {
+		uint32_t lx = 0;
+
+		/* FW_READY arrives after launchd has fragmented physical memory.
+		 * Reserve the pool now; mapping still waits for the WLFW SMMU setup. */
+		if (mss == 6 && PE_parse_boot_argn("mi8rp_lx", &lx, sizeof(lx)) && lx != 0 &&
+		    lx_os_reserve_radio_memory(LX_RADIO_POOL_SIZE) != 0) {
+			say("mi8rp: no early radio memory; modem startup skipped\n");
+			return;
+		}
+		say("mi8rp: mss steps up to %u\n", mss);
+		if (mss == 5 || mss == 6) {
+			thread_t thread;
+
