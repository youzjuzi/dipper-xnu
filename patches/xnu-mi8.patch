+static void
+save_replay(struct mi8_hostsvc *h, uint32_t node, uint32_t port, const uint8_t *req, unsigned rn, const uint8_t *rsp, unsigned sn)
+{
+	struct replay *c = &h->replays[h->next_replay++ % CACHES];
+	uint8_t *request = MI8_ALLOC(rn), *response = MI8_ALLOC(sn);
+	if (!request || !response) {
+		if (request) MI8_FREE(request, rn);
+		if (response) MI8_FREE(response, sn);
+		return;
+	}
+	memcpy(request, req, rn); memcpy(response, rsp, sn);
+	if (c->request) MI8_FREE(c->request, c->request_size);
+	if (c->response) MI8_FREE(c->response, c->response_size);
+	c->request = request; c->response = response; c->request_size = rn; c->response_size = sn; c->node = node; c->port = port;
+}
