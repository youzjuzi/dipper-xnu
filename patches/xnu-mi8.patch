+static unsigned
+rmtfs(struct mi8_hostsvc *h, unsigned msg, uint32_t node, uint32_t port, const struct tlv *t, struct builder *b)
+{
+	struct handle *handle;
+	unsigned i;
+	if (msg == R_OPEN) {
+		char path[256];
+		unsigned index;
+		uint64_t size;
+		uint8_t *copy;
+		if (!t[1].p || !text(t[1].p, t[1].n, path, sizeof(path))) return Q_MALFORMED;
+		for (index = 0; index < PARTS; index++) if (!strcmp(path, part_paths[index])) break;
+		LOG(h, LOG_OPEN, "mi8hs: rmtfs open path=%s -> %s\n", path, index < PARTS ? part_names[index] : "unknown");
+		if (index == PARTS) return Q_INVAL;
+		for (i = 0; i < HANDLES; i++) if (!h->handles[i].live) break;
+		if (i == HANDLES || h->next_handle == UINT32_MAX) return Q_NOMEM;
+		if (!h->partitions[index].data) {
+			if (index >= 4) {
+				size = BLANK_SIZE;
+			} else if (h->cfg.part_size(h->cfg.ctx, part_names[index], &size)) {
+				return Q_INTERNAL;
+			}
+			if (!size || size > PART_LIMIT || (size & 511)) return Q_INVAL;
+			copy = MI8_ALLOC((size_t)size);
+			if (!copy) return Q_NOMEM;
+			if (index < 4 && h->cfg.part_read(h->cfg.ctx, part_names[index], 0, copy, size)) {
+				MI8_FREE(copy, (size_t)size); return Q_INTERNAL;
+			}
+			h->partitions[index].data = copy; h->partitions[index].size = (uint32_t)size;
+		}
+		handle = &h->handles[i]; handle->id = ++h->next_handle; handle->live = true;
+		handle->partition = index; handle->node = node; handle->port = port;
+		add_number(b, 0x10, handle->id, 4);
+		return Q_NONE;
+	}
+	if (msg < R_CLOSE || msg > R_SYNC) return Q_UNSUPPORTED;
+	if (!has(t, 1, 4)) return Q_MALFORMED;
+	handle = find_handle(h, (uint32_t)getle(t[1].p, 4), node, port);
+	/* ALLOC_BUFF's first field is the shared memory's client id (the dt's qcom,client-id), not a handle of an OPEN (EXP-0200) */
+	if (!handle && msg != R_ALLOC) {
+		unsigned live = 0, first = 0;
+		for (i = 0; i < HANDLES; i++) if (h->handles[i].live) { if (!live) first = h->handles[i].id; live++; }
+		LOG(h, LOG_ERROR, "mi8hs: ERROR rmtfs msg=%u caller_id=%u from node %u port %u: %u handles live, first %u; tlv1 %u bytes, tlv2 %u, tlv3 %u, tlv4 %u\n",
+		    msg, (uint32_t)getle(t[1].p, 4), node, port, live, first, t[1].n, t[2].n, t[3].n, t[4].n);
+		return Q_BAD_HANDLE;
+	}
+	if (msg == R_RW) {
+		uint32_t count, direction, sectors = 0;
+		struct shadow *shadow = &h->partitions[handle->partition];
+		if (!has(t, 2, 1) || !t[3].p || !t[3].n || (t[4].p && !has(t, 4, 1))) return Q_MALFORMED;
+		direction = t[2].p[0]; count = t[3].p[0];
+		if (direction > 1 || !count || t[3].n != 1 + 12 * count) return Q_INVAL;
+		/* Preflight the entire batch so a bad last vector cannot partially apply a write. */
+		for (i = 0; i < count; i++) {
+			const uint8_t *v = t[3].p + 1 + 12 * i;
+			uint64_t at = getle(v, 4) * 512, phys = getle(v + 4, 4), n = getle(v + 8, 4) * 512;
+			if (at > shadow->size || n > shadow->size - at || phys < h->cfg.rmtfs_phys ||
+			    phys - h->cfg.rmtfs_phys > h->cfg.rmtfs_size || n > h->cfg.rmtfs_size - (phys - h->cfg.rmtfs_phys)) return Q_INVAL;
+			sectors += (uint32_t)(n / 512);
+		}
+		__sync_synchronize();
+		for (i = 0; i < count; i++) {
+			const uint8_t *v = t[3].p + 1 + 12 * i;
+			uint32_t at = (uint32_t)getle(v, 4) * 512, n = (uint32_t)getle(v + 8, 4) * 512;
+			uint8_t *shared = (uint8_t *)h->cfg.rmtfs_virt + (getle(v + 4, 4) - h->cfg.rmtfs_phys);
+			if (direction) memcpy(shared, shadow->data + at, n);
+			else memcpy(shadow->data + at, shared, n);
+		}
+		__sync_synchronize();
+		LOG(h, LOG_RW, "mi8hs: rmtfs rw dir=%d sectors=%u\n", (int)direction, sectors);
+	} else if (msg == R_ALLOC) {
+		uint32_t n;
+		if (!has(t, 2, 4)) return Q_MALFORMED;
+		n = (uint32_t)getle(t[2].p, 4);
+		LOG(h, LOG_ALLOC, "mi8hs: rmtfs alloc_buff size=%u client=%u\n", n, (uint32_t)getle(t[1].p, 4));
+		if (n > h->cfg.rmtfs_size) return Q_INVAL;
+		add_number(b, 0x10, h->cfg.rmtfs_phys, 8);
+	} else {
+		if (msg == R_CLOSE) handle->live = false;
+		if (msg == R_DEVERR) add_number(b, 0x10, 0, 4);
+		LOG(h, LOG_OTHER, "mi8hs: rmtfs request msg=%u handle=%u\n", msg, handle->id);
+	}
+	return Q_NONE;
+}
