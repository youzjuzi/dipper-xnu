+	}
+	if (last >= 2) {
+		step_lock_read();
+	}
+	if (last >= 3) {
+		step_lock_try();
+	}
+	if (last >= 4) {
+		step_our_items();
+	}
+	if (last >= 5) {
+		thread_t thread;
+
+		if (kernel_thread_start(steps_from_five, (void *)(uintptr_t)last, &thread) == KERN_SUCCESS) {
