+{
+	if (gGPULock == NULL) {
+		return;
+	}
+	IOLockLock(gGPULock);
+	for (unsigned i = 0; i < count; i++) {
+		if (surfaces[i] != NULL) {
+			assert(surfaces[i]->displayReaders != 0);
+			surfaces[i]->displayReaders--;
+		}
+	}
+	IOLockUnlock(gGPULock);
