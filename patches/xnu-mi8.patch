+		if (task_seen_count >= TASKLOAD_MAX) {
+			return PROC_RETURNED;
+		}
+		task_seen_count++;
+		task_seen[i].pid = pid;
+		task_seen[i].last = get_task_cpu_time(task);      /* (first sight: no change yet) */
+	}
+	task_seen[i].now = get_task_cpu_time(task);
+	strlcpy(task_seen[i].name, pid == 0 ? "kernel_task" : proc_best_name(p), sizeof(task_seen[i].name));
