+/*
+ * For other drivers of this kernel (bsd/dev/mi8_rproc.c: the remote processors' firmware is in the phone's own Android
+ * partitions "modem" and "dsp"): bytes of a partition by its name, any offset and length, read only, from the moment the
+ * list is up. 0 when read; ENXIO when there is no such partition or the list is not up yet.
+ */
+int
+redwood_ufs_read_named(const char *name, uint64_t offset, void *dst, uint64_t len)
+{
+	uint32_t part;
+
+	if (!ufs_ready || ufs_dead || (part = ufs_entry(name)) >= BLOCK_MAX_PARTS || (ufs_page->part[part].flags & BLOCK_PART_UNIT)) {
+		return ENXIO;
+	}
+	if (offset + len > (uint64_t)ufs_page->part[part].block_size * ufs_page->part[part].blocks) {
+		return EINVAL;
+	}
+	return ufs_read(part, offset, dst, len);
+}
