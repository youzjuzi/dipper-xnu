+extern "C" void
+MiniIOFlipQuiesce(void)
+{
+	if (gFlipPipe != NULL && gFlipCtl != NULL && gFlipBoot != 0) {
+		if (gNativeChanged) {
+			quiesceSay("fb_native: giving the registers back\n");
+			volatile uint32_t * scaler = gFlipPipe + 0xa00 / 4;
