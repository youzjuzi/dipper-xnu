+static int request(struct mi8_wlfw *w, const char *name, uint16_t id, size_t max,
+    const struct qmi_elem_info *req_ei, const void *req,
+    const struct qmi_elem_info *resp_ei, void *resp, bool allow_unsupported)
+{
+	struct qmi_txn txn;
+	struct sockaddr_qrtr sq = { .sq_family = AF_QIPCRTR };
+	struct qmi_response_type_v01 *result = resp;
+	bool print = log_n(++w->request_logs[id & 63]);
+	int r;
+	if (!current(w)) return -ENOTCONN;
+	result->result = 0xffff; result->error = 0xffff;
+	r = qmi_txn_init(&w->qmi, &txn, resp_ei, resp);
+	if (r < 0) return r;
+	LOCK(&w->lock);
+	sq.sq_node = w->node; sq.sq_port = w->port;
+	w->pending = true; w->pending_id = txn.id; w->pending_msg = id;
+	UNLOCK(&w->lock);
+	if (print) LOG(w, "%s tx id=0x%x txn=%u\n", name, id, txn.id);
+	r = qmi_send_request(&w->qmi, &sq, &txn, id, max, req_ei, req);
+	if (r < 0) qmi_txn_cancel(&txn);
+	else r = redwood_qmi_txn_wait_ms(&txn, w->timeout);
+	LOCK(&w->lock); w->pending = false; UNLOCK(&w->lock);
+	if (print || r < 0 || result->result) LOG(w, "%s rx rc=%d result=%u error=%u\n", name, r, result->result, result->error);
+	if (!current(w)) return -ENOTCONN;
+	if (r < 0) return r;
+	if (result->result != QMI_RESULT_SUCCESS_V01 &&
+	    !(allow_unsupported && result->result == QMI_RESULT_FAILURE_V01 && result->error == QMI_ERR_NOT_SUPPORTED_V01))
+		return -EIO;
+	if (print) LOG(w, "%s ok\n", name);
+	return 0;
+}
+#define REQ(w, lower, upper, req, resp, allow) request(w, #lower, QMI_WLFW_##upper##_REQ_V01, \
+	WLFW_##upper##_REQ_MSG_V01_MAX_MSG_LEN, mi8_wlfw_##lower##_req_msg_v01_ei, req, \
+	mi8_wlfw_##lower##_resp_msg_v01_ei, resp, allow)
+static int unassign(struct mi8_wlfw *w)
+{
+	int first = 0;
+	for (unsigned i = w->nr_regions; i > 0; i--) {
+		struct mi8_wlfw_memory_region_info_s_v01 *m = &w->regions[i - 1];
+		int r;
+		if (!w->assigned[i - 1]) continue;
+		r = norm(w->cfg.msa_assign(w->cfg.ctx, m->region_addr, m->size, m->secure_flag != 0, false));
