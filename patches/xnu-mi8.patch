+static unsigned
+pdm(struct mi8_hostsvc *h, unsigned msg, const struct tlv *t, struct builder *b)
+{
+	char service[65];
+	uint32_t offset = 0;
+	unsigned i, total = 0, count = 0, start;
+	if (msg == 0x24) {
+		if (!t[1].p || !text(t[1].p, t[1].n, service, sizeof(service)) || !t[2].p || t[2].n > 256) return Q_MALFORMED;
+		LOG(h, LOG_OTHER, "mi8hs: pdm PFR service=%s\n", service);
+		return Q_NONE;
+	}
+	if (msg != 0x21) return Q_UNSUPPORTED;
+	if (!t[1].p || !text(t[1].p, t[1].n, service, sizeof(service)) || (t[0x10].p && !has(t, 0x10, 4))) return Q_MALFORMED;
+	if (t[0x10].p) offset = (uint32_t)getle(t[0x10].p, 4);
+	for (i = 0; i < h->cfg.n_domains; i++) if (domain_matches(&h->cfg.domains[i], service)) total++;
+	add_number(b, 0x10, total, 2); add_number(b, 0x11, 1, 2);
+	start = b->n;
+	scalar(b, 0x12, 1); scalar(b, 0, 2); scalar(b, 0, 1);
+	total = 0;
+	for (i = 0; i < h->cfg.n_domains; i++) {
+		const struct mi8_pd_domain *d = &h->cfg.domains[i];
+		unsigned n;
+		if (!domain_matches(d, service)) continue;
+		if (total++ < offset || count == 32) continue;
+		n = (unsigned)strlen(d->name);
+		scalar(b, n, 1); append(b, d->name, n); scalar(b, d->instance, 4);
+		scalar(b, 0, 1); scalar(b, 0, 4); count++;
+	}
+	if (!b->failed) { setle(b->p + start + 1, b->n - start - 3, 2); b->p[start + 3] = (uint8_t)count; }
+	LOG(h, LOG_PDM, "mi8hs: pdm domain list service=%s -> %u domains\n", service, count);
+	return Q_NONE;
+}
