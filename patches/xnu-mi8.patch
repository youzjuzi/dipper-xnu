+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	/* the time since the kernel began, for the loader's log, which has none of its own (EXP-0221: where the minutes go) */
+	if (line[0] == 'm' && line[1] == 'i') {
+		uint64_t now = mach_absolute_time(), ns;
+		char stamp[24];
+
+		absolutetime_to_nanoseconds(now, &ns);
+		for (const char *c = stamp; c < stamp + snprintf(stamp, sizeof(stamp), "%llu.%03llu ", ns / NSEC_PER_SEC, ns / NSEC_PER_MSEC % 1000); c++) {
+			loader_log_putc(*c);
+		}
+	}
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	printf("%s", line);
+	return length;
+}
+
+/* ---- SMEM (as in redwood_adsp.c, with this phone's address) ----------------------------------------- */
+
+#define SMEM_PHYS               0x86000000UL
+#define SMEM_SIZE               0x00200000u
+#define SMEM_US                 0
+#define SMEM_MODEM              1               /* dt: qcom,remote-pid of qcom,smp2p-modem and qcom,glink-smem-native-xprt-modem */
+#define SMEM_ADSP               2
+#define SMEM_DSPS               3
+#define SMEM_CDSP               5
+#define SMEM_GLOBAL             0xfffe
+#define SMEM_CANARY             0xa5a5
+#define SMEM_VERSION_WORD       (0x40 + 4 * 7)  /* of the old header at the start: the boot loader's word, [31:16]; 12 = partitions */
+
+struct smem_table_entry {
+	uint32_t offset, size, flags;
+	uint16_t host0, host1;
+	uint32_t cacheline, reserved[7];
+};
+struct smem_table {
+	uint8_t magic[4];
+	uint32_t version, count, reserved[5];
+};
+struct smem_partition {
+	uint8_t magic[4];
+	uint16_t host0, host1;
+	uint32_t size, free_uncached, free_cached, reserved[3];
+};
+struct smem_entry {
+	uint16_t canary, item;
+	uint32_t size;
+	uint16_t padding_data, padding_header;
+	uint32_t reserved;
+};
+struct smem_item {
+	uint32_t item, offset, size;
+};
+
+/*
+ * Items worth looking for (Linux: SMP2P, GLINK, SMEM users; dt: qcom,smem of qcom,smp2p-*). The modem's SMP2P pair is
+ * <427 428> on the sdm845's dt of Android; Linux's sdm845.dtsi has <443 429> for every remote, each in its own partition.
+ * GLINK's descriptor and FIFO are items 478 and 479 of the partition of the two hosts.
+ */
+#define ITEM_SMP2P_THEIRS       443
+#define ITEM_SMP2P_OURS         429
+#define ITEM_SMP2P_THEIRS_ALT   435             /* the modem's: Linux sdm845.dtsi qcom,smem = <435>, <428> for mpss */
+#define ITEM_SMP2P_OURS_ALT     428
+#define ITEM_GLINK_DESCRIPTOR   478
+#define ITEM_GLINK_FIFO         479
+#define ITEM_CRASH_REASON       421             /* 421 + remote pid: the reason a remote processor gave when it died */
+
+static const volatile uint8_t *smem;
+
+static bool
+smem_peek(uint64_t offset, void *to, uint32_t size)
+{
+	if (smem == NULL) {
+		smem = (const volatile uint8_t *)ml_io_map_unmappable(SMEM_PHYS, SMEM_SIZE, VM_WIMG_WCOMB);
+	}
+	if (offset + size > SMEM_SIZE) {
+		return false;
+	}
+	for (uint32_t i = 0; i < size; i++) {
+		((uint8_t *)to)[i] = smem[offset + i];
+	}
+	return true;
+}
+
+static uint32_t
+smem_word(uint32_t offset)
+{
+	uint32_t value = 0;
+
+	smem_peek(offset, &value, sizeof(value));
+	return value;
+}
+
+static bool
+smem_table(struct smem_table *table)
+{
+	return smem_peek(SMEM_SIZE - 0x1000, table, sizeof(*table)) && memcmp(table->magic, "$TOC", 4) == 0 && table->version == 1 &&
+	       table->count <= 64;
+}
+
+/* The partition of two hosts: where it is (0: none), how big, and its cache line. */
+static uint32_t
+smem_partition(uint16_t one, uint16_t other, uint32_t *cacheline, uint32_t *size)
+{
+	struct smem_table table;
+	struct smem_table_entry entry;
+	struct smem_partition header;
+
+	if (!smem_table(&table)) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < table.count; i++) {
+		if (!smem_peek(SMEM_SIZE - 0x1000 + sizeof(table) + i * sizeof(entry), &entry, sizeof(entry)) || entry.offset == 0 ||
+		    entry.size == 0) {
+			continue;
+		}
+		if (!((entry.host0 == one && entry.host1 == other) || (entry.host0 == other && entry.host1 == one))) {
+			continue;
+		}
+		if ((uint64_t)entry.offset + entry.size > SMEM_SIZE - 0x1000 || !smem_peek(entry.offset, &header, sizeof(header)) ||
+		    memcmp(header.magic, "$PRT", 4) != 0 || header.size != entry.size) {
+			return 0;
+		}
+		*cacheline = entry.cacheline;
+		*size = entry.size;
+		return entry.offset;
+	}
+	return 0;
+}
+
+static unsigned
+smem_items(uint32_t partition, uint32_t cacheline, struct smem_item *found, unsigned max)
+{
+	struct smem_partition header;
+	struct smem_entry entry;
+	uint32_t at, step_back;
+	unsigned count = 0;
+
+	if (partition == 0 || !smem_peek(partition, &header, sizeof(header)) || header.free_uncached > header.size ||
+	    header.free_cached > header.size) {
+		return 0;
+	}
+	for (at = sizeof(header); at + sizeof(entry) <= header.free_uncached;) {
+		if (!smem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != SMEM_CANARY || entry.size > header.size) {
+			break;
+		}
+		if (count < max) {
+			found[count].item = entry.item;
+			found[count].offset = partition + at + sizeof(entry) + entry.padding_header;
+			found[count].size = entry.size - entry.padding_data;
+		}
+		count++;
+		at += sizeof(entry) + entry.padding_header + entry.size;
+	}
+	if (cacheline == 0 || (cacheline & (cacheline - 1))) {
+		return count;
+	}
+	step_back = ((uint32_t)sizeof(entry) + cacheline - 1) & ~(cacheline - 1);
+	for (at = header.size - step_back; at > header.free_cached && at < header.size;) {
+		if (!smem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != SMEM_CANARY || entry.size > at) {
+			break;
+		}
+		if (count < max) {
+			found[count].item = entry.item;
+			found[count].offset = partition + at - entry.size;
+			found[count].size = entry.size - entry.padding_data;
+		}
+		count++;
+		if (entry.size + step_back > at) {
+			break;
+		}
+		at -= entry.size + step_back;
+	}
+	return count;
+}
+
+#define MAX_ITEMS 192
+
+static struct smem_item found[MAX_ITEMS];
+
+static const char *
+host_name(uint16_t host)
+{
+	switch (host) {
+	case 0: return "apps";
+	case 1: return "modem";
+	case 2: return "adsp";
+	case 3: return "dsps";
+	case 4: return "wcnss";
+	case 5: return "cdsp";
+	case SMEM_GLOBAL: return "global";
+	default: return "?";
+	}
+}
+
+static const struct smem_item *
+find_item(unsigned count, uint32_t item)
+{
+	for (unsigned i = 0; i < count && i < MAX_ITEMS; i++) {
+		if (found[i].item == item) {
+			return &found[i];
+		}
+	}
+	return NULL;
+}
+
+/* A SMP2P item (redwood_adsp.c: struct smp2p): its header and the named 32-bit entries. */
+static void
+show_smp2p(const char *who, uint32_t offset, uint32_t size)
+{
+	uint32_t magic = smem_word(offset), version = smem_word(offset + 4), pids = smem_word(offset + 8);
+	uint32_t counts = smem_word(offset + 12), flags = smem_word(offset + 16);
+	char line[320];
+	int at = 0;
+
+	say("mi8rp: 1:   smp2p %s at %#lx (%u bytes): magic %#x version %u pids %#x counts %#x flags %#x\n", who, SMEM_PHYS + offset, size,
+	    magic, version, pids, counts, flags);
+	if (magic != 0x504d5324) {
+		return;
+	}
+	for (uint32_t i = 0; i < (counts >> 16) && i < 16; i++) {
+		uint8_t name[17];
+
+		smem_peek(offset + 20 + 20 * i, name, 16);
+		name[16] = 0;
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %s=%#x", name, smem_word(offset + 36 + 20 * i));
+	}
+	say("mi8rp: 1:     entries:%s\n", line);
+}
+
+static void
+survey_partition(uint16_t other)
+{
+	struct smem_partition header;
+	uint32_t cacheline = 0, size = 0, partition = other == SMEM_GLOBAL ? smem_partition(SMEM_GLOBAL, SMEM_GLOBAL, &cacheline, &size) :
+	    smem_partition(SMEM_US, other, &cacheline, &size);
+	unsigned count;
+	char line[320];
+
+	if (partition == 0 || !smem_peek(partition, &header, sizeof(header))) {
+		say("mi8rp: 1: partition %s: none\n", host_name(other));
+		return;
+	}
+	count = smem_items(partition, cacheline, found, MAX_ITEMS);
+	say("mi8rp: 1: partition %s: at %#lx, %#x bytes, cacheline %u, free %#x, %u items\n", host_name(other),
+	    SMEM_PHYS + partition, size, cacheline, header.free_cached - header.free_uncached, count);
+	for (unsigned i = 0; i < count && i < MAX_ITEMS;) {
+		int at = 0;
+
+		for (unsigned n = 0; n < 12 && i < count && i < MAX_ITEMS; n++, i++) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %u(%u)", found[i].item, found[i].size);
+		}
+		say("mi8rp: 1:   items(bytes):%s\n", line);
+	}
+	if (other != SMEM_GLOBAL) {
+		const struct smem_item *item;
+
+		if ((item = find_item(count, ITEM_SMP2P_THEIRS)) != NULL) {
+			show_smp2p("theirs (443)", item->offset, item->size);
+		}
+		if ((item = find_item(count, ITEM_SMP2P_OURS)) != NULL) {
+			show_smp2p("ours (429)", item->offset, item->size);
+		}
+		if ((item = find_item(count, ITEM_SMP2P_THEIRS_ALT)) != NULL) {
+			show_smp2p("theirs (435)", item->offset, item->size);
+		}
+		if ((item = find_item(count, ITEM_SMP2P_OURS_ALT)) != NULL) {
+			show_smp2p("ours (428)", item->offset, item->size);
+		}
+		say("mi8rp: 1:   glink descriptor (478): %s, fifo (479): %s\n", find_item(count, ITEM_GLINK_DESCRIPTOR) ? "there" : "none",
+		    find_item(count, ITEM_GLINK_FIFO) ? "there" : "none");
+	}
+}
+
+/* Step 1: read everything, write nothing. */
+static void
+step_survey(void)
+{
+	struct smem_table table;
+	struct smem_table_entry entry;
+
+	say("mi8rp: step 1: reads SMEM (%#lx, %#x bytes)\n", SMEM_PHYS, SMEM_SIZE);
+	say("mi8rp: 1: old header: word 0 %#x, version word (at %#x) %#x (partitions when [31:16] is 12)\n", smem_word(0), SMEM_VERSION_WORD,
+	    smem_word(SMEM_VERSION_WORD));
+	if (!smem_table(&table)) {
+		struct smem_table raw;
+
+		smem_peek(SMEM_SIZE - 0x1000, &raw, sizeof(raw));
+		say("mi8rp: 1: no table of contents at the end ('%c%c%c%c', version %u, %u entries): stops\n", raw.magic[0], raw.magic[1],
+		    raw.magic[2], raw.magic[3], raw.version, raw.count);
+		return;
+	}
+	say("mi8rp: 1: table of contents: %u partitions\n", table.count);
+	for (uint32_t i = 0; i < table.count; i++) {
+		if (smem_peek(SMEM_SIZE - 0x1000 + sizeof(table) + i * sizeof(entry), &entry, sizeof(entry))) {
+			say("mi8rp: 1:   [%u] %s <-> %s at %#x, size %#x, flags %#x, cacheline %u\n", i, host_name(entry.host0),
+			    host_name(entry.host1), entry.offset, entry.size, entry.flags, entry.cacheline);
+		}
+	}
+	survey_partition(SMEM_GLOBAL);
+	survey_partition(SMEM_MODEM);
+	survey_partition(SMEM_ADSP);
+	survey_partition(SMEM_DSPS);
+	survey_partition(SMEM_CDSP);
+	say("mi8rp: step 1 done: nothing was written\n");
+}
+
+
+/* ---- step 2, 3: the lock for SMEM ----------------------------------------------------------------- */
+
+static uint32_t pause_ms = 1500;        /* mi8rp_pause: what the loader needs to note the last line before a first touch */
+
+static void
+announce(uint32_t step, const char *what)
+{
+	say("mi8rp: step %u: %s\n", step, what);
+	if (pause_ms) {
+		delay_for_interval(pause_ms, NSEC_PER_MSEC);
+	}
+}
+
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static void __attribute__((noinline))
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (value), "r" (address) : "memory");
+}
+
+static void
+settle(void)
+{
+	__asm__ volatile ("dsb sy");
+}
+
+#define MUTEX_PHYS              0x01f40000ul    /* dt: qcom,ipc-spinlock-sfpb@1f40000, 8 locks (Linux: syscon, stride 0x1000) */
+#define MUTEX_SIZE              0x8000u
+#define MUTEX_SMEM              3               /* Linux sdm845.dtsi: smem hwlocks = <&tcsr_mutex 3> */
+#define MUTEX_STRIDE            0x1000u
+#define LOCK_US                 1u              /* the application processor's number (qcom_hwspinlock.c) */
+
+static vm_offset_t mutex_base;
+
+static vm_offset_t
+mutex_map(void)
+{
+	if (mutex_base == 0) {
+		mutex_base = ml_io_map(MUTEX_PHYS, MUTEX_SIZE);
+	}
+	return mutex_base;
+}
+
+static void
+step_lock_read(void)
+{
+	char line[200];
+	int at = 0;
+
+	announce(2, "reads the 8 locks of the SoC's mutex block (0x1f40000..0x1f48000), one word each");
+	for (uint32_t i = 0; i < 8; i++) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %u:%u", i, rd(mutex_map() + i * MUTEX_STRIDE));
+	}
+	say("mi8rp: 2: owners (0 = free):%s\n", line);
+}
+
+/* Takes SMEM's lock (for a second at most), as Linux does: write our number until it reads back. */
+static bool
+lock_take(void)
+{
+	vm_offset_t lock = mutex_map() + MUTEX_SMEM * MUTEX_STRIDE;
+	uint32_t owner = ~0u;
+
+	for (uint32_t ms = 0; ms <= 1000; ms++) {
+		wr(lock, LOCK_US);
+		owner = rd(lock);
+		if (owner == LOCK_US) {
+			return true;
+		}
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	say("mi8rp: SMEM's lock is held by processor %u for a second: nothing is written\n", owner);
+	return false;
+}
+
+static void
+lock_give(void)
+{
+	wr(mutex_map() + MUTEX_SMEM * MUTEX_STRIDE, 0);
+}
+
+static void
+step_lock_try(void)
+{
+	bool took;
+
+	announce(3, "takes SMEM's lock (write 1 at 0x1f43000, reads back 1 when ours) and gives it back (write 0)");
+	took = lock_take();
+	lock_give();
+	say("mi8rp: 3: lock %s; after giving it back it reads %u\n", took ? "taken" : "NOT taken", rd(mutex_map() + MUTEX_SMEM * MUTEX_STRIDE));
+}
+
+/* ---- step 4: our SMP2P items ------------------------------------------------------------------------ */
+
+struct smp2p {
+	uint32_t magic;
+	uint32_t version;
+	uint16_t local, remote, total, valid;
+	uint32_t flags;
+	struct {
+		char name[16];
+		uint32_t value;
+	} entry[16];
+};
+#define SMP2P_MAGIC             0x504d5324
+#define SMP2P_VERSION           1
+#define SMP2P_RESTART_ACKS      1u
+#define SMP2P_AT_VERSION        4
+#define SMP2P_AT_PROCESSORS     8
+#define SMP2P_AT_COUNTS         12
+#define SMP2P_AT_NAME(i)        (20 + 20 * (i))
+
+static void
+smem_poke(uint32_t offset, uint32_t value)
+{
+	wr((vm_offset_t)smem + offset, value);
+}
+
+/* Where an item is in a partition (0: not there). */
+static uint32_t
+item_find(uint32_t partition, uint32_t cacheline, uint32_t item, uint32_t *size)
+{
+	unsigned count = smem_items(partition, cacheline, found, MAX_ITEMS);
+	const struct smem_item *it = find_item(count, item);
+
+	if (it == NULL) {
+		return 0;
+	}
+	*size = it->size;
+	return it->offset;
+}
+
+/* Linux's qcom_smem_alloc_private() for an item at the bottom of the partition; the lock is ours when this is called. */
+static bool
+item_make_locked(uint32_t partition, uint32_t item, uint32_t item_size)
+{
+	struct smem_partition header;
+	struct smem_entry entry;
+	const uint32_t need = sizeof(entry) + item_size;
+	uint32_t at;
+
+	if (!smem_peek(partition, &header, sizeof(header)) || header.free_uncached > header.free_cached || header.free_cached > header.size) {
+		say("mi8rp: the partition's marks make no sense: nothing is written\n");
+		return false;
+	}
+	for (at = sizeof(header); at < header.free_uncached;) {
+		if (!smem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != SMEM_CANARY || entry.item == item || entry.size > header.size) {
+			break;
+		}
+		at += sizeof(entry) + entry.padding_header + entry.size;
+	}
+	if (at != header.free_uncached) {
+		say("mi8rp: the partition's entries do not end at its mark (+%#x, the mark is +%#x), or item %u has appeared: nothing is written\n", at,
+		    header.free_uncached, item);
+		return false;
+	}
+	if (at + need > header.free_cached) {
+		say("mi8rp: no room for item %u: %u wanted, %u free: nothing is written\n", item, need, header.free_cached - at);
+		return false;
+	}
+	/* the entry first, whole; only then the mark, in one store: nobody sees half of either */
+	smem_poke(partition + at, SMEM_CANARY | item << 16);
+	smem_poke(partition + at + 4, item_size);
+	smem_poke(partition + at + 8, 0);               /* no padding either side: item_size is a multiple of 8 */
+	smem_poke(partition + at + 12, 0);
+	settle();
+	smem_poke(partition + __offsetof(struct smem_partition, free_uncached), at + need);
+	settle();
+	return true;
+}
+
+static void
+smp2p_fill(uint32_t at, uint16_t remote, const char *const *names, unsigned count)
+{
+	for (uint32_t off = 0; off < sizeof(struct smp2p); off += 4) {
+		smem_poke(at + off, 0);
+	}
+	settle();
+	smem_poke(at, SMP2P_MAGIC);
+	smem_poke(at + SMP2P_AT_PROCESSORS, SMEM_US | (uint32_t)remote << 16);
+	for (unsigned i = 0; i < count; i++) {
+		uint32_t name[4] = { 0 };
+
+		strlcpy((char *)name, names[i], sizeof(name));
+		for (uint32_t w = 0; w < 4; w++) {
+			smem_poke(at + SMP2P_AT_NAME(i) + 4 * w, name[w]);
+		}
+	}
+	smem_poke(at + SMP2P_AT_COUNTS, 16 | count << 16);
+	smem_poke(at + SMP2P_AT_VERSION, SMP2P_RESTART_ACKS << 8);
+	settle();
+	smem_poke(at + SMP2P_AT_VERSION, SMP2P_RESTART_ACKS << 8 | SMP2P_VERSION);     /* last: makes it valid */
+	settle();
+}
+
+static void
+make_our_item(uint16_t remote, uint32_t item, const char *const *names, unsigned count)
+{
+	uint32_t cacheline = 0, size = 0, partition = smem_partition(SMEM_US, remote, &cacheline, &size), at, item_size = 0;
+	const uint32_t want = (sizeof(struct smp2p) + 7) & ~7u;
+
+	if (partition == 0) {
+		say("mi8rp: 4: no partition with %s\n", host_name(remote));
+		return;
+	}
+	at = item_find(partition, cacheline, item, &item_size);
+	if (at != 0) {
+		say("mi8rp: 4: item %u is already there with %s at %#lx (%u bytes): left alone\n", item, host_name(remote), SMEM_PHYS + at, item_size);
+		return;
+	}
+	if (!lock_take()) {
+		return;
+	}
+	if (item_make_locked(partition, item, want)) {
+		lock_give();
+		at = item_find(partition, cacheline, item, &item_size);
+		if (at == 0) {
+			say("mi8rp: 4: ITEM %u IS NOT FOUND where it was just made\n", item);
+			return;
+		}
+		smp2p_fill(at, remote, names, count);
+		say("mi8rp: 4: item %u made with %s at %#lx (%u bytes) and filled in (%u entries, valid)\n", item, host_name(remote), SMEM_PHYS + at,
+		    item_size, count);
+		show_smp2p("ours, as written", at, item_size);
+	} else {
+		lock_give();
+	}
+}
+
+static void
+step_our_items(void)
+{
+	static const char *const modem[] = { "master-kernel", "ipa-ap-to-modem" };
+	static const char *const adsp[] = { "master-kernel" };
+
+	announce(4, "makes our SMP2P items in SMEM, with the modem (428) and with the audio DSP (429): RAM only, no doorbell");
+	make_our_item(SMEM_MODEM, ITEM_SMP2P_OURS_ALT, modem, 2);
+	make_our_item(SMEM_ADSP, ITEM_SMP2P_OURS, adsp, 1);
+	say("mi8rp: step 4 done\n");
+}
+
+
+/* ---- the firmware: the phone's "modem" partition, FAT16 with 4096-byte sectors (EXP-0188) ---------------------------- */
+
+extern int redwood_ufs_read_named(const char *name, uint64_t offset, void *dst, uint64_t len);
+
+static struct {
+	bool ok;
+	uint32_t spc, cluster_bytes, root_bytes, clusters;
+	uint64_t fat_off, root_off, data_off;
+	uint16_t *fat;
+	uint32_t fat_bytes;
+} fs;
+
+struct fs_file {
+	uint32_t first, size;
+	bool dir;
+};
+
+static int
+fs_read(uint64_t offset, void *dst, uint64_t len)
+{
+	return redwood_ufs_read_named("modem", offset, dst, len);
+}
+
+static bool
+fs_mount(void)
+{
+	uint8_t *boot;
+	uint32_t bps, reserved, nfats, root_entries, total, fatsz;
+	int error;
+
+	if (fs.ok) {
+		return true;
+	}
+	boot = kalloc_data(4096, Z_WAITOK | Z_ZERO);
+	if (boot == NULL) {
+		return false;
+	}
+	if ((error = fs_read(0, boot, 4096)) != 0) {
+		say("mi8rp: fs: the first block of 'modem' is not read (%d)\n", error);
+		kfree_data(boot, 4096);
+		return false;
+	}
+	bps = boot[11] | boot[12] << 8;
+	fs.spc = boot[13];
+	reserved = boot[14] | boot[15] << 8;
+	nfats = boot[16];
+	root_entries = boot[17] | boot[18] << 8;
+	total = boot[19] | boot[20] << 8;
+	if (total == 0) {
+		total = boot[32] | boot[33] << 8 | boot[34] << 16 | (uint32_t)boot[35] << 24;
+	}
+	fatsz = boot[22] | boot[23] << 8;
+	say("mi8rp: fs: 'modem': %u bytes a sector, %u sectors a cluster, %u reserved, %u FATs of %u sectors, %u root entries, %u sectors; "
+	    "type '%.8s'\n", bps, fs.spc, reserved, nfats, fatsz, root_entries, total, (const char *)boot + 54);
+	kfree_data(boot, 4096);
+	if (bps != 4096 || fs.spc == 0 || (fs.spc & (fs.spc - 1)) || nfats == 0 || fatsz == 0 || root_entries == 0 || total == 0) {
+		say("mi8rp: fs: not the FAT16 this reader knows\n");
+		return false;
+	}
+	fs.cluster_bytes = bps * fs.spc;
+	fs.fat_off = (uint64_t)reserved * bps;
+	fs.fat_bytes = fatsz * bps;
+	fs.root_off = fs.fat_off + (uint64_t)nfats * fs.fat_bytes;
+	fs.root_bytes = root_entries * 32;
+	fs.root_bytes = (fs.root_bytes + bps - 1) / bps * bps;
+	fs.data_off = fs.root_off + fs.root_bytes;
+	fs.clusters = (total - (uint32_t)(fs.data_off / bps)) / fs.spc;
+	if (fs.clusters < 4085 || fs.clusters >= 65525) {
+		say("mi8rp: fs: %u clusters: not FAT16\n", fs.clusters);
+		return false;
+	}
+	fs.fat = kalloc_data(fs.fat_bytes, Z_WAITOK);
+	if (fs.fat == NULL || fs_read(fs.fat_off, fs.fat, fs.fat_bytes) != 0) {
+		say("mi8rp: fs: the FAT is not read\n");
+		return false;
+	}
+	fs.ok = true;
+	return true;
+}
+
+static uint32_t
+fs_next(uint32_t cluster)
+{
+	uint32_t next = cluster < fs.fat_bytes / 2 ? fs.fat[cluster] : 0xffff;
+
+	return next >= 2 && next < fs.clusters + 2 ? next : 0;
+}
+
+static uint64_t
+fs_cluster_off(uint32_t cluster)
+{
+	return fs.data_off + (uint64_t)(cluster - 2) * fs.cluster_bytes;
+}
+
+static void
+fs_name83(const char *name, uint8_t out[11])
+{
+	unsigned n = 0;
+
+	memset(out, ' ', 11);
+	for (; *name != 0 && *name != '.' && n < 8; name++, n++) {
+		out[n] = (*name >= 'a' && *name <= 'z') ? (uint8_t)(*name - 32) : (uint8_t)*name;
+	}
+	while (*name != 0 && *name != '.') {
+		name++;
+	}
+	if (*name == '.') {
+		name++;
+		for (n = 0; *name != 0 && n < 3; name++, n++) {
+			out[8 + n] = (*name >= 'a' && *name <= 'z') ? (uint8_t)(*name - 32) : (uint8_t)*name;
+		}
+	}
+}
+
+/* An entry of a directory (first cluster; 0 = the root) by its 8.3 name. Long-name entries are skipped. */
+static bool
+fs_dir_find(uint32_t dir, const char *name, struct fs_file *out, void (*each)(const uint8_t *entry))
+{
+	uint8_t want[11];
+	uint8_t *buf;
+	bool found = false;
+	uint32_t cluster = dir;
+	uint32_t bytes = dir ? fs.cluster_bytes : fs.root_bytes;
+
+	if (name != NULL) {
+		fs_name83(name, want);
+	}
+	buf = kalloc_data(bytes, Z_WAITOK);
+	if (buf == NULL) {
+		return false;
+	}
+	for (unsigned guard = 0; guard < 4096; guard++) {
+		bool end = false;
+
+		if (fs_read(dir ? fs_cluster_off(cluster) : fs.root_off, buf, bytes) != 0) {
+			break;
+		}
+		for (uint32_t at = 0; at + 32 <= bytes; at += 32) {
+			const uint8_t *e = buf + at;
+
+			if (e[0] == 0) {
+				end = true;
+				break;
+			}
+			if (e[0] == 0xe5 || e[11] == 0x0f || (e[11] & 0x08)) {
+				continue;
+			}
+			if (each != NULL) {
+				each(e);
+			}
+			if (name != NULL && memcmp(e, want, 11) == 0) {
+				out->first = e[26] | e[27] << 8;
+				out->size = e[28] | e[29] << 8 | e[30] << 16 | (uint32_t)e[31] << 24;
+				out->dir = (e[11] & 0x10) != 0;
+				found = true;
+				end = true;
+				break;
+			}
+		}
+		if (end || !dir || (cluster = fs_next(cluster)) == 0) {
+			break;
+		}
+	}
+	kfree_data(buf, bytes);
+	return found;
+}
+
+/* "image/adsp.mdt" and the like: directories of one level are all there is on this partition's use. */
+static bool
+fs_lookup(const char *path, struct fs_file *out)
+{
+	char part[16];
+	uint32_t dir = 0;
+
+	if (!fs_mount()) {
+		return false;
+	}
+	for (;;) {
+		const char *slash = strchr(path, '/');
+		size_t n = slash ? (size_t)(slash - path) : strlen(path);
+		struct fs_file f;
+
+		if (n == 0 || n >= sizeof(part)) {
+			return false;
+		}
+		memcpy(part, path, n);
+		part[n] = 0;
+		if (!fs_dir_find(dir, part, &f, NULL)) {
+			return false;
+		}
+		if (!slash) {
+			*out = f;
+			return true;
+		}
+		if (!f.dir) {
+			return false;
+		}
+		dir = f.first;
+		path = slash + 1;
+	}
+}
+
+/* Bytes [offset, offset + len) of a file, following the chain in as few reads as there are runs of clusters. */
+static int
+fs_file_read(const struct fs_file *f, uint64_t offset, void *dst, uint64_t len)
+{
+	uint8_t *out = dst;
+	uint32_t cluster = f->first, skip = (uint32_t)(offset / fs.cluster_bytes);
+
+	if (offset + len > f->size) {
+		return EINVAL;
+	}
+	while (skip-- > 0 && cluster != 0) {
+		cluster = fs_next(cluster);
+	}
+	offset %= fs.cluster_bytes;
+	while (len > 0) {
+		uint32_t run = 1, last, take;
+		int error;
+
+		if (cluster == 0) {
+			return EIO;
+		}
+		last = cluster;
+		while ((uint64_t)run * fs.cluster_bytes - offset < len && fs_next(last) == last + 1 && run < 256) {
+			last++;
+			run++;
+		}
+		take = (uint32_t)MIN((uint64_t)run * fs.cluster_bytes - offset, len);
+		if ((error = fs_read(fs_cluster_off(cluster) + offset, out, take)) != 0) {
+			return error;
+		}
+		out += take;
+		len -= take;
+		offset = 0;
+		cluster = fs_next(last);
+	}
+	return 0;
+}
+
+/* The whole of a small file in memory of ours (to be given back with kfree_data(data, *size)). */
+static uint8_t *
+fs_slurp(const char *path, uint32_t *size)
+{
+	struct fs_file f;
+	uint8_t *data;
+
+	if (!fs_lookup(path, &f) || f.dir || f.size == 0 || f.size > (8u << 20)) {
+		return NULL;
+	}
+	data = kalloc_data(f.size, Z_WAITOK);
+	if (data == NULL) {
+		return NULL;
+	}
+	if (fs_file_read(&f, 0, data, f.size) != 0) {
+		kfree_data(data, f.size);
+		return NULL;
+	}
+	*size = f.size;
+	return data;
+}
+
+static uint32_t
+fnv(const uint8_t *data, uint32_t size)
+{
+	uint32_t h = 2166136261u;
+
+	for (uint32_t i = 0; i < size; i++) {
+		h = (h ^ data[i]) * 16777619u;
+	}
+	return h;
+}
+
+struct elf_phdr {
+	uint32_t type, offset, vaddr, paddr, file_size, memory_size, flags, align;
+};
+#define MDT_HASH(flags) (((flags) >> 24 & 7) == 2)
+
+/* A Qualcomm split image's header file (ELF32 with its hash segment): list it and check each segment file's size. */
+static void
+check_image(const char *base, uint32_t region, uint32_t region_size)
+{
+	char path[40];
+	struct elf_phdr ph;
+	uint8_t *mdt;
+	uint32_t size = 0, count, loaded = 0, lowest = ~0u, highest = 0;
+	struct fs_file f;
+
+	snprintf(path, sizeof(path), "image/%s.mdt", base);
+	mdt = fs_slurp(path, &size);
+	if (mdt == NULL) {
+		say("mi8rp: 5: %s: not read\n", path);
+		return;
+	}
+	count = size >= 52 ? mdt[44] | mdt[45] << 8 : 0;
+	if (memcmp(mdt, "\177ELF\1", 5) != 0 || count < 2 || 52 + 32 * count > size) {
+		say("mi8rp: 5: %s: not an ELF32 header file (%u bytes)\n", path, size);
+		kfree_data(mdt, size);
+		return;
+	}
+	say("mi8rp: 5: %s: %u bytes (fnv %08x), %u program headers\n", path, size, fnv(mdt, size), count);
+	for (uint32_t i = 0; i < count; i++) {
+		bool hash, within;
+		uint64_t file_bytes = 0;
+
+		memcpy(&ph, mdt + 52 + 32 * i, sizeof(ph));
+		hash = MDT_HASH(ph.flags);
+		within = ph.paddr >= region && (uint64_t)ph.paddr + ph.memory_size <= (uint64_t)region + region_size;
+		if (ph.type == 1 && !hash && ph.memory_size != 0) {
+			loaded++;
+			lowest = ph.paddr < lowest ? ph.paddr : lowest;
+			highest = ph.paddr + ph.memory_size > highest ? ph.paddr + ph.memory_size : highest;
+		}
+		if (ph.file_size != 0) {
+			snprintf(path, sizeof(path), "image/%s.b%02u", base, i);
+			if (fs_lookup(path, &f)) {
+				file_bytes = f.size;
+			}
+		}
+		if (i < 6 || ph.file_size != file_bytes || (ph.type == 1 && !hash && ph.memory_size != 0 && !within)) {
+			say("mi8rp: 5:   [%u] type %u paddr %#x file %#x mem %#x flags %#x%s; b%02u has %llu bytes%s%s\n", i, ph.type, ph.paddr,
+			    ph.file_size, ph.memory_size, ph.flags, hash ? " (hashes)" : "", i, file_bytes, ph.file_size == file_bytes ? "" : " (WRONG)",
+			    ph.type == 1 && !hash && ph.memory_size != 0 && !within ? " (OUTSIDE the reserved region)" : "");
+		}
+	}
+	say("mi8rp: 5: %s: %u segments to load, %#x..%#x (%u MB) of the region %#x..%#x\n", base, loaded, lowest, highest,
+	    (highest - lowest + 0xfffff) >> 20, region, region + region_size);
+	kfree_data(mdt, size);
+}
+
+static void
+list_image_entry(const uint8_t *e)
+{
+	static unsigned shown;
+	uint32_t size = e[28] | e[29] << 8 | e[30] << 16 | (uint32_t)e[31] << 24;
+	char name[16];
+	unsigned n = 0;
+
+	for (unsigned i = 0; i < 8 && e[i] != ' '; i++) {
+		name[n++] = (char)e[i];
+	}
+	if (e[8] != ' ') {
+		name[n++] = '.';
+		for (unsigned i = 8; i < 11 && e[i] != ' '; i++) {
+			name[n++] = (char)e[i];
+		}
+	}
+	name[n] = 0;
+	if (strncmp(name, "ADSP.B", 6) == 0 || strncmp(name, "MODEM.B", 7) == 0 || strncmp(name, "CDSP", 4) == 0 || strncmp(name, "SLPI", 4) == 0) {
+		return;
+	}
+	if (shown++ < 80 && (strnstr(name, "MBA", 16) || strnstr(name, "WLAN", 16) || strnstr(name, "BDWLAN", 16) || strnstr(name, "BDF", 16) || strnstr(name, "MDT", 16) ||
+	    strnstr(name, "QDSP", 16) || strnstr(name, "DATA", 16) || strnstr(name, "JSN", 16))) {
+		say("mi8rp: 5:   image/%s (%u bytes)%s\n", name, size, (e[11] & 0x10) ? " [dir]" : "");
+	}
+}
+
+static void
+step_firmware(void)
+{
+	struct fs_file image_dir, f;
+	static const char *const wanted[] = { "image/mba.mbn", "image/wlanmdsp.mbn", "image/bdwlan.102", "image/bdwlan.104", "image/qdsp6m.qdb" };
+
+	say("mi8rp: step 5: reads the firmware in the 'modem' partition (read only)\n");
+	if (!fs_mount() || !fs_lookup("image", &image_dir) || !image_dir.dir) {
+		say("mi8rp: 5: no image/ directory: stops\n");
+		return;
+	}
+	fs_dir_find(image_dir.first, NULL, NULL, list_image_entry);
+	for (unsigned i = 0; i < sizeof(wanted) / sizeof(wanted[0]); i++) {
+		if (fs_lookup(wanted[i], &f)) {
+			uint8_t *head = kalloc_data(64, Z_WAITOK | Z_ZERO);
+
+			if (head && fs_file_read(&f, 0, head, MIN(f.size, 64u)) == 0) {
+				say("mi8rp: 5: %s: %u bytes, first cluster %u, starts %02x %02x %02x %02x\n", wanted[i], f.size, f.first, head[0],
+				    head[1], head[2], head[3]);
+			}
+			if (head) {
+				kfree_data(head, 64);
+			}
+		} else {
+			say("mi8rp: 5: %s: NOT FOUND\n", wanted[i]);
+		}
+	}
+	check_image("adsp", 0x8c500000u, 0x01e00000u);           /* dt: reserved-memory adsp_region@0x8c500000 */
+	check_image("modem", 0x8e400000u, 0x07800000u);          /* dt: modem_region@0x8e400000 */
+	say("mi8rp: step 5 done: nothing was written\n");
+}
+
+
+/* ---- step 6: the always-on processor's mailbox, and RPMh's levels ------------------------------------ */
+
+#define APCS_PHYS               0x17990000ul    /* dt: irq-reg-base 0x1799000c of every remote (Linux sdm845: apcs offset 12) */
+#define APCS_IPC                0x0c
+#define IPC_AOP                 (1u << 0)       /* dt: qcom,qmp-aop qcom,irq-mask */
+#define IPC_SMP2P_ADSP          (1u << 10)      /* dt: qcom,smp2p-adsp qcom,irq-bitmask 0x400 */
+#define IPC_SMP2P_MODEM         (1u << 14)
+#define IPC_GLINK_MODEM         (1u << 12)
+#define AOSS_PHYS               0x0c300000ul
+#define AOSS_SIZE               0x400u
+#define QMP_MAGIC               0x00
+#define QMP_MAGIC_VALUE         0x4d41494c
+#define QMP_VERSION             0x04
+#define QMP_THEIR_LINK          0x0c
+#define QMP_THEIR_LINK_ACK      0x10
+#define QMP_THEIR_CHANNEL       0x14
+#define QMP_THEIR_CHANNEL_ACK   0x18
+#define QMP_OUR_LINK            0x24
+#define QMP_OUR_LINK_ACK        0x28
+#define QMP_OUR_CHANNEL         0x2c
+#define QMP_OUR_CHANNEL_ACK     0x30
+#define QMP_OUR_BOX_SIZE        0x34
+#define QMP_OUR_BOX             0x38
+#define QMP_UP                  0x0000ffffu
+#define QMP_DOWN                0xffff0000u
+#define QMP_MESSAGE             64
+
+static vm_offset_t apcs_base, aoss_base;
+static uint32_t our_box;
+
+static void
+ring(uint32_t mask)
+{
+	if (apcs_base == 0) {
+		apcs_base = ml_io_map(APCS_PHYS, 0x1000);
+	}
+	settle();
+	wr(apcs_base + APCS_IPC, mask);
+}
+
+static bool
+qmp_wait(uint32_t offset, uint32_t value, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 10; i++) {
+		if (rd(aoss_base + offset) == value) {
+			return true;
+		}
+		delay_for_interval(100, NSEC_PER_USEC);
+	}
+	return rd(aoss_base + offset) == value;
+}
+
+/* Linux's qmp_open(): link, channel, acknowledgements; what is open already is found open. */
+static bool
+qmp_open(void)
+{
+	uint32_t box, size;
+
+	if (aoss_base == 0) {
+		aoss_base = ml_io_map(AOSS_PHYS, AOSS_SIZE);
+	}
+	if (our_box != 0) {
+		return true;
+	}
+	if (rd(aoss_base + QMP_MAGIC) != QMP_MAGIC_VALUE || rd(aoss_base + QMP_VERSION) != 1) {
+		say("mi8rp: qmp: not a mailbox this knows (magic %#x, version %u)\n", rd(aoss_base + QMP_MAGIC), rd(aoss_base + QMP_VERSION));
+		return false;
+	}
+	box = rd(aoss_base + QMP_OUR_BOX);
+	size = rd(aoss_base + QMP_OUR_BOX_SIZE);
+	say("mi8rp: qmp: our mailbox at +%#x, %u bytes; link %#x/%#x channel %#x/%#x (ours/their)\n", box, size, rd(aoss_base + QMP_OUR_LINK),
+	    rd(aoss_base + QMP_THEIR_LINK), rd(aoss_base + QMP_OUR_CHANNEL), rd(aoss_base + QMP_THEIR_CHANNEL));
+	if (size < QMP_MESSAGE + 4 || box < 0x3c || box + size > AOSS_SIZE || (box & 3)) {
+		say("mi8rp: qmp: our mailbox is not where a message fits\n");
+		return false;
+	}
+	if (rd(aoss_base + QMP_OUR_LINK) == QMP_UP && rd(aoss_base + QMP_OUR_LINK_ACK) == QMP_UP && rd(aoss_base + QMP_OUR_CHANNEL) == QMP_UP &&
+	    rd(aoss_base + QMP_THEIR_CHANNEL) == QMP_UP && rd(aoss_base + QMP_OUR_CHANNEL_ACK) == QMP_UP) {
+		say("mi8rp: qmp: the mailbox is open already\n");
+		our_box = box;
+		return true;
+	}
+	wr(aoss_base + QMP_THEIR_LINK_ACK, rd(aoss_base + QMP_THEIR_LINK));
+	wr(aoss_base + QMP_OUR_LINK, QMP_UP);
+	ring(IPC_AOP);
+	if (!qmp_wait(QMP_OUR_LINK_ACK, QMP_UP, 1000)) {
+		say("mi8rp: qmp: THE AOP DOES NOT ACKNOWLEDGE OUR LINK within a second; taken down again\n");
+		wr(aoss_base + QMP_OUR_LINK, QMP_DOWN);
+		ring(IPC_AOP);
+		return false;
+	}
+	wr(aoss_base + QMP_OUR_CHANNEL, QMP_UP);
+	ring(IPC_AOP);
+	if (!qmp_wait(QMP_THEIR_CHANNEL, QMP_UP, 1000)) {
+		say("mi8rp: qmp: THE AOP DOES NOT OPEN ITS CHANNEL within a second; ours is taken down again\n");
+		wr(aoss_base + QMP_OUR_CHANNEL, QMP_DOWN);
+		wr(aoss_base + QMP_OUR_LINK, QMP_DOWN);
+		ring(IPC_AOP);
+		return false;
+	}
+	wr(aoss_base + QMP_THEIR_CHANNEL_ACK, QMP_UP);
+	ring(IPC_AOP);
+	if (!qmp_wait(QMP_OUR_CHANNEL_ACK, QMP_UP, 1000)) {
+		say("mi8rp: qmp: THE AOP DOES NOT ACKNOWLEDGE OUR CHANNEL within a second; taken down again\n");
+		wr(aoss_base + QMP_OUR_CHANNEL, QMP_DOWN);
+		wr(aoss_base + QMP_OUR_LINK, QMP_DOWN);
+		ring(IPC_AOP);
+		return false;
+	}
+	say("mi8rp: qmp: THE MAILBOX TO THE AOP IS OPEN\n");
+	our_box = box;
+	return true;
+}
+
+/* Linux's qmp_send(). */
+static bool
+qmp_send(const char *text)
+{
+	uint32_t words[QMP_MESSAGE / 4] = { 0 };
+
+	if (!qmp_open()) {
+		return false;
+	}
+	strlcpy((char *)words, text, sizeof(words));
+	say("mi8rp: qmp: telling the AOP \"%s\"\n", text);
+	if (rd(aoss_base + our_box) != 0) {
+		say("mi8rp: qmp: our mailbox still holds a message of %u bytes: not sent\n", rd(aoss_base + our_box));
+		return false;
+	}
+	for (unsigned i = 0; i < QMP_MESSAGE / 4; i++) {
+		wr(aoss_base + our_box + 4 + 4 * i, words[i]);
+	}
+	wr(aoss_base + our_box, QMP_MESSAGE);
+	(void)rd(aoss_base + our_box);
+	ring(IPC_AOP);
+	if (!qmp_wait(our_box, 0, 1000)) {
+		say("mi8rp: qmp: THE AOP DOES NOT TAKE THE MESSAGE within a second; taken back\n");
+		wr(aoss_base + our_box, 0);
+		return false;
+	}
+	say("mi8rp: qmp: the AOP has taken it\n");
+	return true;
+}
+
+/* ---- RPMh: a rail's level, as Linux's rpmh-rsc.c asks for one (apps_rsc DRV 2; TCS 1: TCS 0 is mi8_ddr's) ---- */
+
+#define CMD_DB_PHYS             0x85fe0000UL    /* EXP-0067: where the boot loader left the command database on this phone */
+#define CMD_DB_SIZE             0x20000UL
+#define RSC_PHYS                0x179e0000ul    /* dt: mailbox@179e0000 apps_rsc, drv-id 2 */
+#define RSC_TCS_BASE            0xd00
+#define RSC_TCS(n)              (RSC_TCS_BASE + 672 * (n))
+#define RPMH_TCS                1
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+static vm_offset_t cmd_db_base, rsc_base;
+
+/* The position RPMh takes for rail `name` at the first of its levels that is at or above `level` (0: the lowest); -1: none. */
+static int
+rail_position(const char *name, uint32_t level, uint32_t *address, bool show)
+{
+	const struct cmd_db_header *db;
+	char id[8] = { 0 };
+
+	if (cmd_db_base == 0) {
+		cmd_db_base = ml_io_map(CMD_DB_PHYS, CMD_DB_SIZE);
+	}
+	db = (const struct cmd_db_header *)cmd_db_base;
+	if (!(db->magic[0] == 0xdb && db->magic[1] == 0x30 && db->magic[2] == 0x03 && db->magic[3] == 0x0c)) {
+		say("mi8rp: rpmh: no command database at %#lx\n", CMD_DB_PHYS);
+		return -1;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned sl = 0; sl < 8; sl++) {
+		const struct cmd_db_slave *slave = &db->slave[sl];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + slave->header_offset);
+
+		if (slave->id == 0 || slave->header_offset >= CMD_DB_SIZE - 0x1000 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			const uint8_t *data;
+			char levels[160];
+			int at;
+
+			if (memcmp(entry[i].id, id, sizeof(id)) != 0) {
+				continue;
+			}
+			if ((unsigned)slave->data_offset + entry[i].offset + entry[i].length > CMD_DB_SIZE - 0x1000) {
+				return -1;
+			}
+			data = db->data + slave->data_offset + entry[i].offset;
+			if (show) {
+				at = snprintf(levels, sizeof(levels), "%s at %#x, levels:", name, entry[i].address);
+				for (unsigned l = 0; l < entry[i].length / 2u && l < 16; l++) {
+					unsigned value = data[2 * l] | data[2 * l + 1] << 8;
+
+					if (l > 0 && value == 0) {
+						break;
+					}
+					at += snprintf(levels + at, sizeof(levels) - (size_t)at, " %u", value);
+				}
+				say("mi8rp: rpmh: %s\n", levels);
+			}
+			*address = entry[i].address;
+			if (level == 0) {
+				return 0;
+			}
+			if (level == 0xffffffffu) {             /* the top: the last level listed */
+				unsigned top = 0;
+
+				for (unsigned l = 0; l < entry[i].length / 2u && l < 16; l++) {
+					if (l > 0 && (data[2 * l] | data[2 * l + 1] << 8) == 0) {
+						break;
+					}
+					top = l;
+				}
+				return (int)top;
+			}
+			for (unsigned l = 0; l < entry[i].length / 2u && l < 16; l++) {
+				if ((uint32_t)(data[2 * l] | data[2 * l + 1] << 8) >= level) {
+					return (int)l;
+				}
+			}
+			return -1;
+		}
+	}
+	say("mi8rp: rpmh: no \"%s\"\n", name);
+	return -1;
+}
+
+/* One request, one rail, through TCS 1 and waited for; true: RPMh said done. */
+static bool
+rpmh_write(const char *what, uint32_t address, uint32_t data)
+{
+	vm_offset_t tcs;
+	uint32_t done = 0;
+
+	if (rsc_base == 0) {
+		rsc_base = ml_io_map(RSC_PHYS, 0x10000);
+	}
+	tcs = rsc_base + RSC_TCS(RPMH_TCS);
+	if (rd(tcs + 0x1c) != 0 || (rd(tcs + 0x14) & (1u << 24))) {
+		say("mi8rp: rpmh: TCS %u is in use (control %#x, enable %#x): not touched\n", RPMH_TCS, rd(tcs + 0x14), rd(tcs + 0x1c));
+		return false;
+	}
+	say("mi8rp: rpmh: asking, through TCS %u, for %s (%#x) = %u\n", RPMH_TCS, what, address, data);
+	wr(rsc_base + RSC_TCS_BASE + 0x08, 1u << RPMH_TCS);                    /* IRQ_CLEAR */
+	wr(tcs + 0x30, (1u << 16) | (1u << 8) | 8u);                            /* write, an answer wanted, four bytes + address */
+	wr(tcs + 0x34, address);
+	wr(tcs + 0x38, data);
+	wr(tcs + 0x10, 1);                                                      /* WAIT_FOR_DONE */
+	wr(tcs + 0x1c, 1);                                                      /* CMD_ENABLE */
+	settle();
+	wr(tcs + 0x14, rd(tcs + 0x14) & ~(1u << 24));
+	wr(tcs + 0x14, rd(tcs + 0x14) | (1u << 16));                            /* active mode */
+	wr(tcs + 0x14, rd(tcs + 0x14) | (1u << 24));                            /* trigger */
+	for (unsigned t = 0; t < 20000; t++) {
+		done = (rd(rsc_base + RSC_TCS_BASE + 0x04) & (1u << RPMH_TCS)) || (rd(tcs + 0x3c) & (1u << 16));     /* the IRQ bit, or the command's COMPL (EXP-0191) */
+		if (done) {
+			break;
+		}
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+	say("mi8rp: rpmh: %s; command status %#x\n", done ? "DONE" : "NOT SAID DONE", rd(tcs + 0x3c));
+	wr(rsc_base + RSC_TCS_BASE + 0x08, 1u << RPMH_TCS);
+	wr(tcs + 0x14, 0);
+	wr(tcs + 0x1c, 0);
+	settle();
+	return done != 0;
+}
+
+static bool
+rpmh_level(const char *name, uint32_t level)
+{
+	uint32_t address = 0;
+	int position = rail_position(name, level, &address, true);
+
+	if (position < 0 || address == 0) {
+		say("mi8rp: rpmh: no position for %s at level %u\n", name, level);
+		return false;
+	}
+	return rpmh_write(name, address, (uint32_t)position);
+}
+
+static bool
+rpmh_level_pos(const char *name, uint32_t level)
+{
+	return rpmh_level(name, level);
+}
+
+static void
+step_aop(void)
+{
+	uint32_t address = 0;
+
+	announce(6, "opens the AOP mailbox (QMP, 0xc300000; doorbell: APCS 0x1799000c bit 0), sends load_state on and off for 'adsp'");
+	rail_position("cx.lvl", 0, &address, true);
+	if (qmp_send("{class: image, res: load_state, name: adsp, val: on}")) {
+		qmp_send("{class: image, res: load_state, name: adsp, val: off}");
+	}
+	say("mi8rp: step 6 done\n");
+}
+
+/* ---- steps 7, 8: the audio DSP -------------------------------------------------------------------- */
+
+#define ADSP_MEMORY             0x8c500000u
+#define ADSP_MEMORY_SIZE        0x01e00000u
+#define PAS_ADSP                1
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(service, command) ((uint64_t)(service) << 8 | (command))
+#define SCM_PAS_INIT_IMAGE      SCM_CALL(2, 1)
+#define SCM_PAS_MEM_SETUP       SCM_CALL(2, 2)
+#define SCM_PAS_AUTH_AND_RESET  SCM_CALL(2, 5)
+#define SCM_PAS_SHUTDOWN        SCM_CALL(2, 6)
+#define SCM_ONE_VALUE           1
+#define SCM_THREE_VALUES        3
+#define SCM_VALUE_AND_BUFFER    (2 | 2 << 6)
+
+static int32_t
+scm(const char *what, uint64_t function, uint64_t arguments, uint64_t first, uint64_t second, uint64_t third, uint64_t fourth, uint64_t *answer)
+{
+	uint64_t session = 0;
+
+	function |= SCM_64 | SCM_SIP;
+	say("mi8rp: asking TrustZone %s: smc %#llx, arguments %#llx, %#llx, %#llx, %#llx\n", what, function, first, second, third, fourth);
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? function : 1;
+		register uint64_t x1 __asm__("x1") = arguments;
+		register uint64_t x2 __asm__("x2") = first;
+		register uint64_t x3 __asm__("x3") = second;
+		register uint64_t x4 __asm__("x4") = third;
+		register uint64_t x5 __asm__("x5") = fourth;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6), "+r" (x7) : :
+		    "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != 1) {
+			say("mi8rp: TrustZone returns %d, answer %#llx\n", (int32_t)x0, x1);
+			*answer = x1;
+			return (int32_t)x0;
+		}
+	}
+	say("mi8rp: TrustZone keeps saying the call was interrupted\n");
+	return -1;
+}
+
+#define MAX_SEGMENTS 48
+static struct {
+	bool ready;                     /* header accepted by TrustZone and place told */
+	bool written;                   /* the segments are in the DSP's memory */
+	unsigned segments;
+	struct {
+		uint32_t at, file_size, memory_size, index;
+	} segment[MAX_SEGMENTS];
+	uint32_t size;
+} adsp_image;
+
+static bool adsp_started;
+
+static bool
+step_header(void)
+{
+	uint8_t *mdt;
+	uint32_t size = 0, count, lowest = ~0u, highest = 0;
+	vm_offset_t page = 0;
+	uint64_t answer = ~0ull;
+	int32_t result;
+
+	announce(7, "hands adsp.mdt to TrustZone (PAS image 1) and tells it where the image will be");
+	mdt = fs_slurp("image/adsp.mdt", &size);
+	if (mdt == NULL || size > PAGE_SIZE) {
+		say("mi8rp: 7: adsp.mdt not read or too big\n");
+		return false;
+	}
+	count = mdt[44] | mdt[45] << 8;
+	adsp_image.segments = 0;
+	for (uint32_t i = 0; i < count && i < MAX_SEGMENTS; i++) {
+		struct elf_phdr ph;
+
+		memcpy(&ph, mdt + 52 + 32 * i, sizeof(ph));
+		if (ph.type != 1 || MDT_HASH(ph.flags) || ph.memory_size == 0) {
+			continue;
+		}
+		if (ph.paddr < ADSP_MEMORY || (uint64_t)ph.paddr + ph.memory_size > (uint64_t)ADSP_MEMORY + ADSP_MEMORY_SIZE || ph.file_size > ph.memory_size ||
+		    (ph.paddr - ADSP_MEMORY) & 7) {
+			say("mi8rp: 7: segment %u is not within the DSP's memory or does not begin at a multiple of eight bytes\n", i);
+			kfree_data(mdt, size);
+			return false;
+		}
+		adsp_image.segment[adsp_image.segments].at = ph.paddr - ADSP_MEMORY;
+		adsp_image.segment[adsp_image.segments].file_size = ph.file_size;
+		adsp_image.segment[adsp_image.segments].memory_size = (ph.memory_size + 7) & ~7u;     /* (up to seven zero bytes past a segment that ends off a word) */
+		adsp_image.segment[adsp_image.segments].index = i;
+		adsp_image.segments++;
+		lowest = ph.paddr < lowest ? ph.paddr : lowest;
+		highest = ph.paddr + ph.memory_size > highest ? ph.paddr + ph.memory_size : highest;
+	}
+	if (adsp_image.segments == 0 || lowest != ADSP_MEMORY) {
+		say("mi8rp: 7: no segments or the lowest is not at %#x\n", ADSP_MEMORY);
+		kfree_data(mdt, size);
+		return false;
+	}
+	adsp_image.size = ((highest + 0xfff) & ~0xfffu) - ADSP_MEMORY;
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		say("mi8rp: 7: no memory for the header\n");
+		kfree_data(mdt, size);
+		return false;
+	}
+	memcpy((void *)page, mdt, size);
+	kfree_data(mdt, size);
+	for (vm_offset_t line = page; line < page + PAGE_SIZE; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	settle();
+	result = scm("to take the audio DSP's header", SCM_PAS_INIT_IMAGE, SCM_VALUE_AND_BUFFER, PAS_ADSP, kvtophys(page), 0, 0, &answer);
+	if (result != 0 || answer != 0) {
+		say("mi8rp: 7: TRUSTZONE DOES NOT TAKE THE HEADER (%d, %#llx)\n", result, answer);
+		return false;
+	}
+	say("mi8rp: 7: TRUSTZONE ACCEPTS THE AUDIO DSP'S SIGNATURE\n");
+	result = scm("where the image will be", SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, PAS_ADSP, ADSP_MEMORY, adsp_image.size, 0, &answer);
+	if (result != 0 || answer != 0) {
+		say("mi8rp: 7: TRUSTZONE DOES NOT TAKE THE PLACE (%d, %#llx)\n", result, answer);
+		return false;
+	}
+	say("mi8rp: 7: TrustZone takes the place: %#x bytes at %#x; %u segments to write\n", adsp_image.size, ADSP_MEMORY, adsp_image.segments);
+	adsp_image.ready = true;
+	return true;
+}
+
+static bool
+step_image(void)
+{
+	volatile uint64_t *dsp;
+	uint8_t *chunk;
+	const uint32_t chunk_size = 256 * 1024;
+	uint64_t written = 0, cleared = 0, wrong = 0;
+
+	if (!adsp_image.ready) {
+		return false;
+	}
+	announce(7, "writes the image's segments into the audio DSP's memory (0x8c500000, 30 MB) and reads them back");
+	chunk = kalloc_data(chunk_size, Z_WAITOK);
+	dsp = (volatile uint64_t *)ml_io_map_unmappable(ADSP_MEMORY, ADSP_MEMORY_SIZE, VM_WIMG_WCOMB);
+	if (chunk == NULL || dsp == NULL) {
+		say("mi8rp: 7: no buffer or no mapping\n");
+		return false;
+	}
+	for (unsigned pass = 0; pass < 2; pass++) {           /* pass 0: write; pass 1: read back and compare with the files again */
+		for (unsigned s = 0; s < adsp_image.segments; s++) {
+			volatile uint64_t *to = dsp + adsp_image.segment[s].at / 8;
+			char path[40];
+			struct fs_file f;
+
+			if (adsp_image.segment[s].file_size != 0) {
+				snprintf(path, sizeof(path), "image/adsp.b%02u", adsp_image.segment[s].index);
+				if (!fs_lookup(path, &f) || f.size != adsp_image.segment[s].file_size) {
+					say("mi8rp: 7: %s missing or of another size\n", path);
+					goto fail;
+				}
+			}
+			for (uint32_t at = 0; at < adsp_image.segment[s].memory_size; at += chunk_size) {
+				uint32_t take = MIN(chunk_size, adsp_image.segment[s].memory_size - at), from_file = 0;
+
+				if (at < adsp_image.segment[s].file_size) {
+					from_file = MIN(take, adsp_image.segment[s].file_size - at);
+					if (fs_file_read(&f, at, chunk, from_file) != 0) {
+						say("mi8rp: 7: %s: read error\n", path);
+						goto fail;
+					}
+				}
+				memset(chunk + from_file, 0, take - from_file);
+				for (uint32_t i = 0; i < take; i += 8) {
+					uint64_t word;
+
+					memcpy(&word, chunk + i, 8);
+					if (pass == 0) {
+						to[(at + i) / 8] = word;
+					} else {
+						wrong += to[(at + i) / 8] != word;
+					}
+				}
+				if (pass == 0) {
+					written += from_file;
+					cleared += take - from_file;
+				}
+			}
+		}
+		settle();
+	}
+	say("mi8rp: 7: %u segments, %llu bytes written and %llu cleared; read back, %llu words differ\n", adsp_image.segments, written, cleared, wrong);
+	ml_io_unmap((vm_offset_t)dsp, ADSP_MEMORY_SIZE);
+	kfree_data(chunk, chunk_size);
+	adsp_image.written = wrong == 0;
+	return adsp_image.written;
+fail:
+	ml_io_unmap((vm_offset_t)dsp, ADSP_MEMORY_SIZE);
+	kfree_data(chunk, chunk_size);
+	return false;
+}
+
+/* SMP2P with the audio DSP: its item (443), ours (429). */
+static uint32_t our_item;
+/* Which remote processor the SMP2P helpers below talk to: the audio DSP unless W2f points them at the modem. */
+static struct {
+	uint16_t remote;
+	uint32_t theirs_item, doorbell;
+} rem = { SMEM_ADSP, ITEM_SMP2P_THEIRS, IPC_SMP2P_ADSP };
+static bool smp2p_agreed, smp2p_restart_acks, smp2p_restart_acked;
+#define SMP2P_AT_FLAGS          16
+#define SMP2P_AT_VALUE(i)       (36 + 20 * (i))
+#define SMP2P_RESTART_DONE      (1u << 0)
+#define SMP2P_RESTART_ACK       (1u << 1)
+#define DSP_FATAL               (1u << 0)
+#define DSP_READY               (1u << 1)
+#define DSP_HANDOVER            (1u << 2)
+#define DSP_STOP_ACK            (1u << 3)
+#define DSP_SHUTDOWN_ACK        (1u << 7)
+#define DSP_STOP                (1u << 0)
+
+static uint32_t
+adsp_item(uint32_t item, uint32_t *size)
+{
+	uint32_t cacheline = 0, psize = 0, partition = smem_partition(SMEM_US, rem.remote, &cacheline, &psize);
+
+	return partition ? item_find(partition, cacheline, item, size) : 0;
+}
+
+static bool
+dsp_words(struct smp2p *words)
+{
+	uint32_t size = 0, at = adsp_item(rem.theirs_item, &size);
+
+	if (at == 0 || size < sizeof(*words)) {
+		return false;
+	}
+	return smem_peek(at, words, sizeof(*words)) && words->magic == SMP2P_MAGIC;
+}
+
+static int
+smp2p_entry(const struct smp2p *words, const char *name)
+{
+	for (unsigned i = 0; i < words->valid && i < 16; i++) {
+		if (strncmp(words->entry[i].name, name, sizeof(words->entry[i].name)) == 0) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+static uint32_t
+dsp_state(const struct smp2p *words)
+{
+	int entry = smp2p_entry(words, "slave-kernel");
+
+	return entry < 0 ? 0 : words->entry[entry].value;
+}
+
+static void
+show_words(const char *prefix, const struct smp2p *words)
+{
+	char line[320];
+	int at = 0;
+
+	line[0] = 0;
+	for (unsigned i = 0; i < words->valid && i < 16 && at < (int)sizeof(line) - 40; i++) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %.16s = %#x;", words->entry[i].name, words->entry[i].value);
+	}
+	say("mi8rp: %s: SMP2P version %u, features %#x, processors %u->%u, flags %#x, %u of %u entries:%s\n", prefix, words->version & 0xff,
+	    words->version >> 8, words->local, words->remote, words->flags, words->valid, words->total, line);
+}
+
+/* What Linux does when the DSP rings for SMP2P: agree on the features once, and answer a restart. */
+static void
+dsp_listen(const struct smp2p *theirs)
+{
+	struct smp2p ours;
+
+	if (our_item == 0 || !smem_peek(our_item, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC) {
+		return;
+	}
+	if (!smp2p_agreed) {
+		uint32_t features = (ours.version >> 8) & (theirs->version >> 8);
+
+		if ((theirs->version & 0xff) != (ours.version & 0xff)) {
+			return;
+		}
+		if (features != ours.version >> 8) {
+			smem_poke(our_item + SMP2P_AT_VERSION, features << 8 | (ours.version & 0xff));
+		}
+		smp2p_restart_acks = features & SMP2P_RESTART_ACKS;
+		smp2p_agreed = true;
+		say("mi8rp: 8: the DSP and we agree on SMP2P: version %u, features %#x\n", ours.version & 0xff, features);
+	}
+	if (smp2p_restart_acks && ((theirs->flags & SMP2P_RESTART_DONE) != 0) != smp2p_restart_acked) {
+		smp2p_restart_acked = !smp2p_restart_acked;
+		say("mi8rp: 8: the DSP's flags say it has restarted (%#x): answered in our flags (bit 1 = %u), and its doorbell\n", theirs->flags,
+		    smp2p_restart_acked);
+		smem_poke(our_item + SMP2P_AT_FLAGS, (ours.flags & ~SMP2P_RESTART_ACK) | (smp2p_restart_acked ? SMP2P_RESTART_ACK : 0));
+		settle();
+		ring(rem.doorbell);
+	}
+}
+
+static uint64_t
+now_us(void)
+{
+	uint64_t nanoseconds;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+	return nanoseconds / 1000;
+}
+
+/* Linux's qcom_q6v5_request_stop(): our bit "stop", the DSP's "stop ack" waited for, our bit taken back. */
+static bool
+dsp_ask_to_stop(uint32_t bound_ms)
+{
+	struct smp2p ours, theirs;
+	uint32_t state, value_at;
+	uint64_t asked, now;
+	int entry;
+
+	if (our_item == 0 || !smem_peek(our_item, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC || (entry = smp2p_entry(&ours, "master-kernel")) < 0) {
+		say("mi8rp: the DSP is not asked to stop: there is no item of ours to ask it with\n");
+		return false;
+	}
+	if (!dsp_words(&theirs) || smp2p_entry(&theirs, "slave-kernel") < 0) {
+		say("mi8rp: the DSP is not asked to stop: its item has no entry to answer in\n");
+		return false;
+	}
+	state = dsp_state(&theirs);
+	if (!(state & DSP_READY) || (state & DSP_FATAL)) {
+		say("mi8rp: the DSP is not asked to stop first: its entry says %#x, not \"up\"\n", state);
+		return false;
+	}
+	value_at = our_item + SMP2P_AT_VALUE((uint32_t)entry);
+	say("mi8rp: asking the DSP to stop: bit 0 of our \"master-kernel\" at %#lx, and its doorbell\n", SMEM_PHYS + value_at);
+	smem_poke(value_at, ours.entry[entry].value | DSP_STOP);
+	settle();
+	ring(rem.doorbell);
+	asked = now = now_us();
+	while (now - asked < bound_ms * 1000ull) {
+		if (dsp_words(&theirs) && (dsp_state(&theirs) & (DSP_STOP_ACK | DSP_FATAL))) {
+			break;
+		}
+		delay_for_interval(200, NSEC_PER_USEC);
+		now = now_us();
+	}
+	state = dsp_words(&theirs) ? dsp_state(&theirs) : 0;
+	say("mi8rp: %s after %llu.%03llu ms; its entry says %#x\n", state & DSP_STOP_ACK ? "THE AUDIO DSP ACKNOWLEDGES THE STOP" :
+	    "THE AUDIO DSP DOES NOT ACKNOWLEDGE THE STOP", (now - asked) / 1000, (now - asked) % 1000, state);
+	smem_poke(value_at, ours.entry[entry].value & ~DSP_STOP);
+	settle();
+	ring(rem.doorbell);
+	return (state & DSP_STOP_ACK) != 0;
+}
+
+static void
+show_crash_reason(void)
+{
+	char text[81];
+	uint32_t size = 0, at = adsp_item(ITEM_CRASH_REASON + rem.remote, &size);     /* 421 + remote pid */
+
+	if (at == 0) {
+		uint32_t cacheline = 0, psize = 0, global = smem_partition(SMEM_GLOBAL, SMEM_GLOBAL, &cacheline, &psize);
+
+		at = global ? item_find(global, cacheline, ITEM_CRASH_REASON + rem.remote, &size) : 0;
+	}
+	if (at == 0 || size == 0) {
+		say("mi8rp: item %u, the DSP's last words: not there\n", ITEM_CRASH_REASON + rem.remote);
+		return;
+	}
+	memset(text, 0, sizeof(text));
+	smem_peek(at, text, size < sizeof(text) - 1 ? size : sizeof(text) - 1);
+	say("mi8rp: THE AUDIO DSP'S LAST WORDS (item %u, %u bytes): \"%s\"\n", ITEM_CRASH_REASON + rem.remote, size, text);
+}
+
+static bool
+dsp_shutdown(const char *why)
+{
+	uint64_t answer = ~0ull;
+	int32_t result;
+	bool acked;
+
+	say("mi8rp: %s: the audio DSP is asked to stop, then TrustZone to shut it down\n", why);
+	acked = dsp_ask_to_stop(5000);
+	result = scm("to shut the audio DSP down", SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, PAS_ADSP, 0, 0, 0, &answer);
+	if (result != 0 || answer != 0) {
+		say("mi8rp: TRUSTZONE DOES NOT SHUT THE AUDIO DSP DOWN (%d, %#llx)\n", result, answer);
+		return false;
+	}
+	say("mi8rp: THE AUDIO DSP IS SHUT DOWN (%s its stop)\n", acked ? "after it acknowledged" : "WITHOUT its acknowledgement of");
+	adsp_started = false;
+	qmp_send("{class: image, res: load_state, name: adsp, val: off}");
+	return true;
+}
+
+static bool
+step_start(void)
+{
+	struct smp2p words, last, ours;
+	uint64_t answer = ~0ull, started, now, limit, ready_at = 0;
+	uint32_t wait_seconds = 10, state = 0, again = 0, changes = 0, size = 0;
+	int32_t result;
+	bool have, handed_over = false, spoke = false;
+	uint32_t cacheline = 0, psize = 0, partition;
+	static const char *const names[] = { "master-kernel" };
+
+	PE_parse_boot_argn("mi8rp_wait", &wait_seconds, sizeof(wait_seconds));
+	PE_parse_boot_argn("mi8rp_again", &again, sizeof(again));
+	if (!adsp_image.written) {
+		say("mi8rp: 8: the image is not in place\n");
+		return false;
+	}
+	if (dsp_words(&words) && !again) {
+		show_words("8: the DSP's item (443) is already there: a start before this one", &words);
+		say("mi8rp: 8: NOT STARTED: mi8rp_again=1 to try after a start before this one\n");
+		return false;
+	}
+	/* our item: made in step 4 or now, and filled in afresh with the version last */
+	partition = smem_partition(SMEM_US, SMEM_ADSP, &cacheline, &psize);
+	if (partition == 0) {
+		return false;
+	}
+	our_item = item_find(partition, cacheline, ITEM_SMP2P_OURS, &size);
+	if (our_item == 0) {
+		make_our_item(SMEM_ADSP, ITEM_SMP2P_OURS, names, 1);
+		our_item = item_find(partition, cacheline, ITEM_SMP2P_OURS, &size);
+		if (our_item == 0) {
+			say("mi8rp: 8: our SMP2P item is not there\n");
+			return false;
+		}
+	} else {
+		smp2p_fill(our_item, SMEM_ADSP, names, 1);
+	}
+	smp2p_agreed = smp2p_restart_acks = smp2p_restart_acked = false;
+	/* GLINK's marks of ours to zero, if its descriptor is there from before (no descriptor yet is normal) */
+	{
+		uint32_t d = item_find(partition, cacheline, ITEM_GLINK_DESCRIPTOR, &size);
+
+		if (d != 0 && size == 32) {
+			smem_poke(d + 4, 0);
+			smem_poke(d + 8, 0);
+			settle();
+		}
+	}
+	announce(8, "asks RPMh for CX at its top level, tells the AOP 'on', asks TrustZone to authenticate the image and release the DSP");
+	if (!rpmh_level("cx.lvl", 384)) {
+		return false;
+	}
+	if (!qmp_send("{class: image, res: load_state, name: adsp, val: on}")) {
+		return false;
+	}
+	bzero(&last, sizeof(last));
+	have = false;
+	ring(IPC_SMP2P_ADSP);
+	result = scm("to authenticate the audio DSP's image and start it", SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, PAS_ADSP, 0, 0, 0, &answer);
+	started = now_us();
+	adsp_image.written = false;
+	if (result != 0 || answer != 0) {
+		say("mi8rp: 8: TRUSTZONE DOES NOT START THE AUDIO DSP (%d, %#llx)\n", result, answer);
+		qmp_send("{class: image, res: load_state, name: adsp, val: off}");
+		return false;
+	}
+	adsp_started = true;
+	say("mi8rp: 8: TRUSTZONE HAS AUTHENTICATED THE IMAGE AND LET THE AUDIO DSP OUT OF RESET; watching for %u s\n", wait_seconds);
+	limit = started + wait_seconds * 1000000ull;
+	for (;;) {
+		now = now_us();
+		if (now >= limit) {
+			break;
+		}
+		if (dsp_words(&words) && (!have || memcmp(&words, &last, sizeof(words)) != 0)) {
+			char when[64];
+
+			snprintf(when, sizeof(when), "8: +%llu.%03llu ms: the DSP's item %s", (now - started) / 1000, (now - started) % 1000,
+			    have ? "changes" : "APPEARS");
+			if (changes++ < 40) {
+				show_words(when, &words);
+			}
+			last = words;
+			have = spoke = true;
+			dsp_listen(&words);
+			state = dsp_state(&words);
+			if ((state & DSP_READY) && ready_at == 0) {
+				ready_at = now;
+				limit = now + 3000000ull;
+				say("mi8rp: 8: THE AUDIO DSP SAYS IT IS UP: \"slave-kernel\" %#x, %llu.%03llu ms after the start\n", state,
+				    (now - started) / 1000, (now - started) % 1000);
+			}
+			if ((state & DSP_HANDOVER) && !handed_over) {
+				handed_over = true;
+				say("mi8rp: 8: the DSP says it has asked for its own power (bit 2)\n");
+			}
+			if (state & DSP_FATAL) {
+				say("mi8rp: 8: THE AUDIO DSP SAYS IT HAS GIVEN UP\n");
+				show_crash_reason();
+				break;
+			}
+		}
+		delay_for_interval(200, NSEC_PER_USEC);
+	}
+	say("mi8rp: 8: the watch is over after %llu ms\n", (now_us() - started) / 1000);
+	if (our_item != 0 && smem_peek(our_item, &ours, sizeof(ours))) {
+		show_words("8: our item (429) now", &ours);
+	}
+	if (ready_at == 0) {
+		say("mi8rp: 8: %s\n", spoke ? "THE AUDIO DSP RUNS BUT HAS NOT SAID \"UP\"" : "NOT A WORD FROM THE AUDIO DSP");
+		show_crash_reason();
+	}
+	return ready_at != 0;
+}
+
+
+/* ---- boot-arg mi8rp_mss: the modem subsystem's clocks, rails and halt ports, before any of its registers (W2a, W2b) ---- */
+
+#define GCC_PHYS                0x00100000ul
+#define GCC_SIZE                0x000a0000u     /* the registers below are all under 0x8b000 */
+#define GCC_VOTE                0x52004         /* the application processor's vote word (Linux: apcs_clk_en_reg) */
+#define TCSR_HALT_PHYS          0x01f60000ul    /* dt: halt_q6 0x1f63000, halt_nc 0x1f64000, halt_modem 0x1f65000 */
+
+struct gcc_clock {
+	const char *name;
+	uint32_t enable_reg, enable_bit;        /* the word and bit that turn it on */
+	uint32_t halt_reg;                      /* its CLK_OFF word (bit 31); 0: none, Linux waits a moment instead */
+};
+/* in Linux's order: proxy (prng), reset (iface, snoc_axi), active (bus, mem, gpll0_mss, mnoc_axi); gcc-sdm845.c */
+static const struct gcc_clock mss_clocks[] = {
+	{ "prng_ahb",          GCC_VOTE, 13, 0x34004 },
+	{ "mss_cfg_ahb",       0x8a000, 0, 0x8a000 },
+	{ "mss_snoc_axi",      0x8a150, 0, 0x8a150 },
+	{ "mss_q6_memnoc_axi", 0x8a154, 0, 0x8a154 },
+	{ "boot_rom_ahb",      GCC_VOTE, 10, 0x38004 },
+	{ "mss_gpll0_div",     GCC_VOTE, 17, 0 },
+	{ "mss_mfab_axis",     0x8a004, 0, 0x8a004 },
+};
+#define MSS_CLOCKS ((unsigned)(sizeof(mss_clocks) / sizeof(mss_clocks[0])))
+
+static vm_offset_t gcc_base;
+
+static vm_offset_t
+gcc(void)
+{
+	if (gcc_base == 0) {
+		gcc_base = ml_io_map(GCC_PHYS, GCC_SIZE);
+	}
+	return gcc_base;
+}
+
+static bool
+gcc_is_on(const struct gcc_clock *c)
+{
+	bool enabled = (rd(gcc() + c->enable_reg) >> c->enable_bit) & 1;
+
+	return enabled && (c->halt_reg == 0 || !(rd(gcc() + c->halt_reg) & (1u << 31)));
+}
+
+static void
+gcc_show(void)
+{
+	char line[300];
+	int at = 0;
+
+	for (unsigned i = 0; i < MSS_CLOCKS; i++) {
+		const struct gcc_clock *c = &mss_clocks[i];
+
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %s=%s", c->name, gcc_is_on(c) ? "on" : "off");
+	}
+	say("mi8rp: mss: clocks:%s; vote word %#x\n", line, rd(gcc() + GCC_VOTE));
+}
+
+/* Linux's clk_branch2 enable: set the bit, then wait for CLK_OFF to clear. */
+static bool
+gcc_enable(const struct gcc_clock *c)
+{
+	uint32_t was = rd(gcc() + c->enable_reg);
+
+	wr(gcc() + c->enable_reg, was | (1u << c->enable_bit));
+	settle();
+	if (c->halt_reg == 0) {
+		delay_for_interval(5, NSEC_PER_USEC);
+		return true;
+	}
+	for (unsigned t = 0; t < 2000; t++) {
+		if (!(rd(gcc() + c->halt_reg) & (1u << 31))) {
+			return true;
+		}
+		delay_for_interval(1, NSEC_PER_USEC);
+	}
+	say("mi8rp: mss: clock %s does not come on: halt word %#x\n", c->name, rd(gcc() + c->halt_reg));
+	return false;
+}
+
+static void
+gcc_disable(const struct gcc_clock *c)
+{
+	wr(gcc() + c->enable_reg, rd(gcc() + c->enable_reg) & ~(1u << c->enable_bit));
+	settle();
+}
+
+static void
+mss_w2a(void)
+{
+	static const char *const rails[] = { "cx.lvl", "mx.lvl", "mss.lvl" };
+	vm_offset_t tcsr;
+	uint32_t address;
+
+	announce(1, "(W2a) reads the modem subsystem's GCC clocks, RPMh rails and TCSR halt ports");
+	gcc_show();
+	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); i++) {
+		rail_position(rails[i], 0, &address, true);
+	}
+	announce(1, "(W2a) reads TCSR 0x1f63000.. (HALTREQ, HALTACK, IDLE of q6, nc, modem)");
+	tcsr = ml_io_map(TCSR_HALT_PHYS, 0x10000);
+	for (unsigned i = 0; i < 3; i++) {
+		static const char *const names[] = { "q6", "nc", "modem" };
+		vm_offset_t port = tcsr + 0x3000 + 0x1000 * i;
+
+		say("mi8rp: mss: halt port %s: req %#x ack %#x idle %#x\n", names[i], rd(port), rd(port + 4), rd(port + 8));
+	}
+	say("mi8rp: mss: W2a done: nothing was written\n");
+}
+
+#define RMB_PHYS                0x04180000ul
+#define RMB_PBL_STATUS          0x04
+#define RMB_MBA_STATUS          0x0c
+#define RMB_MSS_STATUS          0x40
+#define RMB_ALT_RESET           0x44
+#define PDC_PHYS                0x0b2e0000ul
+#define PDC_SYNC_RESET          0x100           /* Linux reset-qcom-pdc.c, sdm845: bit 9 is the modem */
+#define PDC_MODEM_BIT           (1u << 9)
+#define AOSS_CC_PHYS            0x0c2b0000ul    /* AOSS_CC_MSS_RESTART: 1 holds the modem in reset, 0 lets go */
+
+static void
+us(uint32_t n)
+{
+	delay_for_interval(n, NSEC_PER_USEC);
+}
+
+/* Linux q6v5_reset_deassert, alt-reset path (qcom_q6v5_mss.c); each register is shown before it is written. */
+static void
+mss_reset_deassert(vm_offset_t rmb, vm_offset_t pdc, vm_offset_t restart)
+{
+	wr(pdc + PDC_SYNC_RESET, rd(pdc + PDC_SYNC_RESET) | PDC_MODEM_BIT);
+	wr(rmb + RMB_ALT_RESET, 1);
+	wr(restart, 1);
+	settle();
+	us(300);
+	wr(restart, 0);
+	settle();
+	us(300);
+	wr(rmb + RMB_ALT_RESET, 0);
+	wr(pdc + PDC_SYNC_RESET, rd(pdc + PDC_SYNC_RESET) & ~PDC_MODEM_BIT);
+	settle();
+}
+
+/* Linux q6v5_reset_assert, alt-reset path. */
+static void
+mss_reset_assert(vm_offset_t pdc, vm_offset_t restart)
+{
+	wr(pdc + PDC_SYNC_RESET, rd(pdc + PDC_SYNC_RESET) | PDC_MODEM_BIT);
+	wr(restart, 1);
+	settle();
+	us(300);
+	wr(restart, 0);
+	settle();
+	us(300);
+	wr(pdc + PDC_SYNC_RESET, rd(pdc + PDC_SYNC_RESET) & ~PDC_MODEM_BIT);
+	settle();
+}
+
+static bool
+mss_clocks_on(unsigned from, unsigned to, bool *turned)
+{
+	for (unsigned i = from; i < to; i++) {
+		if (gcc_is_on(&mss_clocks[i])) {
+			continue;                       /* on already (someone else's): left as it is, and not turned off after */
+		}
+		turned[i] = true;
+		if (!gcc_enable(&mss_clocks[i])) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+mss_clocks_off(unsigned from, unsigned to, const bool *turned)
+{
+	for (unsigned i = to; i-- > from;) {
+		if (turned[i]) {
+			gcc_disable(&mss_clocks[i]);
+		}
+	}
+}
+
+/*
+ * W2b (level 2): rails and clocks. W2c (level 3): between the reset clocks and the active clocks, as in Linux, take the
+ * modem out of reset and read the RMB. The Q6 is never started (BOOT_CORE_START is not written).
+ */
+static void
+mss_w2bc(uint32_t level)
+{
+	bool turned[MSS_CLOCKS] = { false };
+	bool ok = true;
+	uint32_t address;
+
+	announce(2, "(W2b) QMP 'modem on', RPMh cx/mx/mss at their tops, then the GCC clocks on, read back, off again");
+	if (!qmp_send("{class: image, res: load_state, name: modem, val: on}")) {
+		return;
+	}
+	ok = rpmh_level_pos("cx.lvl", 0xffffffffu) && rpmh_level_pos("mx.lvl", 0xffffffffu) && rpmh_level_pos("mss.lvl", 0xffffffffu);
+	if (!ok) {
+		say("mi8rp: mss: a rail was not set: the clocks are not touched\n");
+		goto out;
+	}
+	ok = mss_clocks_on(0, 3, turned);               /* proxy (prng), reset (iface, snoc_axi) */
+	if (ok && level >= 3) {
+		vm_offset_t rmb = ml_io_map(RMB_PHYS, 0x1000);
+		vm_offset_t pdc = ml_io_map(PDC_PHYS, 0x1000);
+		vm_offset_t restart = ml_io_map(AOSS_CC_PHYS, 0x1000);
+
+		announce(3, "(W2c) reads RMB ALT_RESET (+0x44) with the reset clocks on, nothing written yet");
+		say("mi8rp: mss: rmb alt_reset %#x; pdc sync_reset %#x; aoss mss_restart %#x\n", rd(rmb + RMB_ALT_RESET), rd(pdc + PDC_SYNC_RESET), rd(restart));
+		announce(3, "(W2c) takes the modem out of reset: PDC bit 9 set, ALT_RESET 1, MSS_RESTART 1 then 0, ALT_RESET 0, PDC bit 9 clear");
+		mss_reset_deassert(rmb, pdc, restart);
+		say("mi8rp: mss: reset sequence done: rmb alt_reset %#x; pdc %#x; mss_restart %#x\n", rd(rmb + RMB_ALT_RESET), rd(pdc + PDC_SYNC_RESET), rd(restart));
+		ok = mss_clocks_on(3, MSS_CLOCKS, turned);      /* active (bus, mem, gpll0_mss, mnoc_axi) */
+		if (ok) {
+			announce(3, "(W2c) reads RMB PBL_STATUS, MBA_STATUS, MSS_STATUS (the Q6 is not started)");
+			say("mi8rp: mss: rmb pbl_status %#x mba_status %#x mss_status %#x image %#x\n", rd(rmb + RMB_PBL_STATUS), rd(rmb + RMB_MBA_STATUS), rd(rmb + RMB_MSS_STATUS), rd(rmb));
+		}
+		mss_clocks_off(3, MSS_CLOCKS, turned);
+		announce(3, "(W2c) puts the modem back into reset (Linux q6v5_reset_assert) before the reset clocks go");
+		mss_reset_assert(pdc, restart);
+		say("mi8rp: mss: back in reset: pdc %#x; mss_restart %#x\n", rd(pdc + PDC_SYNC_RESET), rd(restart));
+	} else if (ok) {
+		ok = mss_clocks_on(3, MSS_CLOCKS, turned);
+	}
+	gcc_show();
+	mss_clocks_off(0, 3, turned);
+	mss_clocks_off(3, MSS_CLOCKS, turned);
+	say("mi8rp: mss: the clocks it turned on are off again\n");
+	gcc_show();
+out:
+	rpmh_level_pos("mss.lvl", 0);
+	rail_position("mss.lvl", 0, &address, false);
+	qmp_send("{class: image, res: load_state, name: modem, val: off}");
+	say("mi8rp: mss: W2%c done: %s\n", level >= 3 ? 'c' : 'b', ok ? (level >= 3 ? "reset sequence and RMB read went through" : "all seven clocks came on and went off") : "A STEP FAILED");
+}
+
+/* ---- boot-arg mi8rp_mss=4 (W2d): hand the modem's memory to the MSS and take it back (SCM MP_ASSIGN) ---- */
+
+#define SCM_MP_ASSIGN           SCM_CALL(0xc, 0x16)
+#define SCM_MP_ASSIGN_ARGS      0x1117          /* QCOM_SCM_ARGS(7, RO, VAL, RO, VAL, RO, VAL, VAL) */
+#define VMID_HLOS               3
+#define VMID_MSS_MSA            15
+#define PERM_RW                 6
+#define PERM_RWX                7
+#define MBA_MEMORY              0x96900000u
+#define MBA_SIZE                0x00200000u
+#define MPSS_MEMORY             0x8e400000u
+#define MPSS_SIZE               0x07800000u
+
+static vm_offset_t assign_page;
+
+/* Linux q6v5_xfer_mem_ownership + qcom_scm_assign_mem: *current is the bit mask of VMIDs that own the region now. */
+static bool
+assign_owners(const char *name, uint32_t address, uint32_t size, uint64_t *current, uint64_t next)
+{
+	struct {
+		uint32_t vmid, perm;
+		uint64_t ctx;
+		uint32_t ctx_size, unused;
+	} *dest;
+	uint32_t *src;
+	uint64_t *region, *extra, answer = ~0ull, phys;
+	unsigned sources = 0, dests = 0;
+	int32_t result;
+
+	if (next == *current) {
+		return true;
+	}
+	if (assign_page == 0 && kmem_alloc(kernel_map, &assign_page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		say("mi8rp: mss: no memory for the assign call\n");
+		return false;
+	}
+	memset((void *)assign_page, 0, PAGE_SIZE);
+	src = (uint32_t *)assign_page;                          /* +0: the VMIDs that own it now */
+	region = (uint64_t *)(assign_page + 0x40);              /* +0x40: address, size */
+	dest = (void *)(assign_page + 0x80);                    /* +0x80: the owners to be */
+	extra = (uint64_t *)(assign_page + 0x200);              /* +0x200: arguments 3..9 that do not fit in registers */
+	for (unsigned b = 0; b < 64; b++) {
+		if (*current & (1ull << b)) {
+			src[sources++] = b;
+		}
+	}
+	region[0] = address;
+	region[1] = size;
+	for (unsigned b = 0; b < 64; b++) {
+		if (next & (1ull << b)) {
+			dest[dests].vmid = b;
+			dest[dests++].perm = b == VMID_HLOS ? PERM_RWX : PERM_RW;
+		}
+	}
+	phys = kvtophys(assign_page);
+	extra[0] = sources * 4;
+	extra[1] = phys + 0x80;
+	extra[2] = dests * (uint32_t)sizeof(*dest);
+	extra[3] = 0;
+	for (vm_offset_t line = assign_page; line < assign_page + PAGE_SIZE; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	settle();
+	say("mi8rp: mss: %s %#x..%#x: owners %#llx -> %#llx\n", name, address, address + size, *current, next);
+	result = scm("to assign the modem's memory", SCM_MP_ASSIGN, SCM_MP_ASSIGN_ARGS, phys + 0x40, 16, phys, phys + 0x200, &answer);
+	if (result != 0 || answer != 0) {
+		say("mi8rp: mss: MP_ASSIGN of %s FAILED (%d, %#llx): the owners stay %#llx\n", name, result, answer, *current);
+		return false;
+	}
+	*current = next;
+	return true;
+}
+
+static bool
+assign_mem(const char *name, uint32_t address, uint32_t size, uint64_t *current, bool local, bool remote)
+{
+	return assign_owners(name, address, size, current, (local ? 1ull << VMID_HLOS : 0) | (remote ? 1ull << VMID_MSS_MSA : 0));
+}
+
+static void
+mss_w2d(void)
+{
+	uint64_t mba_owners = 1ull << VMID_HLOS, mpss_owners = 1ull << VMID_HLOS;
+	volatile uint32_t *mba;
+	bool ok = true, stuck = false;
+	uint32_t before, after;
+
+	announce(4, "(W2d) SCM MP_ASSIGN: MBA region HLOS -> MSS only -> HLOS; modem region HLOS -> HLOS+MSS -> MSS only -> HLOS. Nothing in them is touched while the MSS owns them");
+	mba = (volatile uint32_t *)ml_io_map_unmappable(MBA_MEMORY, 0x1000, VM_WIMG_WCOMB);
+	mba[0] = 0x4d424131;
+	mba[1] = 0xa5a5a5a5;
+	settle();
+	say("mi8rp: mss: the first MBA word is written: %#x %#x\n", mba[0], mba[1]);
+	if (assign_mem("mba", MBA_MEMORY, MBA_SIZE, &mba_owners, false, true)) {
+		if (!assign_mem("mba", MBA_MEMORY, MBA_SIZE, &mba_owners, true, false) && !assign_mem("mba", MBA_MEMORY, MBA_SIZE, &mba_owners, true, false)) {
+			stuck = true;
+		}
+	} else {
+		ok = false;
+	}
+	if (!stuck && ok) {
+		before = mba[0];
+		after = mba[1];
+		say("mi8rp: mss: back with the kernel, the first MBA words read %#x %#x\n", before, after);
+		if (assign_mem("mpss", MPSS_MEMORY, MPSS_SIZE, &mpss_owners, true, true) &&
+		    assign_mem("mpss", MPSS_MEMORY, MPSS_SIZE, &mpss_owners, false, true)) {
+			if (!assign_mem("mpss", MPSS_MEMORY, MPSS_SIZE, &mpss_owners, true, false) && !assign_mem("mpss", MPSS_MEMORY, MPSS_SIZE, &mpss_owners, true, false)) {
+				stuck = true;
+			}
+		} else {
+			ok = false;
+			/* a half-way step: try to give it back */
+			if (mpss_owners != (1ull << VMID_HLOS) && !assign_mem("mpss", MPSS_MEMORY, MPSS_SIZE, &mpss_owners, true, false)) {
+				stuck = true;
+			}
+		}
+	}
+	say("mi8rp: mss: W2d done: %s\n", stuck ? "A REGION IS STILL THE MODEM'S: DO NOT TOUCH IT" : ok ? "both regions went to the MSS and came back" : "A STEP FAILED, the regions are the kernel's");
+}
+
+/* ---- boot-arg mi8rp_mss=5 (W2e): start the modem's Q6 on the MBA and see it answer; no modem image is loaded ---- */
+
+#define QDSP6SS_PHYS            0x04080000ul
+#define QDSP6SS_SLEEP           0x3c
+#define QDSP6SS_BOOT_CORE_START 0x400
+#define QDSP6SS_BOOT_CMD        0x404
+#define Q6SS_CBCR_CLKEN         (1u << 0)
+#define Q6SS_CBCR_CLKOFF        (1u << 31)
+
+/* Linux q6v5proc_halt_axi_port (it waits 100 ms for the ack; here 1 s, EXP-0198); true if the port is idle afterwards. */
+static bool
+halt_port(const char *name, vm_offset_t port)
+{
+	uint32_t ack = 0, waited = 0;
+
+	if (rd(port + 8)) {
+		say("mi8rp: mss: halt port %s is idle already\n", name);
+		return true;
+	}
+	wr(port, 1);
+	for (; waited < 1000 && !(ack = rd(port + 4)); waited++) {
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	say("mi8rp: mss: halt port %s: ack %#x after %u ms, idle %#x\n", name, ack, waited, rd(port + 8));
+	wr(port, 0);
+	return rd(port + 8) != 0;
+}
+
+#define MDT_RELOCATABLE         (1u << 27)
+#define MBA_META_OFFSET         0x00100000u     /* Linux puts the debug policy here, so the MBA leaves it free */
+#define MBA_META_AUTH_OK        3
+#define MBA_AUTH_COMPLETE       4
+#define RMB_META_DATA           0x10
+#define RMB_COMMAND             0x08
+#define RMB_CODE_START          0x14
+#define RMB_CODE_LENGTH         0x18
