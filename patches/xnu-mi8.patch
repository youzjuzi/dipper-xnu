+	uint32_t part;
+
+	if (!ufs_ready || ufs_dead || (part = ufs_entry(name)) >= BLOCK_MAX_PARTS || (ufs_page->part[part].flags & BLOCK_PART_UNIT)) {
+		return ENXIO;
+	}
+	*size = (uint64_t)ufs_page->part[part].block_size * ufs_page->part[part].blocks;
+	return 0;
