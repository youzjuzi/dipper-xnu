+	uint8_t unused_1[3], snr_valid;
+	int16_t snr;
+	uint8_t noise_valid, unused_2;
+	int16_t noise;
+	uint8_t cca_valid, cca;
+	uint32_t tx_fail, tx_retrans, tx_frames, rx_retry, rx_frames;
+	uint8_t unused_3[0x40 - 0x28];
+	uint32_t tx_rate, tx_fallback_rate, rx_rate;
+	uint8_t rest[0xc0 - 0x4c];
+};
