+static int arrive(struct mi8_wlfw *w)
+{
+	struct mi8_wlfw_ind_register_req_msg_v01 reg = { 0 };
+	struct mi8_wlfw_ind_register_resp_msg_v01 reg_resp = { 0 };
+	struct mi8_wlfw_host_cap_req_msg_v01 host = { 0 };
+	struct mi8_wlfw_host_cap_resp_msg_v01 host_resp = { 0 };
+	struct mi8_wlfw_msa_info_req_msg_v01 msa = { 0 };
+	struct mi8_wlfw_msa_info_resp_msg_v01 msa_resp = { 0 };
+	struct mi8_wlfw_msa_ready_req_msg_v01 ready = { 0 };
+	struct mi8_wlfw_msa_ready_resp_msg_v01 ready_resp = { 0 };
+	int r;
+	reg.client_id_valid = reg.fw_ready_enable_valid = reg.msa_ready_enable_valid = 1;
+	reg.client_id = 0x4b4e454c; reg.fw_ready_enable = reg.msa_ready_enable = 1;
+	/* MI8: as Android's icnss wlfw_ind_register_send_sync_msg (FW_REJUVENATE_ENABLE is in its default quirks) */
+	reg.pin_connect_result_enable_valid = reg.pin_connect_result_enable = 1;
+	reg.rejuvenate_enable_valid = 1; reg.rejuvenate_enable = 1;
+	r = REQ(w, ind_register, IND_REGISTER, &reg, &reg_resp, false);
+	if (r) return r;
+	if (reg_resp.fw_status_valid && (reg_resp.fw_status & QMI_WLFW_FW_READY_V01)) {
+		/* Re-registering must not reassign memory already used by the firmware. */
+		r = cap(w);
+		if (r) return r;
+		w->initialized = w->downloaded = w->ready = true;
+		LOG(w, "fw ready (registration status)\n"); emit(w, MI8_WLFW_FW_READY);
+		return 0;
+	}
+	if (!w->cfg.skip_host_cap) {
+		host.daemon_support_valid = 1;
+		r = request(w, "host_cap", QMI_WLFW_HOST_CAP_REQ_V01, WLFW_HOST_CAP_REQ_MSG_V01_MAX_MSG_LEN,
+		    w->cfg.host_cap_8bit ? mi8_wlfw_host_cap_8bit_req_msg_v01_ei : mi8_wlfw_host_cap_req_msg_v01_ei,
+		    &host, mi8_wlfw_host_cap_resp_msg_v01_ei, &host_resp, true);
+		if (r) return r;
+	}
+	msa.msa_addr = w->cfg.msa_phys; msa.size = w->cfg.msa_size;
+	/* MI8 (EXP-0203): the modem answers INCOMPATIBLE_STATE (90) while its WLAN firmware is still coming up; ask again (upstream does the same for CAP). */
+	for (unsigned tries = 0; ; tries++) {
+		r = REQ(w, msa_info, MSA_INFO, &msa, &msa_resp, false);
+		if (!r || r != -EIO || msa_resp.resp.error != 90 || tries >= 40) break;
+		w->cfg.sleep_ms(w->cfg.ctx, 500);
+	}
+	if (r) return r;
+	if (!msa_resp.mem_region_info_len || msa_resp.mem_region_info_len > QMI_WLFW_MAX_MEM_REG_V01) return -EINVAL;
+	for (unsigned i = 0; i < msa_resp.mem_region_info_len; i++) {
+		struct mi8_wlfw_memory_region_info_s_v01 *m = &msa_resp.mem_region_info[i];
+		if (!m->size || m->secure_flag > 1 || m->region_addr < msa.msa_addr ||
+		    m->region_addr - msa.msa_addr > msa.size || m->size > msa.size - (m->region_addr - msa.msa_addr)) return -ERANGE;
+		for (unsigned j = 0; j < i; j++) {
+			struct mi8_wlfw_memory_region_info_s_v01 *p = &msa_resp.mem_region_info[j];
+			if (m->region_addr < p->region_addr + p->size && p->region_addr < m->region_addr + m->size) return -EINVAL;
+		}
+		LOG(w, "msa_info region=%u addr=0x%llx size=%u secure=%u\n", i, (unsigned long long)m->region_addr, m->size, m->secure_flag);
+	}
+	w->nr_regions = msa_resp.mem_region_info_len;
+	memcpy(w->regions, msa_resp.mem_region_info, sizeof(w->regions));
+	/* Linux's SDM845 MPSS security-violation workaround. */
+	w->cfg.sleep_ms(w->cfg.ctx, 20);
+	for (unsigned i = 0; i < w->nr_regions; i++) {
+		struct mi8_wlfw_memory_region_info_s_v01 *m = &w->regions[i];
+		if (!current(w)) return -ENOTCONN;
+		r = norm(w->cfg.msa_assign(w->cfg.ctx, m->region_addr, m->size, m->secure_flag != 0, true));
+		LOG(w, "msa assign addr=0x%llx size=%u secure=%u rc=%d\n", (unsigned long long)m->region_addr, m->size, m->secure_flag, r);
+		if (r) return r;
+		w->assigned[i] = true;
+	}
+	r = REQ(w, msa_ready, MSA_READY, &ready, &ready_resp, false);
+	if (r) return r;
+	r = cap(w);
+	if (!r) w->initialized = true;
+	return r;
+}
+static int download(struct mi8_wlfw *w)
+{
+	struct mi8_wlfw_bdf_download_req_msg_v01 *req;
+	struct mi8_wlfw_bdf_download_resp_msg_v01 resp;
+	struct mi8_wlfw_cal_report_req_msg_v01 cal = { 0 };
+	struct mi8_wlfw_cal_report_resp_msg_v01 cal_resp = { 0 };
+	char name[256] = { 0 };
+	uint64_t size = 0, off = 0;
+	int r = norm(w->cfg.board_file_name(w->cfg.ctx, w->info.board_id, w->info.chip_id, name, sizeof(name)));
+	if (r) return r;
+	if (!name[0] || !memchr(name, 0, sizeof(name))) return -EINVAL;
+	r = norm(w->cfg.file_size(w->cfg.ctx, name, &size));
+	if (r) return r;
+	if (!size || size > UINT32_MAX) return -EFBIG;
+	req = MI8_ALLOC(sizeof(*req));
+	if (!req) return -ENOMEM;
+	memset(req, 0, sizeof(*req));
+	req->valid = req->file_id_valid = req->total_size_valid = req->seg_id_valid = req->data_valid = req->end_valid = 1;
+	req->total_size = (uint32_t)size;
+	while (off < size) {
+		req->data_len = (uint32_t)((size - off > 6144) ? 6144 : size - off);
+		req->end = off + req->data_len == size;
+		r = norm(w->cfg.file_read(w->cfg.ctx, name, off, req->data, req->data_len));
+		if (r) break;
+		if (log_n(req->seg_id + 1)) LOG(w, "bdf_download seg=%u offset=%llu len=%u end=%u total=%u\n", req->seg_id, (unsigned long long)off, req->data_len, req->end, req->total_size);
+		memset(&resp, 0, sizeof(resp));
+		r = REQ(w, bdf_download, BDF_DOWNLOAD, req, &resp, false);
+		if (r) break;
+		off += req->data_len; req->seg_id++;
+	}
+	MI8_FREE(req, sizeof(*req));
+	if (r) return r;
+	LOG(w, "bdf downloaded bytes=%llu\n", (unsigned long long)size);
+	/* Linux reports an empty cache when no calibration files are available. */
+	r = REQ(w, cal_report, CAL_REPORT, &cal, &cal_resp, false);
+	if (!r) w->downloaded = true;
+	return r;
+}
+struct mi8_wlfw *mi8_wlfw_create(const struct mi8_wlfw_cfg *cfg)
+{
+	struct mi8_wlfw *w;
+	if (!cfg || !cfg->qrtr || !cfg->qrtr->open || !cfg->qrtr->close || !cfg->qrtr->lookup || !cfg->qrtr->send ||
+	    !cfg->msa_size || cfg->msa_phys > UINT64_MAX - cfg->msa_size || !cfg->msa_assign ||
+	    !cfg->file_size || !cfg->file_read || !cfg->board_file_name || !cfg->sleep_ms) return NULL;
+	w = MI8_ALLOC(sizeof(*w));
+	if (!w) return NULL;
+	memset(w, 0, sizeof(*w)); w->cfg = *cfg;
+	w->timeout = cfg->request_timeout_ms ? cfg->request_timeout_ms : 30000;
+	LOCK_INIT(&w->lock);
+	return w;
+}
+int mi8_wlfw_start(struct mi8_wlfw *w)
+{
+	int r;
+	if (!w) return -EINVAL;
+	if (w->started) return error(w, "already started", -EALREADY);
+	for (unsigned i = 0; i < w->nr_regions; i++)
+		if (w->assigned[i]) return error(w, "MSA still assigned", -EBUSY);
+	w->head = w->count = 0; w->overflow = w->failed = false;
+	opening = w; redwood_qmi_set_transport(&bridge);
+	r = qmi_handle_init(&w->qmi, 8192, &qops, handlers);
+	redwood_qmi_set_transport(w->cfg.qrtr); opening = NULL;
+	if (r) return error(w, "handle init", r);
+	w->started = true;
+	r = qmi_add_lookup(&w->qmi, 69, 1, 0);
+	if (r) { qmi_handle_release(&w->qmi); w->started = w->present = false; return error(w, "lookup", r); }
+	return 0;
+}
+int mi8_wlfw_process(struct mi8_wlfw *w, uint32_t timeout_ms)
+{
+	unsigned budget = QUEUE_SIZE;
+	int r = 0;
+	if (!w || !w->started) return -EINVAL;
+	w->timeout = timeout_ms ? timeout_ms : (w->cfg.request_timeout_ms ? w->cfg.request_timeout_ms : 30000);
+	while (budget--) {
+		struct queued q;
+		bool overflow;
+		LOCK(&w->lock);
+		overflow = w->overflow;
+		if (overflow || !w->count) { UNLOCK(&w->lock); if (overflow) return error(w, "event overflow; stop required", -ENOBUFS); break; }
+		q = w->queue[w->head]; w->head = (w->head + 1) % QUEUE_SIZE; w->count--;
+		UNLOCK(&w->lock);
+		if (q.ev == MI8_WLFW_SERVER_EXIT) {
+			w->ready = w->downloaded = w->initialized = false;
+			memset(&w->info, 0, sizeof(w->info));
+			emit(w, MI8_WLFW_FW_DOWN); LOG(w, "server exit peer=%u:%u\n", q.node, q.port);
+			r = unassign(w); emit(w, MI8_WLFW_SERVER_EXIT);
+			if (r) return error(w, "MSA restore", r);
+			continue;
+		}
+		w->worker_generation = q.generation;
+		if (!current(w)) continue;
+		if (q.ev == MI8_WLFW_SERVER_ARRIVE) {
+			r = unassign(w);
+			if (r) return error(w, "old MSA restore", r);
+			w->failed = w->ready = w->downloaded = w->initialized = false;
+			LOG(w, "server arrive peer=%u:%u generation=%u\n", q.node, q.port, q.generation);
+			emit(w, q.ev); r = arrive(w);
+		} else if (!w->failed && q.ev == MI8_WLFW_MSA_READY && w->initialized && !w->downloaded) {
+			LOG(w, "msa_ready indication\n"); emit(w, q.ev);
+			/* MI8: Android's icnss sends neither BDF_DOWNLOAD nor CAL_REPORT; the firmware takes its own board data (EXP-0203) */
+			if (w->cfg.skip_bdf) {
+				struct mi8_wlfw_dynamic_feature_mask_req_msg_v01 fm = { 0 };
+				struct mi8_wlfw_dynamic_feature_mask_resp_msg_v01 fr = { 0 };
+				w->downloaded = true; LOG(w, "bdf skipped (the firmware loads its own board data)\n");
+				/* Android icnss_driver_event_server_arrive: after power-on, DYNAMIC_FEATURE_MASK = ICNSS_DEFAULT_FEATURE_MASK (1); a refusal is not fatal there */
+				fm.mask_valid = 1; fm.mask = 1;
+				if (!REQ(w, dynamic_feature_mask, DYNAMIC_FEATURE_MASK, &fm, &fr, true))
+					LOG(w, "feature mask prev=%u:0x%llx curr=%u:0x%llx\n", fr.prev_mask_valid, (unsigned long long)fr.prev_mask, fr.curr_mask_valid, (unsigned long long)fr.curr_mask);
+			}
+			else r = download(w);
+		} else if (!w->failed && q.ev == MI8_WLFW_FW_READY && !w->ready) {
+			if (!w->downloaded) r = -EPROTO;
+			else { w->ready = true; LOG(w, "fw ready\n"); emit(w, q.ev); }
+		}
+		if (r) {
+			int cleanup = unassign(w);
+			if (cleanup) LOG(w, "ERROR MSA restore rc=%d retained for retry\n", cleanup);
+			return error(w, "initialize", r);
+		}
+	}
+	return r;
+}
+static int mode_send(struct mi8_wlfw *w, int mode)
+{
+	struct mi8_wlfw_wlan_mode_req_msg_v01 req = { 0 };
+	struct mi8_wlfw_wlan_mode_resp_msg_v01 resp = { 0 };
+	req.mode = mode; req.hw_debug_valid = 1;
+	LOG(w, "wlan_mode mode=%d hw_debug=0\n", mode);
+	return REQ(w, wlan_mode, WLAN_MODE, &req, &resp, false);
+}
+int mi8_wlfw_enable(struct mi8_wlfw *w, const struct mi8_wlfw_wlan_cfg *c, int mode)
+{
+	struct mi8_wlfw_wlan_cfg_req_msg_v01 *req;
+	struct mi8_wlfw_wlan_cfg_resp_msg_v01 resp = { 0 };
+	int r;
+	if (!w) return -EINVAL;
+	if (!w->started || !w->ready || w->failed || !current(w)) return error(w, "enable not ready", -ENOTCONN);
+	if (!c || mode < 0 || mode > 7 || mode == QMI_WLFW_OFF_V01 || c->num_ce_tgt_cfg > 12 ||
+	    c->num_ce_svc_pipe_cfg > 24 || c->num_shadow_reg_cfg > 24 ||
+	    (c->num_ce_tgt_cfg && !c->ce_tgt_cfg) || (c->num_ce_svc_pipe_cfg && !c->ce_svc_cfg) ||
+	    (c->num_shadow_reg_cfg && !c->shadow_reg_cfg)) return error(w, "enable config", -EINVAL);
+	req = MI8_ALLOC(sizeof(*req));
+	if (!req) return error(w, "enable allocate", -ENOMEM);
+	memset(req, 0, sizeof(*req));
+	req->tgt_cfg_valid = req->svc_cfg_valid = req->shadow_reg_valid = 1;
+	req->tgt_cfg_len = c->num_ce_tgt_cfg; req->svc_cfg_len = c->num_ce_svc_pipe_cfg; req->shadow_reg_len = c->num_shadow_reg_cfg;
+	if (req->tgt_cfg_len) memcpy(req->tgt_cfg, c->ce_tgt_cfg, req->tgt_cfg_len * sizeof(req->tgt_cfg[0]));
+	if (req->svc_cfg_len) memcpy(req->svc_cfg, c->ce_svc_cfg, req->svc_cfg_len * sizeof(req->svc_cfg[0]));
+	if (req->shadow_reg_len) memcpy(req->shadow_reg, c->shadow_reg_cfg, req->shadow_reg_len * sizeof(req->shadow_reg[0]));
+	LOG(w, "wlan_cfg ce=%u svc=%u shadow=%u\n", req->tgt_cfg_len, req->svc_cfg_len, req->shadow_reg_len);
+	r = REQ(w, wlan_cfg, WLAN_CFG, req, &resp, false);
+	MI8_FREE(req, sizeof(*req));
+	if (!r) r = mode_send(w, mode);
+	return r ? error(w, "enable", r) : 0;
+}
+int mi8_wlfw_disable(struct mi8_wlfw *w)
+{
+	int r;
+	if (!w) return -EINVAL;
+	if (!w->started || !current(w)) return error(w, "disable disconnected", -ENOTCONN);
+	r = mode_send(w, QMI_WLFW_OFF_V01);
+	return r ? error(w, "disable", r) : 0;
+}
+const struct mi8_wlfw_info *mi8_wlfw_info(const struct mi8_wlfw *w) { return w ? &w->info : NULL; }
+int mi8_wlfw_stop(struct mi8_wlfw *w)
+{
+	int r;
+	if (!w) return -EINVAL;
+	if (w->started) qmi_handle_release(&w->qmi);
+	w->started = w->present = w->ready = w->initialized = w->downloaded = false;
+	w->head = w->count = 0; w->overflow = false;
+	memset(&w->info, 0, sizeof(w->info));
+	r = unassign(w);
+	return r ? error(w, "stop MSA restore", r) : 0;
+}
+int mi8_wlfw_destroy(struct mi8_wlfw *w)
+{
+	int r;
+	if (!w) return 0;
+	r = mi8_wlfw_stop(w);
+	if (r) return r;
+	LOCK_FINI(&w->lock); MI8_FREE(w, sizeof(*w));
+	return 0;
+}
