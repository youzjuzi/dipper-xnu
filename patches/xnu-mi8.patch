+static void
+tftp_error(struct mi8_hostsvc *h, uint32_t node, uint32_t port, unsigned code, const char *message)
+{
+	uint8_t bytes[128];
+	unsigned n = (unsigned)strlen(message);
+	if (n > 122) n = 122;
+	setbe16(bytes, 5); setbe16(bytes + 2, code); memcpy(bytes + 4, message, n); bytes[4 + n] = 0;
+	send_reply(h, 1, node, port, bytes, n + 5);
+	LOG(h, LOG_ERROR, "mi8hs: ERROR tftp code=%u %s\n", code, message);
+}
+
+static void
+tftp_ack(struct mi8_hostsvc *h, struct tftp *s)
+{
+	uint8_t bytes[4];
+	setbe16(bytes, 4); setbe16(bytes + 2, (unsigned)s->acked);
+	send_reply(h, 1, s->node, s->port, bytes, sizeof(bytes));
+}
+
+static void
+tftp_window(struct mi8_hostsvc *h, struct tftp *s)
+{
+	uint8_t *bytes;
+	uint64_t block, until = s->acked + s->window;
+	if (s->oack) {
+		int r = send_reply(h, 1, s->node, s->port, s->options, s->option_size);
+
+		LOG(h, LOG_OTHER, "mi8hs: tftp oack %u bytes blocksize %u window %u -> %d\n", s->option_size, s->blocksize, s->window, r);
+		return;
+	}
+	if (s->done) return;
+	if (until > s->final) until = s->final;
+	bytes = MI8_ALLOC(s->blocksize + 4);
+	if (!bytes) { tftp_error(h, s->node, s->port, 0, "out of memory"); return; }
+	for (block = s->acked + 1; block <= until; block++) {
+		uint64_t offset = (block - 1) * s->blocksize, left = s->size - offset;
+		unsigned n = left > s->blocksize ? s->blocksize : (unsigned)left;
+		setbe16(bytes, 3); setbe16(bytes + 2, (unsigned)block);
+		if (n && h->cfg.file_read(h->cfg.ctx, s->path, offset, bytes + 4, n)) {
+			tftp_error(h, s->node, s->port, 0, "read failure"); s->done = true; break;
+		}
+		{
+			int r = send_reply(h, 1, s->node, s->port, bytes, n + 4);
+
+			LOG(h, LOG_OTHER, "mi8hs: tftp data block=%llu bytes=%u -> %d\n", (unsigned long long)block, n, r);
+			if (r) break;
+		}
+		s->sent = block;
+	}
+	MI8_FREE(bytes, s->blocksize + 4);
+}
+
+static void
+tftp_open(struct mi8_hostsvc *h, uint32_t node, uint32_t port, const uint8_t *request, unsigned length, bool write)
+{
+	struct tftp *s = NULL, *free_slot = NULL;
+	const uint8_t *p = request + 2;
+	unsigned left = length - 2, i, opts = 0;
+	char filename[256], mode[16], key[32], val[32], path[263];
+	uint32_t blksize = 512, window = 1, timeout = 0;
+	const char *tname = "timeout", *wname = "windowsize";
+	uint64_t size = 0, value;
+	struct builder b;
+	if (length > 1024 || !field(&p, &left, filename, sizeof(filename)) || !field(&p, &left, mode, sizeof(mode)) ||
+	    !ascii_equal(mode, "octet") || !file_path(filename, path)) {
+		tftp_error(h, node, port, 4, "bad request or path"); return;
+	}
+	while (left) {
+		unsigned bit = 0;
+		if (!field(&p, &left, key, sizeof(key)) || !field(&p, &left, val, sizeof(val))) goto bad_options;
+		LOG(h, LOG_OTHER, "mi8hs: tftp option %s=%s\n", key, val);
+		if (ascii_equal(key, "blksize")) bit = 1;
+		else if (ascii_equal(key, "tsize")) bit = 2;
+		else if (ascii_equal(key, "timeout")) bit = 4;
+		else if (ascii_equal(key, "timeoutms")) { bit = 4; tname = "timeoutms"; }      /* Qualcomm's own names (EXP-0200) */
+		else if (ascii_equal(key, "windowsize")) bit = 8;
+		else if (ascii_equal(key, "wsize")) { bit = 8; wname = "wsize"; }
+		if (!bit) continue;
+		if ((opts & bit) || !decimal(val, &value)) goto bad_options;
+		opts |= bit;
+		if (bit == 1) {
+			if (value < 8 || value > 65464) goto bad_options;
+			blksize = value > TFTP_BLOCK ? TFTP_BLOCK : (uint32_t)value;
+		} else if (bit == 2) {
+			if (!write && value) goto bad_options;
+		} else if (bit == 4) {
+			if (value < 1 || value > 65535) goto bad_options;
+			timeout = (uint32_t)value;
+		} else {
+			if (value < 1 || value > 65535) goto bad_options;
+			window = value > TFTP_WINDOW ? TFTP_WINDOW : (uint32_t)value;
+		}
+	}
+	for (i = 0; i < SESSIONS; i++) {
+		struct tftp *v = &h->sessions[i];
+		if (v->live && v->node == node && v->port == port) { s = v; break; }
+		if (!free_slot && (!v->live || v->done)) free_slot = v;
+	}
+	if (s && s->request_size == length && !memcmp(s->request, request, length) && !s->done) {
+		if (s->write) tftp_ack(h, s); else tftp_window(h, s);
+		return;
+	}
+	if (!s) s = free_slot;
+	if (!s) { tftp_error(h, node, port, 0, "session capacity"); return; }
+	if (!write && h->cfg.file_size(h->cfg.ctx, path, &size)) { h->cfg.log(h->cfg.ctx, "mi8hs: tftp rrq file=%s not found\n", path); tftp_error(h, node, port, 1, "not found"); return; }
+	memset(s, 0, sizeof(*s)); s->live = true; s->write = write; s->node = node; s->port = port;
+	s->size = size; s->blocksize = write ? 512 : blksize; s->window = write ? 1 : window;
+	s->final = size / s->blocksize + 1;
+	memcpy(s->path, path, strlen(path) + 1); memcpy(s->request, request, length); s->request_size = length;
+	if (write) {
+		LOG(h, LOG_WRQ, "mi8hs: tftp wrq file=%s dropped %llu bytes\n", path, 0ull);
+		tftp_ack(h, s); return;
+	}
+	LOG(h, LOG_RRQ, "mi8hs: tftp rrq file=%s size=%llu\n", path, (unsigned long long)size);
+	b.p = s->options; b.n = 2; b.capacity = sizeof(s->options); b.failed = false;
+	setbe16(s->options, 6);
+	if (opts & 1) option(&b, "blksize", blksize);
+	if (opts & 2) option(&b, "tsize", size);
+	if (opts & 4) option(&b, tname, timeout);
+	if (opts & 8) option(&b, wname, window);
+	s->oack = opts != 0; s->option_size = b.n;
+	tftp_window(h, s);
+	return;
+bad_options:
+	tftp_error(h, node, port, 8, "bad options");
+}
+
+static void
+tftp_request(struct mi8_hostsvc *h, uint32_t node, uint32_t port, const uint8_t *p, unsigned n)
+{
+	struct tftp *s = NULL;
+	unsigned op, block, i;
+	if (n < 2) { tftp_error(h, node, port, 4, "short opcode"); return; }
+	op = getbe16(p);
+	if (op == 1 || op == 2) { tftp_open(h, node, port, p, n, op == 2); return; }
+	for (i = 0; i < SESSIONS; i++) if (h->sessions[i].live && h->sessions[i].node == node && h->sessions[i].port == port) {
+		s = &h->sessions[i]; break;
+	}
+	if (op == 5) { if (s) s->live = false; return; }
+	if (!s) { tftp_error(h, node, port, 5, "unknown transfer"); return; }
+	if (n < 4 || (op == 4 && n != 4)) { tftp_error(h, node, port, 4, "short block"); return; }
+	block = getbe16(p + 2);
+	if (op == 4 && !s->write) {
+		uint64_t ack;
+		LOG(h, LOG_OTHER, "mi8hs: tftp ack file=%s block=%u\n", s->path, block);
+		if (s->oack) {
+			if (block) return;
+			s->oack = false; tftp_window(h, s); return;
+		}
+		if (s->done) return;
+		for (ack = s->acked; ack <= s->sent; ack++) if ((ack & 65535) == block) break;
+		if (ack > s->sent) return;
+		s->acked = ack;
+		if (ack == s->final) s->done = true;
+		else tftp_window(h, s);
+	} else if (op == 3 && s->write) {
+		if (n - 4 > s->blocksize) { tftp_error(h, node, port, 4, "oversized DATA"); return; }
+		if (!s->done && block == ((s->acked + 1) & 65535)) {
+			s->acked++; s->dropped += n - 4; s->done = n - 4 < s->blocksize;
+		}
+		LOG(h, LOG_WRQ, "mi8hs: tftp wrq file=%s dropped %llu bytes\n", s->path, (unsigned long long)s->dropped);
+		tftp_ack(h, s);
+	} else tftp_error(h, node, port, 4, "unexpected opcode");
+}
+
+static void
+receive(void *ctx, uint32_t node, uint32_t port, const void *data, size_t n)
+{
+	struct endpoint *e = ctx;
+	struct mi8_hostsvc *h = e->h;
+	struct pending *p;
+	if (!h->started) return;
+	if (!n || n > MAX_REQUEST || h->queued == 64) { LOG(h, LOG_ERROR, "mi8hs: ERROR request queue or length\n"); return; }
+	p = MI8_ALLOC(sizeof(*p) + n);
+	if (!p) { LOG(h, LOG_ERROR, "mi8hs: ERROR request allocation\n"); return; }
+	p->next = NULL; p->node = node; p->port = port; p->kind = e->kind; p->length = (unsigned)n;
+	memcpy(p->bytes, data, n);
+	if (h->last) h->last->next = p; else h->first = p;
+	h->last = p; h->queued++;
+	/* GLINK send may pump another request before the current response is sent. */
+	if (h->dispatching) return;
+	h->dispatching = true;
+	while ((p = h->first) != NULL) {
+		h->first = p->next; if (!h->first) h->last = NULL;
+		if (p->kind == 1) tftp_request(h, p->node, p->port, p->bytes, p->length);
+		else qmi_request(h, p->kind, p->node, p->port, p->bytes, p->length);
+		h->queued--;
+		MI8_FREE(p, sizeof(*p) + p->length);
+	}
+	h->dispatching = false;
+}
+
+struct mi8_hostsvc *
+mi8_hostsvc_create(const struct mi8_hostsvc_cfg *cfg)
+{
+	struct mi8_hostsvc *h;
+	unsigned i, j;
+	if (!cfg || !cfg->qrtr || !cfg->qrtr->open || !cfg->qrtr->send || !cfg->qrtr->close || !cfg->publish ||
+	    !cfg->part_size || !cfg->part_read || !cfg->file_size || !cfg->file_read || !cfg->rmtfs_virt ||
+	    !cfg->rmtfs_size || cfg->rmtfs_phys > UINT64_MAX - cfg->rmtfs_size || (!cfg->domains && cfg->n_domains)) return NULL;
+	h = MI8_ALLOC(sizeof(*h));
+	if (!h) return NULL;
+	memset(h, 0, sizeof(*h)); h->cfg = *cfg;
+	if (!cfg->domains) { h->cfg.domains = mi8_hostsvc_sdm845_domains; h->cfg.n_domains = mi8_hostsvc_sdm845_n_domains; }
+	if (h->cfg.n_domains > 65535) goto bad;
+	for (i = 0; i < h->cfg.n_domains; i++) {
+		const struct mi8_pd_domain *d = &h->cfg.domains[i];
+		if (!d->name || !*d->name || strlen(d->name) > 64 || (!d->services && d->n_services)) goto bad;
+		for (j = 0; j < d->n_services; j++) if (!d->services[j] || !*d->services[j] || strlen(d->services[j]) > 64) goto bad;
+	}
+	for (i = 0; i < 3; i++) { h->endpoints[i].h = h; h->endpoints[i].kind = i; }
+	return h;
+bad:
+	MI8_FREE(h, sizeof(*h)); return NULL;
+}
+
+int
+mi8_hostsvc_start(struct mi8_hostsvc *h)
+{
+	static const uint32_t services[3] = { 14, 4096, 64 }, instances[3] = { 1, 0, 1 };
+	unsigned i;
+	int error;
+	if (!h) return HS_INVAL;
+	if (h->started) return HS_ALREADY;
+	for (i = 0; i < 3; i++) {
+		h->endpoints[i].port = h->cfg.qrtr->open(receive, NULL, &h->endpoints[i]);
+		if (!h->endpoints[i].port) { error = HS_NOMEM; goto fail; }
+	}
+	h->started = true;
+	for (i = 0; i < 3; i++) {
+		error = h->cfg.publish(h->cfg.ctx, h->endpoints[i].port, services[i], 1, instances[i]);
+		if (error) { LOG(h, LOG_ERROR, "mi8hs: publish failed service=%u errno=%d\n", services[i], error); goto fail; }
+		LOG(h, LOG_OTHER, "mi8hs: published service %u\n", services[i]);
+	}
+	return 0;
+fail:
+	mi8_hostsvc_stop(h);
+	return error;
+}
+
+void
+mi8_hostsvc_stop(struct mi8_hostsvc *h)
+{
+	unsigned i;
+	struct pending *p;
+	if (!h) return;
+	/* Close is the transport's callback barrier; free state only after all ports close. */
+	for (i = 0; i < 3; i++) if (h->endpoints[i].port) {
+		h->cfg.qrtr->close(h->endpoints[i].port); h->endpoints[i].port = NULL;
+	}
+	h->started = false;
+	for (i = 0; i < PARTS; i++) if (h->partitions[i].data) {
+		MI8_FREE(h->partitions[i].data, h->partitions[i].size);
+		h->partitions[i].data = NULL; h->partitions[i].size = 0;
+	}
+	for (i = 0; i < CACHES; i++) {
+		struct replay *c = &h->replays[i];
+		if (c->request) MI8_FREE(c->request, c->request_size);
+		if (c->response) MI8_FREE(c->response, c->response_size);
+	}
+	while ((p = h->first) != NULL) { h->first = p->next; MI8_FREE(p, sizeof(*p) + p->length); }
+	h->last = NULL; h->queued = 0;
+	memset(h->handles, 0, sizeof(h->handles)); memset(h->replays, 0, sizeof(h->replays));
+	memset(h->sessions, 0, sizeof(h->sessions));
+}
+
+void
+mi8_hostsvc_destroy(struct mi8_hostsvc *h)
+{
+	if (h) { mi8_hostsvc_stop(h); MI8_FREE(h, sizeof(*h)); }
+}
