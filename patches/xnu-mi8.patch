+static unsigned le16(const uint8_t *p) { return p[0] | (unsigned)p[1] << 8; }
+/* The shared helper does not check reply peer/message or mandatory TLVs. */
+static bool frame_ok(const uint8_t *p, size_t n)
+{
+	bool seen[256] = { false };
+	size_t off = 7;
+	if (n < 7 || le16(p + 5) != n - 7) return false;
+	while (off < n) {
+		unsigned len, type;
+		if (n - off < 3) return false;
+		type = p[off]; len = le16(p + off + 1); off += 3;
+		if (len > n - off || seen[type]) return false;
+		seen[type] = true;
+		if (p[0] == QMI_RESPONSE && type == 2 && len != 4) return false;
+		off += len;
+	}
+	return p[0] != QMI_RESPONSE || seen[2];
+}
+static void bridge_receive(void *ctx, uint32_t node, uint32_t port, const void *data, size_t n)
+{
+	struct mi8_wlfw *w = ctx;
+	const uint8_t *p = data;
+	bool take;
+	unsigned rejected, ind_count = 0, ind_msg = 0;
+	LOCK(&w->lock);
+	take = w->present && node == w->node && port == w->port && n <= 8192 && frame_ok(p, n);
+	if (take && p[0] == QMI_RESPONSE)
+		take = w->pending && le16(p + 1) == w->pending_id && le16(p + 3) == w->pending_msg;
+	else if (take)
+		take = p[0] == QMI_INDICATION && n == 7 &&
+		    (le16(p + 3) == QMI_WLFW_FW_READY_IND_V01 || le16(p + 3) == QMI_WLFW_MSA_READY_IND_V01);
+	if (take && p[0] == QMI_INDICATION) {
+		ind_msg = le16(p + 3);
+		ind_count = ++w->indication_logs[ind_msg == QMI_WLFW_FW_READY_IND_V01];
+	}
+	rejected = take ? 0 : ++w->rejected;
+	UNLOCK(&w->lock);
