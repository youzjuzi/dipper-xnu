+/* A completed fence alone is not ownership: another submission may name the same pixels. */
+bool
+MiniIOSurfaceBeginDisplay(MiniIOSurface ** surfaces, unsigned count, uint64_t milliseconds)
+{
+	uint64_t began = mach_absolute_time(), patience;
+
+	if (gGPULock == NULL) {
+		for (unsigned i = 0; i < count; i++) {
+			if (surfaces[i] != NULL && surfaces[i]->drawn != 0) {
+				return false;
+			}
+		}
+		return true;
+	}
+	nanoseconds_to_absolutetime(milliseconds * NSEC_PER_MSEC, &patience);
+	IOLockLock(gGPULock);
+	for (;;) {
+		bool complete = true;
+
+		for (unsigned i = 0; i < count; i++) {
+			uint32_t fence = surfaces[i] != NULL ? surfaces[i]->drawn : 0;
+
+			if (fence != 0) {
+				if (!redwood_gpu_ready() || gGPUReported) {
+					IOLockUnlock(gGPULock);
+					return false;
+				}
+				complete &= redwood_gpu_done(fence);
+			}
+		}
+		if (complete) {
+			for (unsigned i = 0; i < count; i++) {
+				if (surfaces[i] != NULL) {
+					surfaces[i]->displayReaders++;
+				}
+			}
+			IOLockUnlock(gGPULock);
+			return true;
+		}
+		if (mach_absolute_time() - began >= patience) {
+			IOLockUnlock(gGPULock);
+			return false;
+		}
+		IOLockUnlock(gGPULock);
+		delay_for_interval(GPU_ASK_AGAIN_US, NSEC_PER_USEC);
+		IOLockLock(gGPULock);
+		/* Recheck every latest fence: a submit may have happened while the lock was released. */
+	}
+}
