+static int say(const char *format, ...) __printflike(1, 2);
+
+/* to the loader's log at once as well, as redwood_buttons.c does */
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
