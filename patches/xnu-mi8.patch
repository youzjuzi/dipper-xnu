+	w->info.build_valid = resp.fw_build_id_valid;
+	w->info.chip_id = resp.chip_info_valid ? resp.chip_info.chip_id : 0xff;
+	w->info.chip_family = resp.chip_info.chip_family;
+	w->info.board_id = resp.board_info_valid ? resp.board_info.board_id : 0xff;
+	w->info.soc_id = resp.soc_info.soc_id; w->info.fw_version = resp.fw_version_info.fw_version;
+	memcpy(w->info.fw_build_id, resp.fw_build_id, sizeof(w->info.fw_build_id));
+	memcpy(w->info.fw_build_timestamp, resp.fw_version_info.fw_build_timestamp, sizeof(w->info.fw_build_timestamp));
