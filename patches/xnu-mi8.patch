+	if (!take && n >= 7 && p[0] == QMI_INDICATION && node == w->node && port == w->port) {
+		char hex[3 * 24 + 1];
+		unsigned k, m = n < 24 ? (unsigned)n : 24;
+		for (k = 0; k < m; k++) snprintf(hex + 3 * k, 4, "%02x ", p[k]);
+		LOG(w, "other indication id=0x%x n=%lu: %s\n", le16(p + 3), (unsigned long)n, hex);
+		return;
+	}
+	if (!take) {
+		if (log_n(rejected))
