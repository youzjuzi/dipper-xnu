+/* ---- boot-arg bcl_watch=N (EXP-0164): the PMI8998's battery current limit block, read only ----------- */
+
+/*
+ * BCL (downstream msm-4.9 bcl_peripheral.c, "qcom,bcl-v4", PMI8998 0x4200 [待验证]): when the battery's voltage drops or
+ * its current rises past a threshold it raises an interrupt that the limits hardware can act on at once -- the suspect
+ * for the big cores' halved clock under load (U-078). Once a second, N times: the interrupt status (0x10 real time,
+ * 0x18 latched) and the lowest battery voltage / highest current it has seen (0x5c VBAT_MIN, 0x5d IBAT_MAX; scaled
+ * 39 mV and 80 mA a step in that driver [待验证]); the first time all of 0x00-0xff, afterwards what changed. No writes.
+ */
+static struct peripheral bcl = { .name = "the PMI8998's BCL", .id = 0x242 };
+
+static void
+bcl_watch(uint32_t seconds, uint32_t channels)
+{
+	uint8_t now[256], was[256];
+	bool first = true;
+
+	find_channel(&bcl, channels);
+	if (!bcl.found) {
+		bcl.id = 0x342;
+		find_channel(&bcl, channels);
+	}
+	if (!bcl.found) {
+		say("bcl: no channel\n");
+		return;
+	}
+	for (uint32_t t = 0; t < seconds; t++) {
+		char line[700];
+		int n;
+		uint64_t ns;
+
+		for (uint32_t reg = 0; reg < 256; reg += 8) {
+			if (spmi_read(&bcl, (uint8_t)reg, now + reg, 8) != NULL) {
+				memset(now + reg, 0xee, 8);
+			}
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		n = snprintf(line, sizeof(line), "bcl: t=%llu s (%#x) rt %#x latched %#x vbat_min %#x ibat_max %#x%s",
+		    ns / NSEC_PER_SEC, bcl.id, now[0x10], now[0x18], now[0x5c], now[0x5d], first ? " all:" : " changed:");
+		for (uint32_t reg = 0; reg < 256 && n < (int)sizeof(line) - 16; reg++) {
+			if (first ? (now[reg] != 0 && now[reg] != 0xee) : now[reg] != was[reg]) {
+				n += snprintf(line + n, sizeof(line) - (size_t)n, " %x=%x", reg, now[reg]);
+			}
+		}
+		say("%s\n", line);
+		memcpy(was, now, sizeof(was));
+		first = false;
+		wait_ms(1000);
+	}
+}
