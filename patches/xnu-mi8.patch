+/* The host services (TASK-005) with the kernel's allocator; the service source takes its allocator from the includer. */
+#include <kern/kalloc.h>
+#include <sys/errno.h>
+#define MI8_ALLOC(n)    kalloc_data((n), Z_WAITOK | Z_ZERO)
+#define MI8_FREE(p, n)  kfree_data((p), (n))
+/* the kernel has no memchr */
+static void *
+mi8_memchr(const void *s, int c, size_t n)
+{
+	const unsigned char *p = s;
+
+	for (; n != 0; n--, p++) {
+		if (*p == (unsigned char)c) {
+			return (void *)(uintptr_t)p;
+		}
+	}
+	return NULL;
+}
