diff --git a/tools/BootShim/BootShim.S b/tools/BootShim/BootShim.S
index f6fe3624a69f3df3b5b090f8dd1553abc94f695d..7feea4e0d06f37e8e8bcb27795e7ce7efa46bf90 100644
--- a/tools/BootShim/BootShim.S
+++ b/tools/BootShim/BootShim.S
@@ -55,6 +55,27 @@ _CopyLoop:
 	stp	x2, x3, [x5], #16
 	subs	x6, x6, #16
 	b.ne	_CopyLoop
+
+#ifdef PAYLOAD_BASE
+	/* x4 now points just past the FD: an optional "XNUP" payload (HackiOS kernel container) may follow */
+	ldr	w2, [x4]
+	movz	w3, #0x4E58
+	movk	w3, #0x5055, lsl #16
+	cmp	w2, w3
+	b.ne	_NoPayload
+	ldr	w6, [x4, #4]	/* Payload Size */
+	add	x6, x6, #23	/* Header + round up to 16 */
+	and	x6, x6, #~15
+	movz	x5, #(PAYLOAD_BASE >> 16), lsl #16
+
+_PayloadLoop:
+	ldp	x2, x3, [x4], #16
+	stp	x2, x3, [x5], #16
+	subs	x6, x6, #16
+	b.ne	_PayloadLoop
+
+_NoPayload:
+#endif
 	ldr	x5, _StackBase
 
 _Entry:
diff --git a/tools/BootShim/Makefile b/tools/BootShim/Makefile
index e2b69c7d2b2d065646c28e8790dcc61eb9dafee9..fdf857840c636bc41b24f7c8f1feaea5d8dbac01 100755
--- a/tools/BootShim/Makefile
+++ b/tools/BootShim/Makefile
@@ -3,6 +3,8 @@ TARGET            = aarch64-linux-gnu
