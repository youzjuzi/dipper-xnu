 CC                = $(CROSS_COMPILE)gcc
 OBJCOPY           = $(CROSS_COMPILE)objcopy
+# where the shim leaves an "XNUP" payload that follows the FD (ignored when none is appended)
+PAYLOAD_BASE     ?= 0xF0000000
 
 all: BootShim.elf BootShim.bin BootShim.Dualboot.elf BootShim.Dualboot.bin
 
@@ -10,7 +12,7 @@ BootShim.bin: BootShim.elf
 	$(OBJCOPY) -O binary $< $@
 
 BootShim.elf: BootShim.S
-	$(CC) -c $< -o $@ -DUEFI_BASE=$(UEFI_BASE) -DUEFI_SIZE=$(UEFI_SIZE)
+	$(CC) -c $< -o $@ -DUEFI_BASE=$(UEFI_BASE) -DUEFI_SIZE=$(UEFI_SIZE) -DPAYLOAD_BASE=$(PAYLOAD_BASE)
 
 BootShim.Dualboot.bin: BootShim.Dualboot.elf
 	$(OBJCOPY) -O binary $< $@
