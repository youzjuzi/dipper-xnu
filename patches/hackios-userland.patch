+/* ---- backboardd: the display's brightness -------------------------------------------------------- */
+
+/*
+ * The brightness slider reaches backboardd, which hands the value to CoreBrightness's brightness system
+ * ("[Backlight] Set BrightnessSystem property:DisplayBrightness to:{ Brightness: 0.33, ... }", EXP-0139); with no
+ * display it knows how to drive, it goes no further. Take it there: -[BrightnessSystem setProperty:forKey:] as it is,
+ * and for "DisplayBrightness" the Brightness (0 to 1, the slider's own scale) as the panel's level, 2 to 1023, into
+ * the kernel (sysctl kern.mi8_brightness, which sends the panel DCS 0x51: bsd/dev/mi8_adreno.c). The slider's scale is
+ * perceptual and the panel's roughly linear in light: squared on the way.
+ */
+typedef id (*set_property_t)(id self, SEL selector, id property, id key);
+static set_property_t orig_set_property;
+
+/*
+ * The screen's light is two things in iOS's brightness system: the level the slider sets (DisplayBrightness) and the
+ * factor the lock puts on it (DisplayBrightnessFactor, and ...WithFade: 0 when the phone is locked or dimmed off, 1
+ * otherwise; the fade is not followed). The panel gets the level, or 0 -- display off -- under a factor of 0 (EXP-0142).
+ */
+static float brightness_level = 0.5f, brightness_factor = 1.0f;
+static int brightness_sent = -1;
+
+static void
+brightness_send(void)
+{
+	int level = brightness_factor <= 0 ? 0 : 2 + (int)lroundf(1021.0f * brightness_level * brightness_level);
+
+	if (level != brightness_sent && sysctlbyname("kern.mi8_brightness", NULL, NULL, &level, sizeof(level)) == 0) {
+		brightness_sent = level;
+	} else if (level != brightness_sent) {
+		say("redwood: brightness %.3f x %.3f -> level %d: the kernel did not take it (errno %d)\n", brightness_level,
+		    brightness_factor, level, errno);
+	}
+}
+
+static id
+my_set_property(id self, SEL selector, id property, id key)
+{
+	id result = orig_set_property(self, selector, property, key);
+
+	if (key != NULL && property != NULL && CFGetTypeID((CFTypeRef)key) == CFStringGetTypeID()) {
+		float number = -1;
+
+		if (CFStringCompare((CFStringRef)key, CFSTR("DisplayBrightness"), 0) == kCFCompareEqualTo &&
+		    CFGetTypeID((CFTypeRef)property) == CFDictionaryGetTypeID()) {
+			CFNumberRef value = CFDictionaryGetValue((CFDictionaryRef)property, CFSTR("Brightness"));
+
+			if (value != NULL && CFGetTypeID(value) == CFNumberGetTypeID() &&
+			    CFNumberGetValue(value, kCFNumberFloatType, &number) && number >= 0 && number <= 1) {
+				brightness_level = number;
+				brightness_send();
+			}
+		} else if ((CFStringCompare((CFStringRef)key, CFSTR("DisplayBrightnessFactor"), 0) == kCFCompareEqualTo ||
+		    CFStringCompare((CFStringRef)key, CFSTR("DisplayBrightnessFactorWithFade"), 0) == kCFCompareEqualTo) &&
+		    CFGetTypeID((CFTypeRef)property) == CFNumberGetTypeID() &&
+		    CFNumberGetValue((CFNumberRef)property, kCFNumberFloatType, &number) && number >= 0 && number <= 1) {
+			brightness_factor = number;
+			brightness_send();
+		}
+	}
+	return result;
+}
+
+/* CoreBrightness may not be loaded when this library starts: look again until it is (half a minute at the most). */
+static void
+brightness_bridge(int tries)
+{
+	Class cls = objc_getClass("BrightnessSystem");
+	Method method = cls ? class_getInstanceMethod(cls, sel_registerName("setProperty:forKey:")) : NULL;
+
+	if (method == NULL) {
+		if (tries < 60) {
+			dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 500 * NSEC_PER_MSEC), dispatch_get_global_queue(0, 0), ^{
+				brightness_bridge(tries + 1);
+			});
+		} else {
+			say("redwood: brightness: no -[BrightnessSystem setProperty:forKey:]: the slider stays without effect\n");
+		}
+		return;
+	}
+	orig_set_property = (set_property_t)method_setImplementation(method, (IMP)my_set_property);
+	say("redwood: brightness: the brightness system's display brightness goes to the panel (after %d looks)\n", tries + 1);
+}
