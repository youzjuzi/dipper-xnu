+/*
+ * The Wi-Fi bars of the status bar are drawn by UIKit's signal view (_UIStatusBarWifiSignalView, of the base class
+ * _UIStatusBarSignalView), whose "signal mode" says how: 0 inactive (every bar grey), 1 searching, 2 active (the bars that
+ * count dark). The cellular view stays inactive here for want of CommCenter (hakios, upstream, replaces its setSignalMode:);
+ * the Wi-Fi view is fed by wifid's link-quality events, and with the radio joined and en0 given an address it is still grey
+ * (EXP-0221..0230). So, while en0 has an IPv4 address, the Wi-Fi view is made active -- and what it is asked, and how many
+ * bars it is told, is said in the log once each, to see what the system itself wanted (EXP-0231).
+ */
+static bool wifi_has_address(void);
+extern id objc_loadWeak(id *location);
+extern id objc_storeWeak(id *location, id obj);
+static void (*original_wifi_signal_mode)(id self, SEL sel, long mode);
+static void (*original_wifi_active_bars)(id self, SEL sel, long bars);
+static long (*original_bar_count)(id self, SEL sel, id update);
+
+static long
+wifi_bar_count(id self, SEL sel, id update)
+{
+	static unsigned said;
+	long count = original_bar_count(self, sel, update);
+
+	if (said < 6) {
+		said++;
+		say("redwood: wifi: the item counts %ld bars (address %s)\n", count, wifi_has_address() ? "there" : "not there");
+	}
+	return count < 3 && wifi_has_address() ? 3 : count;
+}
+
+static bool
+wifi_has_address(void)
+{
+	static time_t checked;
+	static bool has;
+	time_t now = time(NULL);
+	struct ifaddrs *list = NULL, *a;
+
+	if (now == checked) {
+		return has;
+	}
+	checked = now;
+	has = false;
+	if (getifaddrs(&list) == 0) {
+		for (a = list; a != NULL; a = a->ifa_next) {
+			if (a->ifa_addr != NULL && a->ifa_addr->sa_family == AF_INET && strcmp(a->ifa_name, "en0") == 0) {
+				has = true;
+			}
+		}
+		freeifaddrs(list);
+	}
+	return has;
+}
+
+static void
+wifi_set_signal_mode(id self, SEL sel, long mode)
+{
+	static unsigned said_modes;
+	const char *name = object_getClassName(self);
+	bool wifi = name != NULL && strstr(name, "Wifi") != NULL;
+	long wanted = mode;
+
+	if (wifi && mode >= 0 && mode < 8 && !(said_modes & (1u << mode))) {
+		said_modes |= 1u << mode;
+		say("redwood: wifi: %s asked for signal mode %ld\n", name, mode);
+	}
+	if (wifi && mode != 2 && wifi_has_address()) {
+		wanted = 2;
+	}
+	original_wifi_signal_mode(self, sel, wanted);
+}
+
+static void
+wifi_set_active_bars(id self, SEL sel, long bars)
+{
+	static unsigned said_bars;
+	const char *name = object_getClassName(self);
+
+	bool wifi = name != NULL && strstr(name, "Wifi") != NULL;
+
+	if (wifi && bars >= 0 && bars < 8 && !(said_bars & (1u << bars))) {
+		said_bars |= 1u << bars;
+		say("redwood: wifi: %s told %ld active bars\n", name, bars);
+	}
+	if (wifi && bars < 3 && wifi_has_address()) {
+		bars = 3;
+	}
+	original_wifi_active_bars(self, sel, bars);
+}
+
+
+/* what the Wi-Fi bars' classes offer (names only), once: to find the method that really sets their look (EXP-0232) */
+static void
+wifi_classes_dump(void)
+{
+	unsigned count = 0, i;
+	Class *list = objc_copyClassList(&count);
+
+	for (i = 0; i < count; i++) {
+		const char *name = class_getName(list[i]);
+
+		if (name != NULL && (strstr(name, "StatusBarWifi") != NULL || strcmp(name, "_UIStatusBarSignalView") == 0)) {
+			unsigned n = 0, m;
+			Method *methods = class_copyMethodList(list[i], &n);
+			char line[1100];
+			size_t used = (size_t)snprintf(line, sizeof(line), "redwood: wifi: class %s (super %s):", name,
+			    class_getSuperclass(list[i]) ? class_getName(class_getSuperclass(list[i])) : "-");
+
+			for (m = 0; m < n && used < sizeof(line) - 80; m++) {
+				used += (size_t)snprintf(line + used, sizeof(line) - used, " %s", sel_getName(method_getName(methods[m])));
+			}
+			say("%s\n", line);
+			free(methods);
+		}
+	}
+	free(list);
+}
+
+
+/*
+ * The views as they are, not as they are told (EXP-0233): on the home screen the Wi-Fi icon is all dim while the control
+ * centre's own status bar draws it bright, so the data is right and the home screen's view did not take it (an update that
+ * never came, or its own mode). Every _UIStatusBarWifiSignalView that gets a window is kept (weakly), and once a second, with
+ * en0 given an address, each is set active with 3 bars; what it had is said in the log (a few times).
+ */
+#define WIFI_VIEWS 12
+static id wifi_views[WIFI_VIEWS];
+static void (*original_wifi_move_to_window)(id self, SEL sel);
+
+static void
+wifi_view_move_to_window(id self, SEL sel)
+{
+	bool known = false;
+	unsigned i;
+
+	original_wifi_move_to_window(self, sel);
+	for (i = 0; i < WIFI_VIEWS; i++) {
+		known |= objc_loadWeak(&wifi_views[i]) == self;
+	}
+	for (i = 0; i < WIFI_VIEWS && !known; i++) {
+		if (objc_loadWeak(&wifi_views[i]) == NULL) {
+			objc_storeWeak(&wifi_views[i], self);
+			known = true;
+		}
+	}
+}
+
+static void
+wifi_views_tick(void)
+{
+	static unsigned said;
+	unsigned i, alive = 0;
+	bool address = wifi_has_address();
+
+	for (i = 0; i < WIFI_VIEWS; i++) {
+		id view = objc_loadWeak(&wifi_views[i]);
+
+		if (view == NULL) {
+			continue;
+		}
+		alive++;
+		if (said < 8) {
+			long mode = ((long (*)(id, SEL))objc_msgSend)(view, sel_registerName("signalMode"));
+			long bars = ((long (*)(id, SEL))objc_msgSend)(view, sel_registerName("numberOfActiveBars"));
+			long total = ((long (*)(id, SEL))objc_msgSend)(view, sel_registerName("numberOfBars"));
+
+			said++;
+			say("redwood: wifi: view %p: mode %ld, %ld of %ld bars, address %s\n", (void *)view, mode, bars, total, address ? "there" : "not there");
+		}
+		if (address && original_wifi_active_bars != NULL && original_wifi_signal_mode != NULL) {
+			original_wifi_signal_mode(view, sel_registerName("setSignalMode:"), 2);
+			original_wifi_active_bars(view, sel_registerName("setNumberOfActiveBars:"), 3);
+		}
+	}
+	if (said < 8 && alive == 0) {
+		said++;
+		say("redwood: wifi: no Wi-Fi signal view with a window yet\n");
+	}
+}
+
+static void
+wifi_signal_view_hook(void)
+{
+	static const char *const classes[] = { "_UIStatusBarWifiSignalView", "_UIStatusBarSignalView" };
+	static int tries;
+	bool done = false;
+
+	for (unsigned c = 0; c < sizeof(classes) / sizeof(classes[0]) && !done; c++) {
+		Class cls = objc_getClass(classes[c]);
+		Method mode = cls ? class_getInstanceMethod(cls, sel_registerName("setSignalMode:")) : NULL;
+		Method bars = cls ? class_getInstanceMethod(cls, sel_registerName("setNumberOfActiveBars:")) : NULL;
+
+		if (mode != NULL) {
+			original_wifi_signal_mode = (void (*)(id, SEL, long))method_getImplementation(mode);
+			method_setImplementation(mode, (IMP)wifi_set_signal_mode);
+			say("redwood: wifi: -[%s setSignalMode:] replaced (types \"%s\")\n", classes[c], method_getTypeEncoding(mode));
+			done = true;
+		}
+		if (bars != NULL) {
+			original_wifi_active_bars = (void (*)(id, SEL, long))method_getImplementation(bars);
+			method_setImplementation(bars, (IMP)wifi_set_active_bars);
+			say("redwood: wifi: -[%s setNumberOfActiveBars:] replaced\n", classes[c]);
+		}
+	}
+	if (done) {
+		Class wifi_view = objc_getClass("_UIStatusBarWifiSignalView");
+		Method move = wifi_view ? class_getInstanceMethod(wifi_view, sel_registerName("didMoveToWindow")) : NULL;
+		static dispatch_source_t timer;
+
+		if (move != NULL && original_wifi_move_to_window == NULL) {
+			original_wifi_move_to_window = (void (*)(id, SEL))method_getImplementation(move);
+			method_setImplementation(move, (IMP)wifi_view_move_to_window);
+		}
+		if (timer == NULL) {
+			timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
+			dispatch_source_set_timer(timer, dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC), NSEC_PER_SEC, NSEC_PER_SEC / 10);
+			dispatch_source_set_event_handler(timer, ^{
+				wifi_views_tick();
+			});
+			dispatch_resume(timer);
+		}
+	}
+	if (done) {
+		Class item = objc_getClass("_UIStatusBarWifiItem");
+		Method count = item ? class_getInstanceMethod(item, sel_registerName("_barCountForUpdate:")) : NULL;
+
+		if (count != NULL) {
+			original_bar_count = (long (*)(id, SEL, id))method_getImplementation(count);
+			method_setImplementation(count, (IMP)wifi_bar_count);
+			say("redwood: wifi: -[_UIStatusBarWifiItem _barCountForUpdate:] replaced (types \"%s\")\n", method_getTypeEncoding(count));
+		}
+	}
+	if (!done && tries++ < 6) {
+		/* UIKit's classes may not be there yet: look again soon */
+		dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+			wifi_signal_view_hook();
+		});
+	} else if (!done) {
+		say("redwood: wifi: no signal view class found\n");
+	}
+}
+
+/*
+ * The status bar at a screen UIKit has no layout for (fbscale=2: the iPhone X's 375 x 812 points at two pixels a point). UIKit asks
+ * which "visual provider" draws the bar on this screen, finds none and puts up its fallback, a red bar that says "rdar:45025538". The
+ * fallback is made the iPhone X's provider: the class methods of the split provider are copied onto the fallback's metaclass, and
+ * the fallback's alloc makes an instance of the split class. (Replacing the answer of +visualProviderSubclassForScreen:... alone does
+ * not do it: the fallback is made on another path too.)
+ */
+static void
+status_bar_fallback_hook(void)
+{
+	static int tries;
+	static Class split_class;
+	Class fallback = objc_getClass("_UIStatusBarVisualProvider_Fallback");
+	Class split = objc_getClass("_UIStatusBarVisualProvider_Split1125");
+
+	if (fallback == NULL || split == NULL) {
+		if (tries++ < 6) {
+			dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+				status_bar_fallback_hook();
+			});
+			return;
+		}
+		unsigned count = 0;
+		Class *all = objc_copyClassList(&count);
+
+		say("redwood: status bar: no %s: the provider classes are:", fallback == NULL ? "fallback provider" : "split provider 1125");
+		for (unsigned i = 0; i < count; i++) {
+			const char *name = class_getName(all[i]);
+
+			if (strncmp(name, "_UIStatusBarVisualProvider", 26) == 0) {
+				say(" %s", name);
+			}
+		}
+		say("\n");
+		free(all);
+		return;
+	}
+	split_class = split;
+
+	/* the classes between the split provider and what it has in common with the fallback, base first so that the derived one wins */
+	Class chain[8];
+	unsigned depth = 0, copied = 0;
+
+	for (Class c = split; c != NULL && depth < 8; c = class_getSuperclass(c)) {
+		bool shared = false;
+
+		for (Class f = fallback; f != NULL; f = class_getSuperclass(f)) {
+			if (f == c) {
+				shared = true;
+				break;
+			}
+		}
+		if (shared) {
+			break;
+		}
+		chain[depth++] = c;
+	}
+	Class meta = object_getClass(fallback);
+
+	for (unsigned i = depth; i > 0; i--) {
+		unsigned count = 0;
+		Method *methods = class_copyMethodList(object_getClass(chain[i - 1]), &count);
+
+		for (unsigned m = 0; m < count; m++) {
+			const char *name = sel_getName(method_getName(methods[m]));
+
+			if (strcmp(name, "load") == 0 || strcmp(name, "initialize") == 0 || strcmp(name, "alloc") == 0 ||
+			    strcmp(name, "allocWithZone:") == 0) {
+				continue;
+			}
+			class_replaceMethod(meta, method_getName(methods[m]), method_getImplementation(methods[m]),
+			    method_getTypeEncoding(methods[m]));
+			copied++;
+		}
+		free(methods);
+	}
+	class_replaceMethod(meta, sel_registerName("alloc"), imp_implementationWithBlock((id)^id(__unused id self) {
+		return ((id (*)(Class, SEL))objc_msgSend)(split_class, sel_registerName("alloc"));
+	}), "@16@0:8");
+	class_replaceMethod(meta, sel_registerName("allocWithZone:"), imp_implementationWithBlock((id)^id(__unused id self, void *zone) {
+		return ((id (*)(Class, SEL, void *))objc_msgSend)(split_class, sel_registerName("allocWithZone:"), zone);
