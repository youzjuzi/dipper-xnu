+/* ---- kev ----------------------------------------------------------------------------------------------- */
+
+/*
+ * EXP-0230: listen the way IO80211.framework does (a PF_SYSTEM kernel-event socket, class 6 = IEEE 802.11), and
+ * count the events by number for some seconds: do the link-quality events (39) reach user space?
+ */
+static void
+kev_look(double length)
+{
+	int fd = socket(PF_SYSTEM, SOCK_RAW, SYSPROTO_EVENT);
+	struct kev_request request = { .vendor_code = KEV_VENDOR_APPLE, .kev_class = 6, .kev_subclass = KEV_ANY_SUBCLASS };
+	unsigned counts[256] = { 0 }, sizes[256] = { 0 };
+	double start = seconds();
+	char buffer[4096];
+
+	if (fd < 0 || ioctl(fd, SIOCSKEVFILT, &request) != 0) {
+		printf("net_test: kev: no socket (%d)\n", errno);
+		return;
+	}
+	fcntl(fd, F_SETFL, O_NONBLOCK);
+	while (seconds() - start < length) {
+		ssize_t got = recv(fd, buffer, sizeof(buffer), 0);
+
+		if (got >= (ssize_t)sizeof(struct kern_event_msg)) {
+			struct kern_event_msg *message = (struct kern_event_msg *)buffer;
+
+			if (message->event_code < 256) {
+				counts[message->event_code]++;
+				sizes[message->event_code] = message->total_size;
+			}
+		} else {
+			usleep(100000);
+		}
+	}
+	for (unsigned code = 0; code < 256; code++) {
+		if (counts[code] != 0) {
+			printf("net_test: kev: event %u: %u times, %u bytes in all\n", code, counts[code], sizes[code]);
+		}
+	}
+	printf("net_test: kev: %.0f s listened\n", length);
+	close(fd);
+}
