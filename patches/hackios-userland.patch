+/*
+ * EXP-0220: configd starts about 160 s before the Mi 8's radio (en0) shows up, and does not make a network
+ * service for an interface that comes later [guess]. This ends configd; launchd starts it again when anything
+ * asks for it, and it reads the interfaces afresh. Only for finding out; the real fix is for the radio to be
+ * there when configd starts, or for configd to be told.
+ */
+static void
+restartconfd(void)
+{
+	int mib[4] = { CTL_KERN, KERN_PROC, KERN_PROC_ALL, 0 };
+	size_t size = 0;
+	struct kinfo_proc *list;
+	int killed = 0;
+	double start = seconds();
+
+	while (if_nametoindex("en0") == 0 && seconds() - start < 400) {
+		usleep(500000);
+	}
+	printf("net_test: restartconfd: en0 %s after %.1f s\n", if_nametoindex("en0") ? "is there" : "NOT there", seconds() - start);
+	sleep(5);
+	if (sysctl(mib, 3, NULL, &size, NULL, 0) != 0 || (list = malloc(size)) == NULL) {
+		printf("net_test: restartconfd: no process list\n");
+		return;
+	}
+	if (sysctl(mib, 3, list, &size, NULL, 0) == 0) {
+		for (size_t i = 0; i < size / sizeof(*list); i++) {
+			if (strcmp(list[i].kp_proc.p_comm, "configd") == 0 && kill(list[i].kp_proc.p_pid, SIGTERM) == 0) {
+				printf("net_test: restartconfd: configd %d ended\n", list[i].kp_proc.p_pid);
+				killed++;
+			}
+		}
+	}
+	free(list);
+	if (killed == 0) {
+		printf("net_test: restartconfd: no configd found\n");
+	}
+}
