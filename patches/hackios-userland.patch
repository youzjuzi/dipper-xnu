+		return false;
+	}
+	glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
+	scan_width = (GLsizei)width;
+	scan_height = (GLsizei)height;
+	say("redwood-gl: glscan: the frame is scaled by the GPU to %u x %u (%d bytes a row)\n", width, height, values[3]);
