+static void
+damage_added(struct image *image)
+{
+	GLint box[4];
+
+	if (!damage_on || !image->target || image->width < 1000 || image->height < 2000) {
+		return;
+	}
+	if (!glIsEnabled(GL_SCISSOR_TEST)) {
+		image->dmg_full = true;
+		return;
+	}
