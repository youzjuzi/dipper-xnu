+		image->dmg[0] = box[0];
+		image->dmg[1] = box[1];
+		image->dmg[2] = box[0] + box[2];
+		image->dmg[3] = box[1] + box[3];
+		image->dmg_any = true;
+	} else {
+		image->dmg[0] = box[0] < image->dmg[0] ? box[0] : image->dmg[0];
+		image->dmg[1] = box[1] < image->dmg[1] ? box[1] : image->dmg[1];
+		image->dmg[2] = box[0] + box[2] > image->dmg[2] ? box[0] + box[2] : image->dmg[2];
+		image->dmg[3] = box[1] + box[3] > image->dmg[3] ? box[1] + box[3] : image->dmg[3];
