+/*
+ * The views as they are, not as they are told (EXP-0233): on the home screen the Wi-Fi icon is all dim while the control
+ * centre's own status bar draws it bright, so the data is right and the home screen's view did not take it (an update that
+ * never came, or its own mode). Every _UIStatusBarWifiSignalView that gets a window is kept (weakly), and once a second, with
+ * en0 given an address, each is set active with 3 bars; what it had is said in the log (a few times).
+ */
+#define WIFI_VIEWS 12
+static id wifi_views[WIFI_VIEWS];
+static void (*original_wifi_move_to_window)(id self, SEL sel);
+
+static void
+wifi_view_move_to_window(id self, SEL sel)
+{
+	bool known = false;
+	unsigned i;
+
+	original_wifi_move_to_window(self, sel);
+	for (i = 0; i < WIFI_VIEWS; i++) {
+		known |= objc_loadWeak(&wifi_views[i]) == self;
+	}
+	for (i = 0; i < WIFI_VIEWS && !known; i++) {
+		if (objc_loadWeak(&wifi_views[i]) == NULL) {
+			objc_storeWeak(&wifi_views[i], self);
+			known = true;
+		}
+	}
+}
+
+static void
+wifi_views_tick(void)
+{
+	static unsigned said;
+	unsigned i, alive = 0;
+	bool address = wifi_has_address();
+
+	for (i = 0; i < WIFI_VIEWS; i++) {
+		id view = objc_loadWeak(&wifi_views[i]);
+
+		if (view == NULL) {
+			continue;
+		}
+		alive++;
+		if (said < 8) {
+			long mode = ((long (*)(id, SEL))objc_msgSend)(view, sel_registerName("signalMode"));
+			long bars = ((long (*)(id, SEL))objc_msgSend)(view, sel_registerName("numberOfActiveBars"));
+			long total = ((long (*)(id, SEL))objc_msgSend)(view, sel_registerName("numberOfBars"));
+
+			said++;
+			say("redwood: wifi: view %p: mode %ld, %ld of %ld bars, address %s\n", (void *)view, mode, bars, total, address ? "there" : "not there");
+		}
+		if (address && original_wifi_active_bars != NULL && original_wifi_signal_mode != NULL) {
+			original_wifi_signal_mode(view, sel_registerName("setSignalMode:"), 2);
+			original_wifi_active_bars(view, sel_registerName("setNumberOfActiveBars:"), 3);
+		}
+	}
+	if (said < 8 && alive == 0) {
+		said++;
+		say("redwood: wifi: no Wi-Fi signal view with a window yet\n");
+	}
+}
+
+static void
+wifi_signal_view_hook(void)
+{
+	static const char *const classes[] = { "_UIStatusBarWifiSignalView", "_UIStatusBarSignalView" };
+	static int tries;
+	bool done = false;
+
+	for (unsigned c = 0; c < sizeof(classes) / sizeof(classes[0]) && !done; c++) {
+		Class cls = objc_getClass(classes[c]);
+		Method mode = cls ? class_getInstanceMethod(cls, sel_registerName("setSignalMode:")) : NULL;
+		Method bars = cls ? class_getInstanceMethod(cls, sel_registerName("setNumberOfActiveBars:")) : NULL;
+
+		if (mode != NULL) {
+			original_wifi_signal_mode = (void (*)(id, SEL, long))method_getImplementation(mode);
+			method_setImplementation(mode, (IMP)wifi_set_signal_mode);
+			say("redwood: wifi: -[%s setSignalMode:] replaced (types \"%s\")\n", classes[c], method_getTypeEncoding(mode));
+			done = true;
+		}
+		if (bars != NULL) {
+			original_wifi_active_bars = (void (*)(id, SEL, long))method_getImplementation(bars);
+			method_setImplementation(bars, (IMP)wifi_set_active_bars);
+			say("redwood: wifi: -[%s setNumberOfActiveBars:] replaced\n", classes[c]);
+		}
+	}
+	if (done) {
+		Class wifi_view = objc_getClass("_UIStatusBarWifiSignalView");
+		Method move = wifi_view ? class_getInstanceMethod(wifi_view, sel_registerName("didMoveToWindow")) : NULL;
+		static dispatch_source_t timer;
+
+		if (move != NULL && original_wifi_move_to_window == NULL) {
+			original_wifi_move_to_window = (void (*)(id, SEL))method_getImplementation(move);
+			method_setImplementation(move, (IMP)wifi_view_move_to_window);
+		}
+		if (timer == NULL) {
+			timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
+			dispatch_source_set_timer(timer, dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC), NSEC_PER_SEC, NSEC_PER_SEC / 10);
+			dispatch_source_set_event_handler(timer, ^{
+				wifi_views_tick();
+			});
+			dispatch_resume(timer);
+		}
+	}
