+	uint64_t memsize = 0;
+	size_t length = sizeof(memsize);
+	vm_statistics64_data_t vm = {0};
+	mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
+	vm_size_t pagesize = 0;
+	host_t host = mach_host_self();
+	for (unsigned i = 0; i < 8; i++) strcpy(values[i], "?");
+	if (sysctlbyname("hw.memsize", &memsize, &length, NULL, 0) == 0 && length == sizeof(memsize))
+		snprintf(values[0], sizeof(values[0]), "%llu", (unsigned long long)memsize);
+	if (host_statistics64(host, HOST_VM_INFO64, (host_info64_t)&vm, &count) == KERN_SUCCESS && count >= HOST_VM_INFO64_COUNT) {
+		uint64_t pages[] = {vm.free_count, vm.active_count, vm.inactive_count,
+		    vm.wire_count, vm.compressor_page_count, vm.purgeable_count};
+		for (unsigned i = 0; i < 6; i++)
+			snprintf(values[i + 1], sizeof(values[i + 1]), "%llu", (unsigned long long)pages[i]);
+	}
+	if (host_page_size(host, &pagesize) == KERN_SUCCESS && pagesize)
+		snprintf(values[7], sizeof(values[7]), "%llu", (unsigned long long)pagesize);
+	mach_port_deallocate(mach_task_self(), host);
+	int n = snprintf(line, sizeof(line),
+	    "tl: mem %llu %s memsize=%s free=%s active=%s inactive=%s wired=%s compressed=%s purgeable=%s pagesize=%s\n",
+	    us, name, values[0], values[1], values[2], values[3], values[4], values[5], values[6], values[7]);
+	if (n < 0 || (size_t)n >= sizeof(line) || write(STDOUT_FILENO, line, (size_t)n) != n)
+		perror("rwtouch: mem");
+}
