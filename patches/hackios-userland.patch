+static int
+extension_has(const char *list, const char *name)
+{
+	size_t n = strlen(name);
+	if (list == NULL) return 0;
+	for (const char *p = list; (p = strstr(p, name)) != NULL; p += n)
+		if ((p == list || p[-1] == ' ') && (p[n] == 0 || p[n] == ' ')) return 1;
+	return 0;
+}
+
+int
+redwood_gl_surface_swizzle(struct redwood_gl *gl, unsigned kind)
+{
+	static const int channels[3][4] = {
+		{ GL_RED, GL_GREEN, GL_BLUE, GL_ALPHA },
+		{ GL_BLUE, GL_GREEN, GL_RED, GL_ALPHA },
+		{ GL_ALPHA, GL_RED, GL_GREEN, GL_BLUE }
+	};
+	if (kind > 2 || !gl->swizzle_supported) return 0;
+	while (glGetError() != 0) {}
+	for (unsigned i = 0; i < 4; i++)
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_R + i, channels[kind][i]);
+	return glGetError() == 0;
+}
+
+int
+redwood_gl_swizzle_supported(struct redwood_gl *gl)
+{
+	if (gl->swizzle_checked) return gl->swizzle_supported;
+	gl->swizzle_checked = 1;
+	const char *version = (const char *)glGetString(GL_VERSION);
+	const char *extensions = (const char *)glGetString(GL_EXTENSIONS);
+	int core = version != NULL && strncmp(version, "OpenGL ES ", 10) == 0 && version[10] >= '3' && version[10] <= '9';
+	if (!core && !extension_has(extensions, "GL_EXT_texture_swizzle") &&
+	    !extension_has(extensions, "GL_ARB_texture_swizzle")) return 0;
