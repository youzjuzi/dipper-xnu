+	/* the sliders' views are made with user interaction off (EXP-0140, boot-arg ccslider=0 leaves them so), so touches stop at their module's
+	 * container and the slider's own gesture recognizer never sees them: turn it on, and look again */
+	if (diag_fix && hit != NULL && diag_window_is_cc(self) && strcmp(object_getClassName(hit), "CCUIContentModuleContentContainerView") == 0) {
+		id subviews = SEND(id, hit, "subviews");
+		unsigned long count = subviews ? SEND(unsigned long, subviews, "count") : 0;
+		bool changed = false;
+
+		for (unsigned long i = 0; i < count; i++) {
+			id sub = SEND1(id, subviews, "objectAtIndex:", unsigned long, i);
+
+			if (strstr(object_getClassName(sub), "SliderView") != NULL && !SEND(BOOL, sub, "isUserInteractionEnabled")) {
+				SEND1(void, sub, "setUserInteractionEnabled:", BOOL, YES);
+				changed = true;
+				say("redwood: ccdiag: %s: user interaction turned on\n", object_getClassName(sub));
+			}
+		}
+		if (changed) {
+			hit = original_diag_hit_test(self, selector, point, event);
+		}
+	}
+	if (diag_log && hit != NULL && diag_window_is_cc(self) && diag_hits < 60) {
+		diag_hits++;
+		say("redwood: ccdiag: hit (%.0f,%.0f) in %s:\n", point.x, point.y, object_getClassName(self));
+		id view = hit;
+
+		for (int depth = 0; view != NULL && depth < 12; depth++, view = SEND(id, view, "superview")) {
+			id recognizers = SEND(id, view, "gestureRecognizers");
+			unsigned long count = recognizers ? SEND(unsigned long, recognizers, "count") : 0;
+			char kinds[200] = "";
+
+			for (unsigned long i = 0; i < count && i < 6; i++) {
+				id recognizer = SEND1(id, recognizers, "objectAtIndex:", unsigned long, i);
+
+				snprintf(kinds + strlen(kinds), sizeof(kinds) - strlen(kinds), " %s%s", object_getClassName(recognizer),
+				    SEND(BOOL, recognizer, "isEnabled") ? "" : "(off)");
+			}
+			say("redwood: ccdiag:   %*s%s interaction %d%s%s\n", depth, "", object_getClassName(view),
+			    SEND(BOOL, view, "isUserInteractionEnabled"), count ? " recognizers:" : "", kinds);
+		}
+		if (diag_trees < 6 && strcmp(object_getClassName(hit), "CCUIContentModuleContentContainerView") == 0) {
+			diag_trees++;
+			diag_tree(hit, 0);
+		}
+	}
+	return hit;
+}
+
+static void
+diag_set_state(id self, SEL selector, long state)
+{
+	id view = SEND(id, self, "view");
+	id window = view ? SEND(id, view, "window") : NULL;
+
+	if (diag_log && diag_window_is_cc(window) && diag_states < 200) {
+		diag_states++;
+		say("redwood: ccdiag: %s (on %s) state -> %ld\n", object_getClassName(self), object_getClassName(view), state);
+	}
+	original_diag_set_state(self, selector, state);
+}
+
+static void
+control_center_diag(const char *arguments)
+{
+	Class window = objc_getClass("UIWindow"), recognizer = objc_getClass("UIGestureRecognizer");
+	SEL hit = sel_registerName("hitTest:withEvent:"), set_state = sel_registerName("setState:");
+	Method hit_method = window ? class_getInstanceMethod(window, hit) : NULL;
+	Method state_method = recognizer ? class_getInstanceMethod(recognizer, set_state) : NULL;
+
+	diag_log = strstr(arguments, "ccdiag=1") != NULL;
+	diag_fix = strstr(arguments, "ccslider=0") == NULL;
+	if ((!diag_log && !diag_fix) || hit_method == NULL || state_method == NULL) {
+		return;
+	}
+	original_diag_hit_test = (id (*)(id, SEL, struct diag_point, id))method_getImplementation(hit_method);
+	class_replaceMethod(window, hit, (IMP)diag_hit_test, method_getTypeEncoding(hit_method));
+	original_diag_set_state = (void (*)(id, SEL, long))method_getImplementation(state_method);
+	method_setImplementation(state_method, (IMP)diag_set_state);
+	say("redwood: Control Center: sliders %s%s\n", diag_fix ? "made to take touches" : "left alone", diag_log ? ", hit views and gesture states written down (ccdiag=1)" : "");
+}
