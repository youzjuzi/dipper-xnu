+			__atomic_fetch_add(&target_copy_fallback, 1, __ATOMIC_RELAXED);
+			__atomic_fetch_add(&target_copy_counts[reason], 1, __ATOMIC_RELAXED);
+			__atomic_fetch_add(&target_copy_fail_us, elapsed, __ATOMIC_RELAXED);
+		}
