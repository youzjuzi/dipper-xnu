+	glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+	glGenTextures(2, textures);
+	gl->swizzle_supported = 1;
+	glBindTexture(GL_TEXTURE_2D, textures[0]);
+	good &= redwood_gl_surface_swizzle(gl, 1);
+	glBindTexture(GL_TEXTURE_2D, textures[1]);
+	glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_R, &value);
+	good &= value == GL_RED;
+	glBindTexture(GL_TEXTURE_2D, textures[0]);
+	glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_R, &value);
+	good &= value == GL_BLUE;
+	good &= redwood_gl_surface_swizzle(gl, 0);
+	for (unsigned i = 0; i < 4; i++) {
+		static const int identity[] = { GL_RED, GL_GREEN, GL_BLUE, GL_ALPHA };
+		glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_R + i, &value);
+		good &= value == identity[i];
+	}
+	good &= glGetError() == 0 && textures[0] != 0 && textures[1] != 0;
+	glBindTexture(GL_TEXTURE_2D, (unsigned)bound);
+	glDeleteTextures(2, textures);
+	gl->swizzle_supported = good;
+	return good;
+}
