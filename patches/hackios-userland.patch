+static bool
+surface_from_mirror(struct eagl *e, struct image *image)
+{
+	GLint read = 0, draw = 0, bound = 0, unpack = 0;
+	GLboolean boxed = glIsEnabled(GL_SCISSOR_TEST);
+	unsigned reason = TGT_GL;
+	bool copied = false;
+	uint64_t began = fprof_interval ? now_us() : 0;
