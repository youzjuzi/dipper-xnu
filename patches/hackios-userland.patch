+	glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, image->mirror, 0);
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, e->writer);
+	glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, image->texture, 0);
+	reason = TGT_READ;
+	if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) goto done;
+	reason = TGT_DRAW;
+	if (glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) goto done;
+	reason = TGT_GL;
+	if (glGetError() != 0) goto done;
+	/* Announce the CPU contents even when this client's surface BO already exists. */
+	reason = TGT_LOCK;
+	if (IOSurfaceLock(surface, 0, NULL) != 0) goto done;
+	if (IOSurfaceUnlock(surface, 0, NULL) != 0) goto done;
