+		Method count = item ? class_getInstanceMethod(item, sel_registerName("_barCountForUpdate:")) : NULL;
+
+		if (count != NULL) {
+			original_bar_count = (long (*)(id, SEL, id))method_getImplementation(count);
+			method_setImplementation(count, (IMP)wifi_bar_count);
+			say("redwood: wifi: -[_UIStatusBarWifiItem _barCountForUpdate:] replaced (types \"%s\")\n", method_getTypeEncoding(count));
+		}
+	}
+	if (!done && tries++ < 6) {
+		/* UIKit's classes may not be there yet: look again soon */
+		dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+			wifi_signal_view_hook();
+		});
+	} else if (!done) {
+		say("redwood: wifi: no signal view class found\n");
 	}
 }
 
