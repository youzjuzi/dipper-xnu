+/* The connection to the kernel's GPU service, for the requests that are not the library's (damage, the scaled frame). */
+static io_connect_t
+gpu_connection(void)
+{
+	if (damage_connection == 0 && !damage_asked) {
+		io_service_t service = IOServiceGetMatchingService(0, IOServiceMatching("RedwoodGPU"));
+
+		damage_asked = 1;
+		if (service != 0) {
+			if (IOServiceOpen(service, mach_task_self(), 0, &damage_connection) != 0) {
+				damage_connection = 0;
+			}
+			IOObjectRelease(service);
+		}
+	}
+	return damage_connection;
+}
+
+static void
+damage_send(struct image *image)
+{
+	struct { int32_t box[4]; uint32_t full; } call = { { 0, 0, 0, 0 }, 1 };
+
+	if (!damage_on || !image->target || image->width < 1000 || image->height < 2000) {
+		return;
+	}
+	gpu_connection();
+	if (damage_connection == 0) {
+		return;
+	}
+	if (image->dmg_any && !image->dmg_full) {
+		/* (a texture's rows count from the bottom; the surface's memory from the top where the frame is copied upside down) */
+		GLint y0 = image->dmg[1] < 0 ? 0 : image->dmg[1], y1 = image->dmg[3] > image->height ? image->height : image->dmg[3];
+		GLint x0 = image->dmg[0] < 0 ? 0 : image->dmg[0], x1 = image->dmg[2] > image->width ? image->width : image->dmg[2];
