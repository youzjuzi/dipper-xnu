+/*
+ * The Wi-Fi bars of the status bar are drawn by UIKit's signal view (_UIStatusBarWifiSignalView, of the base class
+ * _UIStatusBarSignalView), whose "signal mode" says how: 0 inactive (every bar grey), 1 searching, 2 active (the bars that
+ * count dark). The cellular view stays inactive here for want of CommCenter (hakios, upstream, replaces its setSignalMode:);
+ * the Wi-Fi view is fed by wifid's link-quality events, and with the radio joined and en0 given an address it is still grey
+ * (EXP-0221..0230). So, while en0 has an IPv4 address, the Wi-Fi view is made active -- and what it is asked, and how many
+ * bars it is told, is said in the log once each, to see what the system itself wanted (EXP-0231).
+ */
+static bool wifi_has_address(void);
+extern id objc_loadWeak(id *location);
+extern id objc_storeWeak(id *location, id obj);
+static void (*original_wifi_signal_mode)(id self, SEL sel, long mode);
+static void (*original_wifi_active_bars)(id self, SEL sel, long bars);
+static long (*original_bar_count)(id self, SEL sel, id update);
+
+static long
+wifi_bar_count(id self, SEL sel, id update)
+{
+	static unsigned said;
+	long count = original_bar_count(self, sel, update);
+
+	if (said < 6) {
+		said++;
+		say("redwood: wifi: the item counts %ld bars (address %s)\n", count, wifi_has_address() ? "there" : "not there");
+	}
+	return count < 3 && wifi_has_address() ? 3 : count;
+}
+
+static bool
+wifi_has_address(void)
+{
+	static time_t checked;
+	static bool has;
+	time_t now = time(NULL);
+	struct ifaddrs *list = NULL, *a;
+
+	if (now == checked) {
+		return has;
+	}
+	checked = now;
+	has = false;
+	if (getifaddrs(&list) == 0) {
+		for (a = list; a != NULL; a = a->ifa_next) {
+			if (a->ifa_addr != NULL && a->ifa_addr->sa_family == AF_INET && strcmp(a->ifa_name, "en0") == 0) {
+				has = true;
+			}
+		}
+		freeifaddrs(list);
+	}
+	return has;
+}
+
+static void
+wifi_set_signal_mode(id self, SEL sel, long mode)
+{
+	static unsigned said_modes;
+	const char *name = object_getClassName(self);
+	bool wifi = name != NULL && strstr(name, "Wifi") != NULL;
+	long wanted = mode;
+
+	if (wifi && mode >= 0 && mode < 8 && !(said_modes & (1u << mode))) {
+		said_modes |= 1u << mode;
+		say("redwood: wifi: %s asked for signal mode %ld\n", name, mode);
+	}
+	if (wifi && mode != 2 && wifi_has_address()) {
+		wanted = 2;
+	}
+	original_wifi_signal_mode(self, sel, wanted);
+}
+
+static void
+wifi_set_active_bars(id self, SEL sel, long bars)
+{
+	static unsigned said_bars;
+	const char *name = object_getClassName(self);
+
+	bool wifi = name != NULL && strstr(name, "Wifi") != NULL;
+
+	if (wifi && bars >= 0 && bars < 8 && !(said_bars & (1u << bars))) {
+		said_bars |= 1u << bars;
+		say("redwood: wifi: %s told %ld active bars\n", name, bars);
+	}
+	if (wifi && bars < 3 && wifi_has_address()) {
+		bars = 3;
+	}
+	original_wifi_active_bars(self, sel, bars);
+}
+
+
+/* what the Wi-Fi bars' classes offer (names only), once: to find the method that really sets their look (EXP-0232) */
+static void
+wifi_classes_dump(void)
+{
+	unsigned count = 0, i;
+	Class *list = objc_copyClassList(&count);
+
+	for (i = 0; i < count; i++) {
+		const char *name = class_getName(list[i]);
+
+		if (name != NULL && (strstr(name, "StatusBarWifi") != NULL || strcmp(name, "_UIStatusBarSignalView") == 0)) {
+			unsigned n = 0, m;
+			Method *methods = class_copyMethodList(list[i], &n);
+			char line[1100];
+			size_t used = (size_t)snprintf(line, sizeof(line), "redwood: wifi: class %s (super %s):", name,
+			    class_getSuperclass(list[i]) ? class_getName(class_getSuperclass(list[i])) : "-");
+
+			for (m = 0; m < n && used < sizeof(line) - 80; m++) {
+				used += (size_t)snprintf(line + used, sizeof(line) - used, " %s", sel_getName(method_getName(methods[m])));
+			}
+			say("%s\n", line);
+			free(methods);
+		}
+	}
+	free(list);
+}
