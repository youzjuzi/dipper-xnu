 {
 	(void)fd;
+	/*
+	 * DRM_MSM_GEM_MADVISE (freedreno's buffer cache asks about every buffer it reuses): the kernel's answer
+	 * is always "retained" and it does nothing else (RedwoodGPU.cpp, kMsmGemMadvise), and a request costs
+	 * a round trip of ~13 us, ~37 a frame (EXP-0175). Answered here; the count is kept.
+	 */
+	if (index == 0x08 && size >= 12) {
+		((uint32_t *)data)[2] = 1;
+		redwood_drm_calls[DRM_COMMAND_BASE + index]++;
