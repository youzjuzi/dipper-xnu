+/*
+ * The flashlight (EXP-0144): Control Center's button and the lock screen's reach AVFlashlight, which asks mediaserverd's
+ * FigFlashlight -- and there is no mediaserverd here. So in SpringBoard AVFlashlight is given the kernel's light instead
+ * (/dev/redwood-torch, boot-arg torch=3, bsd/dev/redwood_torch.c: 0 to 1000 thousandths of the phone's torch current, the
+ * kernel's own limits on time and temperature apply). Where the device is not there, nothing is changed. Every call is
+ * said (the first so many), since which of AVFlashlight's methods the button uses is not known.
+ */
+static int torch_fd = -1;
+static float torch_level = 1.0f;                        /* what turnPowerOn lights; set by setFlashlightLevel: */
+static bool torch_lit, torch_installed;
+static unsigned torch_told;
+
+static void
+torch_send(uint32_t thousandths)
+{
+	ssize_t n;
+
+	if (torch_fd < 0 && (torch_fd = open("/dev/redwood-torch", O_WRONLY)) < 0) {
+		say("redwood: flashlight: /dev/redwood-torch cannot be opened (%d)\n", errno);
+		return;
+	}
+	n = write(torch_fd, &thousandths, sizeof(thousandths));
+	if (torch_told++ < 60 || n != (ssize_t)sizeof(thousandths)) {
+		say("redwood: flashlight: %u of 1000 asked of the kernel%s\n", thousandths, n == (ssize_t)sizeof(thousandths) ? "" : " (NOT TAKEN)");
+	}
+}
+
+static id
+flashlight_init(id self, __unused SEL selector)
+{
+	if (torch_told++ < 60) {
+		say("redwood: flashlight: -[AVFlashlight init]\n");
+	}
+	return self;
+}
+
+static BOOL
+flashlight_yes(__unused id self, __unused SEL selector)
+{
+	return YES;
+}
+
+static BOOL
+flashlight_no(__unused id self, __unused SEL selector)
+{
+	return NO;
+}
+
+static float
+flashlight_get_level(__unused id self, __unused SEL selector)
+{
+	return torch_lit ? torch_level : 0.0f;
+}
+
+static BOOL
+flashlight_set_level(id self, __unused SEL selector, float level, __unused id *error)
+{
+	level = level < 0.0f ? 0.0f : level > 1.0f ? 1.0f : level;
+	SEND1(void, self, "willChangeValueForKey:", id, (id)CFSTR("flashlightLevel"));
+	if (level > 0.0f) {
+		torch_level = level;
+	}
+	torch_lit = level > 0.0f;
+	torch_send((uint32_t)(level * 1000.0f + 0.5f));
+	SEND1(void, self, "didChangeValueForKey:", id, (id)CFSTR("flashlightLevel"));
+	return YES;
+}
+
+static BOOL
+flashlight_power_on(id self, __unused SEL selector, __unused id *error)
+{
+	SEND1(void, self, "willChangeValueForKey:", id, (id)CFSTR("flashlightLevel"));
+	torch_lit = true;
+	torch_send((uint32_t)(torch_level * 1000.0f + 0.5f));
+	SEND1(void, self, "didChangeValueForKey:", id, (id)CFSTR("flashlightLevel"));
+	return YES;
+}
+
+static void
+flashlight_power_off(id self, __unused SEL selector)
+{
+	SEND1(void, self, "willChangeValueForKey:", id, (id)CFSTR("flashlightLevel"));
+	torch_lit = false;
+	torch_send(0);
+	SEND1(void, self, "didChangeValueForKey:", id, (id)CFSTR("flashlightLevel"));
+}
+
+/* Once AVFlashlight is there (its framework may come late, with the Control Center module), and the kernel has the light. */
+static void
+flashlight_install(void)
+{
+	static const struct { const char *selector; IMP implementation; } methods[] = {
+		{ "init", (IMP)flashlight_init },
+		{ "isAvailable", (IMP)flashlight_yes },
+		{ "isOverheated", (IMP)flashlight_no },
+		{ "flashlightLevel", (IMP)flashlight_get_level },
+		{ "setFlashlightLevel:withError:", (IMP)flashlight_set_level },
+		{ "turnPowerOnWithError:", (IMP)flashlight_power_on },
+		{ "turnPowerOff", (IMP)flashlight_power_off },
+	};
+	Class cls;
+	unsigned count = 0;
+	Method *list;
+
+	if (torch_installed || (cls = objc_getClass("AVFlashlight")) == NULL) {
+		return;
+	}
+	if (access("/dev/redwood-torch", W_OK) != 0) {
+		return;                 /* (no torch=3 in this run: AVFlashlight stays what it is; looked at again when another image comes) */
+	}
+	torch_installed = true;
+	list = class_copyMethodList(cls, &count);
+	for (unsigned i = 0; i < count; i++) {
+		say("redwood: flashlight: -[AVFlashlight %s]\n", sel_getName(method_getName(list[i])));
+	}
+	free(list);
+	for (size_t i = 0; i < sizeof(methods) / sizeof(methods[0]); i++) {
+		Method method = class_getInstanceMethod(cls, sel_registerName(methods[i].selector));
+
+		if (method != NULL) {
+			method_setImplementation(method, methods[i].implementation);
+		} else {
+			say("redwood: flashlight: AVFlashlight has no %s\n", methods[i].selector);
+		}
+	}
+	say("redwood: flashlight: AVFlashlight is the kernel's light (/dev/redwood-torch)\n");
+}
