+static bool
+scan_call(uint32_t op, uint32_t surface, uint32_t *width, uint32_t *height)
+{
+	struct { uint32_t op, surface, width, height; } call = { op, surface, 0, 0 };
+	size_t size = sizeof(call);
+	io_connect_t connection = gpu_connection();
+
+	if (connection == 0 || IOConnectCallStructMethod(connection, 0x7b, &call, sizeof(call), &call, &size) != 0) {
+		return false;
+	}
+	if (width != NULL) {
+		*width = call.width;
+		*height = call.height;
+	}
