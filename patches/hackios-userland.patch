+/* ---- gestalt ------------------------------------------------------------------------------------------ */
+
+/* EXP-0234: what MobileGestalt says of the screen: a wide-gamut one makes WebKit draw its tiles in 10-bit surfaces we do not have */
+static void
+gestalt_look(void)
+{
+	void *handle = dlopen("/usr/lib/libMobileGestalt.dylib", RTLD_NOW);
+	CFTypeRef (*copy)(CFStringRef) = handle ? (CFTypeRef (*)(CFStringRef))dlsym(handle, "MGCopyAnswer") : NULL;
+	const char *keys[] = { "HasExtendedColorDisplay", "main-screen-scale", "main-screen-width", "main-screen-height", "DeviceSupportsP3", "ArtworkDeviceSubType" };
+
+	if (copy == NULL) {
+		printf("net_test: gestalt: no MGCopyAnswer\n");
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
+		CFStringRef key = CFStringCreateWithCString(NULL, keys[i], kCFStringEncodingUTF8);
+		CFTypeRef answer = copy(key);
+		NSString *text = answer ? [(__bridge id)answer description] : @"(none)";
+
+		printf("net_test: gestalt: %s = %s\n", keys[i], text.UTF8String);
+		if (answer) {
+			CFRelease(answer);
+		}
+		CFRelease(key);
+	}
+}
