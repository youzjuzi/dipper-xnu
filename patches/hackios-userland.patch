+/* ---- path ------------------------------------------------------------------------------------------- */
+
+/*
+ * What an application is told about the network: Network.framework's path (what NWPathMonitor shows Music,
+ * Safari and the status bar's data). EXP-0226: Music says "You are offline" with Wi-Fi joined and DHCP done.
+ */
+static void
+path_look(double seconds)
+{
+	dispatch_queue_t queue = dispatch_queue_create("net_test.path", DISPATCH_QUEUE_SERIAL);
+	nw_path_monitor_t monitor = nw_path_monitor_create();
+
+	nw_path_monitor_set_queue(monitor, queue);
+	nw_path_monitor_set_update_handler(monitor, ^(nw_path_t path) {
+		nw_path_status_t status = nw_path_get_status(path);
+		NSMutableString *interfaces = [NSMutableString string];
+
+		nw_path_enumerate_interfaces(path, ^bool (nw_interface_t interface) {
+			[interfaces appendFormat:@" %s(type %d)", nw_interface_get_name(interface), (int)nw_interface_get_type(interface)];
+			return true;
+		});
+		printf("net_test: path: status %d (1 satisfied, 2 unsatisfied, 3 satisfiable); wifi %d cellular %d wired %d; ipv4 %d ipv6 %d dns %d; "
+		    "expensive %d constrained %d; interfaces:%s\n", (int)status, nw_path_uses_interface_type(path, nw_interface_type_wifi),
+		    nw_path_uses_interface_type(path, nw_interface_type_cellular), nw_path_uses_interface_type(path, nw_interface_type_wired),
+		    nw_path_has_ipv4(path), nw_path_has_ipv6(path), nw_path_has_dns(path), nw_path_is_expensive(path),
+		    nw_path_is_constrained(path), interfaces.UTF8String);
+	});
+	nw_path_monitor_start(monitor);
+	usleep((useconds_t)(seconds * 1e6));
+	nw_path_monitor_cancel(monitor);
+}
