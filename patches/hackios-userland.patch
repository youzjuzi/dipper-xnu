+		call.box[0] = x0;
+		call.box[1] = image->invert ? image->height - y1 : y0;
+		call.box[2] = x1 - x0;
+		call.box[3] = y1 - y0;
+		call.full = call.box[2] <= 0 || call.box[3] <= 0;
+	}
+	image->dmg_any = image->dmg_full = false;
+	IOConnectCallStructMethod(damage_connection, 0x7c, &call, sizeof(call), NULL, NULL);
