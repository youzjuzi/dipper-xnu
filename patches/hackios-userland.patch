+/* ---- samples ------------------------------------------------------------------------------------------ */
+
+/*
+ * EXP-0235: where the threads of a hung program stand, as sample(1) shows it: the registers of each thread of every process whose
+ * name has one of the NEEDLES, and the frame-pointer chain behind them; each address named by dladdr() here -- the shared cache is at
+ * the same address in every process. Each process is looked at at most three times.
+ */
+extern kern_return_t task_read_for_pid(mach_port_t target, int pid, mach_port_t *task);
+extern kern_return_t task_inspect_for_pid(mach_port_t target, int pid, mach_port_t *task);
+
+static void
+sample_one(pid_t pid, const char *comm)
+{
+	task_t task = MACH_PORT_NULL;
+	thread_act_array_t threads = NULL;
+	mach_msg_type_number_t count = 0;
+	kern_return_t kr, results[3];
+	const char *kinds[3] = { "task_for_pid", "task_read_for_pid", "task_inspect_for_pid" };
+	unsigned kind;
+
+	for (kind = 0; kind < 3; kind++) {
+		task = MACH_PORT_NULL;
+		/*
+		 * EXP-0235 e: the read port only. With cs_relax_platform_task_ports=1 a control port of another task would get through
+		 * task_for_pid, and using it without Developer Mode panics the kernel (task_conversion_eval_internal, ipc_tt.c).
+		 */
+		if (kind == 0) {
+			results[kind] = KERN_NOT_SUPPORTED;
+			continue;
+		}
+		kr = kind == 1 ? task_read_for_pid(mach_task_self(), pid, &task) : task_inspect_for_pid(mach_task_self(), pid, &task);
+		results[kind] = kr;
+		if (kr == KERN_SUCCESS && task != MACH_PORT_NULL) {
+			kr = task_threads(task, &threads, &count);
+			results[kind] = kr == KERN_SUCCESS ? 0 : kr;
+			if (kr == KERN_SUCCESS) {
+				break;
+			}
+		}
+	}
+	if (kind == 3) {
+		printf("net_test: sample %s[%d]: no way in: %s %d, %s %d, %s %d\n", comm, pid, kinds[0], results[0], kinds[1], results[1], kinds[2],
+		    results[2]);
+		return;
+	}
+	{
+		/* EXP-0235 d: a task or thread suspended by RunningBoard shows as a nonzero suspend count -- the one guess that needs no registers */
+		struct task_basic_info_64 tbi;
+		mach_msg_type_number_t tbi_count = TASK_BASIC_INFO_64_COUNT;
+		kern_return_t tkr = task_info(task, TASK_BASIC_INFO_64, (task_info_t)&tbi, &tbi_count);
+
+		printf("net_test: sample %s[%d]: through %s, task_info %d, task suspend %d, %u threads\n", comm, pid, kinds[kind], tkr,
+		    tkr == KERN_SUCCESS ? tbi.suspend_count : -1, count);
+	}
+	for (mach_msg_type_number_t t = 0; t < count; t++) {
+		arm_thread_state64_t state;
+		mach_msg_type_number_t state_count = ARM_THREAD_STATE64_COUNT;
+		thread_basic_info_data_t basic;
+		mach_msg_type_number_t basic_count = THREAD_BASIC_INFO_COUNT;
+		uint64_t frames[14];
+		unsigned n = 0;
+		char line[1600];
+		size_t used;
+		uint64_t fp;
+
+		kern_return_t skr, ikr;
+
+		memset(&basic, 0, sizeof(basic));
+		ikr = thread_info(threads[t], THREAD_BASIC_INFO, (thread_info_t)&basic, &basic_count);
+		skr = thread_get_state(threads[t], ARM_THREAD_STATE64, (thread_state_t)&state, &state_count);
+		if (skr != KERN_SUCCESS) {
+			printf("net_test: sample %s[%d] thread %u: no registers (%d); info %d run %d suspend %d sleep %ds cpu %d%% flags %#x\n", comm, pid,
+			    t, skr, ikr, basic.run_state, basic.suspend_count, basic.sleep_time, basic.cpu_usage / 10, basic.flags);
+			mach_port_deallocate(mach_task_self(), threads[t]);
+			continue;
+		}
+		frames[n++] = state.__pc;
+		frames[n++] = state.__lr;
+		fp = state.__fp;
+		while (n < 14 && fp != 0 && (fp & 7) == 0) {
+			uint64_t pair[2];
+			vm_size_t got = 0;
+
+			if (vm_read_overwrite(task, (vm_address_t)fp, sizeof(pair), (vm_address_t)pair, &got) != KERN_SUCCESS || got != sizeof(pair) ||
+			    pair[1] == 0) {
+				break;
+			}
+			frames[n++] = pair[1];
+			if (pair[0] <= fp) {
+				break;
+			}
+			fp = pair[0];
+		}
+		used = (size_t)snprintf(line, sizeof(line), "net_test: sample %s[%d] thread %u (state %d, suspend %d, sleep %ds, cpu %d%%):", comm, pid, t,
+		    basic.run_state, basic.suspend_count, basic.sleep_time, basic.cpu_usage / 10);
+		for (unsigned i = 0; i < n && used < sizeof(line) - 120; i++) {
+			Dl_info info;
+
+			if (dladdr((void *)frames[i], &info) && info.dli_sname != NULL && strcmp(info.dli_sname, "<redacted>") != 0) {
+				const char *lib = info.dli_fname ? strrchr(info.dli_fname, '/') : NULL;
+
+				used += (size_t)snprintf(line + used, sizeof(line) - used, " %s(%s)+%llu", info.dli_sname, lib ? lib + 1 : "?",
+				    (unsigned long long)(frames[i] - (uint64_t)info.dli_saddr));
+			} else if (info.dli_fbase != NULL) {
+				/* EXP-0235 f: a redacted name as library + offset from its Mach-O header, for naming it offline from the dyld cache */
+				const char *lib = info.dli_fname ? strrchr(info.dli_fname, '/') : NULL;
+
+				used += (size_t)snprintf(line + used, sizeof(line) - used, " %s+%#llx", lib ? lib + 1 : "?",
+				    (unsigned long long)(frames[i] - (uint64_t)info.dli_fbase));
+			} else {
+				used += (size_t)snprintf(line + used, sizeof(line) - used, " %#llx", (unsigned long long)frames[i]);
+			}
+		}
+		printf("%s\n", line);
+		mach_port_deallocate(mach_task_self(), threads[t]);
+	}
+	vm_deallocate(mach_task_self(), (vm_address_t)threads, count * sizeof(thread_t));
+	mach_port_deallocate(mach_task_self(), task);
+}
+
+static void
+samples_look(unsigned rounds, double interval)
+{
+	static const char *const needles[] = { "WebKi", "WebContent", "MobileSafari", "GPU", "Networking" };
+	struct { pid_t pid; unsigned looked; } seen[64] = { { 0, 0 } };
+	int safari_round = -1;
+
+	for (unsigned round = 0; round < rounds; round++) {
+		int mib[4] = { CTL_KERN, KERN_PROC, KERN_PROC_ALL, 0 };
+		size_t size = 0;
+		struct kinfo_proc *list;
+
+		usleep((useconds_t)(interval * 1e6));
+		if (sysctl(mib, 3, NULL, &size, NULL, 0) != 0 || (list = malloc(size)) == NULL) {
+			continue;
+		}
+		if (sysctl(mib, 3, list, &size, NULL, 0) == 0) {
+			for (size_t i = 0; i < size / sizeof(*list); i++) {
+				const char *comm = list[i].kp_proc.p_comm;
+				pid_t pid = list[i].kp_proc.p_pid;
+
+				for (unsigned k = 0; k < sizeof(needles) / sizeof(needles[0]); k++) {
+					unsigned slot;
+
+					if (strstr(comm, needles[k]) == NULL) {
+						continue;
+					}
+					if (safari_round < 0 && strstr(comm, "MobileSafari") != NULL) {
+						safari_round = (int)round;
+					}
+					for (slot = 0; slot < 64 && seen[slot].pid != 0 && seen[slot].pid != pid; slot++) {
+					}
+					if (slot < 64 && seen[slot].looked < 3) {
+						seen[slot].pid = pid;
+						/* the first look is at once, the others a few rounds apart, so that a hang shows as the same place twice */
+						if (seen[slot].looked == 0 || round % 3 == 0) {
+							seen[slot].looked++;
+							sample_one(pid, comm);
+						}
+					}
+				}
+			}
+		}
+		/* EXP-0235 f: about 60 s after Safari shows, every process once -- the one Safari waits on is somewhere among them */
+		if (safari_round >= 0 && (int)round == safari_round + 4) {
+			printf("net_test: sample all: begin\n");
+			for (size_t i = 0; i < size / sizeof(*list); i++) {
+				pid_t pid = list[i].kp_proc.p_pid;
+
+				if (pid > 0 && pid != getpid()) {
+					sample_one(pid, list[i].kp_proc.p_comm);
+				}
+			}
+			printf("net_test: sample all: end\n");
+		}
+		free(list);
+	}
+}
