+	uint64_t began = mach_absolute_time();
 	kern_return_t result = IOConnectCallStructMethod(connection, number, data, size, data, &returned);
 
+	redwood_drm_calls[number & 0xff]++;
+	redwood_drm_ticks[number & 0xff] += mach_absolute_time() - began;
+	redwood_drm_total[0]++;
+	redwood_drm_total[1] += mach_absolute_time() - began;
+
 	switch (result) {
 	case 0:
 		return 0;
@@ -99,6 +116,16 @@ int
