+ * DRM_COMMAND_BASE + DRM_MSM_GEM_SUBMIT, EXP-0174). Visible outside this library on purpose.
+ */
+__attribute__((visibility("default"))) unsigned long redwood_drm_calls[256];
+__attribute__((visibility("default"))) unsigned long redwood_drm_ticks[256];
+/* ... and all requests together: [0] how many, [1] ticks (EXP-0175: which GL calls spend time in the kernel, whatever the request) */
+__attribute__((visibility("default"))) unsigned long redwood_drm_total[2];
