+		hit[4] |= strstr(image, "IOMobileFramebuffer") != NULL;
+		for (unsigned k = 0; k < sizeof(fprof_ranges) / sizeof(fprof_ranges[0]); k++) {
+			if (!strcmp(image, fprof_ranges[k].image) && offset >= fprof_ranges[k].first && offset < fprof_ranges[k].end)
+				hit[fprof_ranges[k].category] = true;
+		}
+	}
+	hit[0] = iosurface && iokit;
+	for (unsigned i = 0; i < 5; i++) if (hit[i]) return i;
+	return 5;
+}
+
+static int
+fprof_leaf_compare(const void *va, const void *vb)
+{
+	uintptr_t a = *(const uintptr_t *)va, b = *(const uintptr_t *)vb;
+	return a < b ? -1 : a != b;
+}
+
+static void
+fprof_aggregate(unsigned count, unsigned batch, unsigned stacks)
+{
+	static uintptr_t leaves[FPROF_SAMPLES];
+	static struct { const char *name; unsigned n; } images[FPROF_SAMPLES];
+	unsigned categories[6] = {0}, image_count = 0, top_at[40] = {0}, top_n[40] = {0};
+	for (unsigned i = 0; i < count; i++) {
+		leaves[i] = fprof_samples[i].pc[0];
+		categories[fprof_category(&fprof_samples[i])]++;
+		uintptr_t off;
+		const char *name = fprof_location(leaves[i], &off);
+		unsigned k;
+		for (k = 0; k < image_count && strcmp(images[k].name, name); k++) {}
+		if (k == image_count) { images[k].name = name; images[k].n = 0; image_count++; }
+		images[k].n++;
+	}
+	qsort(leaves, count, sizeof(*leaves), fprof_leaf_compare);
+	for (unsigned at = 0; at < count;) {
+		unsigned end = at + 1;
+		while (end < count && leaves[end] == leaves[at]) end++;
+		for (unsigned i = 0; i < 40; i++) if (end - at > top_n[i]) {
+			for (unsigned j = 39; j > i; j--) { top_at[j] = top_at[j-1]; top_n[j] = top_n[j-1]; }
+			top_at[i] = at; top_n[i] = end - at; break;
+		}
+		at = end;
+	}
+	unsigned leaf_hits = 0;
+	for (unsigned i = 0; i < 40 && top_n[i]; i++) {
+		uintptr_t offset; const char *name = fprof_location(leaves[top_at[i]], &offset);
+		unsigned pct = top_n[i] * 10000 / count; leaf_hits += top_n[i];
+		say("tl: prof leaf %u.%02u%% %s+0x%llx batch=%u hits=%u samples=%u\n", pct/100, pct%100,
+		    name, (unsigned long long)offset, batch, top_n[i], count);
+	}
+	for (unsigned i = 0; i < image_count; i++) {
+		unsigned pct = images[i].n * 10000 / count;
+		say("tl: prof image %s %u.%02u%% batch=%u hits=%u samples=%u\n", images[i].name, pct/100, pct%100, batch, images[i].n, count);
+	}
+	for (unsigned i = 0; i < 6; i++) {
+		unsigned pct = categories[i] * 10000 / count;
+		say("tl: prof category %s %u.%02u%% batch=%u hits=%u samples=%u\n", fprof_categories[i], pct/100, pct%100, batch, categories[i], count);
+	}
+	unsigned stack_pct = stacks * 10000 / count, leaf_pct = leaf_hits * 10000 / count;
+	say("tl: prof coverage batch=%u samples=%u stack_hits=%u leaf_hits=%u image_hits=%u category_hits=%u stack_pct=%u.%02u leaf_pct=%u.%02u image_pct=100 category_pct=100\n",
+	    batch, count, stacks, leaf_hits, count, count, stack_pct/100, stack_pct%100, leaf_pct/100, leaf_pct%100);
+}
+
+static void
+fprof_report(unsigned count)
+{
+	unsigned top_at[30] = {0}, top_n[30] = {0};
+	qsort(fprof_samples, count, sizeof(fprof_samples[0]), fprof_sample_compare);
+	for (unsigned at = 0; at < count;) {
+		unsigned end = at + 1;
+		while (end < count && fprof_sample_compare(&fprof_samples[at], &fprof_samples[end]) == 0) end++;
+		for (unsigned i = 0; i < 30; i++) {
+			if (end - at > top_n[i]) {
+				for (unsigned j = 29; j > i; j--) { top_at[j] = top_at[j-1]; top_n[j] = top_n[j-1]; }
+				top_at[i] = at; top_n[i] = end - at; break;
+			}
+		}
+		at = end;
+	}
+	static unsigned batch;
+	batch++;
+	say("tl: prof batch %u samples %u\n", batch, count);
+	for (unsigned i = 0; i < 30 && top_n[i]; i++) {
+		char line[960];
+		unsigned pct = top_n[i] * 10000 / count;
+		int used = snprintf(line, sizeof(line), "tl: prof %u.%02u%% ", pct / 100, pct % 100);
+		struct fprof_sample *s = &fprof_samples[top_at[i]];
+		for (unsigned j = 0; j < s->depth && used < 800; j++) {
+			Dl_info info;
+			const char *name = "unknown";
+			uintptr_t offset = s->pc[j];
+			if (dladdr((void *)s->pc[j], &info) != 0 && info.dli_fbase && info.dli_fname) {
+				const char *slash = strrchr(info.dli_fname, '/');
+				name = slash ? slash + 1 : info.dli_fname;
+				offset -= (uintptr_t)info.dli_fbase;
+			}
+			used += snprintf(line + used, sizeof(line) - (size_t)used, "%s%s+0x%llx",
+			    j ? " <- " : "", name, (unsigned long long)offset);
+		}
+		say("%s batch=%u hits=%u samples=%u\n", line, batch, top_n[i], count);
+	}
+	unsigned stack_hits = 0;
+	for (unsigned i = 0; i < 30; i++) stack_hits += top_n[i];
+	fprof_aggregate(count, batch, stack_hits);
+}
+
+static void *
+fprof_sampler(void *unused)
+{
+	(void)unused;
+	unsigned samples = 0, run = 0, wait = 0, errors = 0, suspend_errors = 0;
+	uint64_t last = now_us(), suspend_us = 0;
+	uint64_t stop_ticks = 0, state_ticks = 0, walk_ticks = 0, resume_ticks = 0, sampler_cpu_us = 0;
+	/* Warm the MIG reply port and lazy bindings before a target can be suspended. */
+	arm_thread_state64_t warm;
+	mach_msg_type_number_t warm_count = ARM_THREAD_STATE64_COUNT;
+	thread_t self = mach_thread_self();
+	(void)thread_get_state(self, ARM_THREAD_STATE64, (thread_state_t)&warm, &warm_count);
+	(void)thread_resume(self); /* Not suspended: expected failure, no state change. */
+	mach_port_deallocate(mach_task_self(), self);
+	for (;;) {
+		usleep(fprof_interval);
+		thread_basic_info_data_t info;
+		mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+		if (thread_info(fprof_target, THREAD_BASIC_INFO, (thread_info_t)&info, &count) != KERN_SUCCESS) {
+			errors++;
+		} else if (info.run_state != TH_STATE_RUNNING || info.suspend_count != 0) {
+			wait++;
+			__atomic_fetch_add(&fprof_wait_total, 1, __ATOMIC_RELAXED);
+		} else {
+			run++;
+			__atomic_fetch_add(&fprof_run_total, 1, __ATOMIC_RELAXED);
+			struct fprof_sample s = {{0}, 0};
+			arm_thread_state64_t state;
+			count = ARM_THREAD_STATE64_COUNT;
+			uint64_t began = now_us();
+			int64_t cpu_began = fprof_cpu_us();
+			uint64_t t0 = mach_absolute_time(), t1 = t0, t2 = t0, t3 = t0, t4;
+			if (thread_suspend(fprof_target) == KERN_SUCCESS) {
+				/* Warmed lock-free commpage timestamps; no formatting/allocation while suspended. */
+				t1 = mach_absolute_time();
+				if (thread_get_state(fprof_target, ARM_THREAD_STATE64, (thread_state_t)&state, &count) == KERN_SUCCESS) {
+					t2 = mach_absolute_time();
+					uintptr_t sp = arm_thread_state64_get_sp(state);
+					uintptr_t fp = arm_thread_state64_get_fp(state);
+					s.pc[s.depth++] = arm_thread_state64_get_pc(state);
+					s.pc[s.depth++] = arm_thread_state64_get_lr(state);
+					uintptr_t high = sp <= UINTPTR_MAX - 1048576 ? sp + 1048576 : sp;
+					if (high > fprof_stack_high) high = fprof_stack_high;
+					for (unsigned i = 0; i < 7 && sp >= fprof_stack_low && sp < high; i++) {
+						if ((fp & 15) || fp < sp || fp < fprof_stack_low || high < 16 || fp > high - 16) break;
+						volatile const uintptr_t *record = (volatile const uintptr_t *)fp;
+						uintptr_t next = record[0], lr = record[1];
+						if (!lr) break;
+						s.pc[s.depth++] = lr;
+						if (next <= fp) break;
+						sp = fp + 16; fp = next;
+					}
+				} else {
+					t2 = mach_absolute_time();
+					suspend_errors++;
+				}
+				t3 = mach_absolute_time();
+				kern_return_t resumed = thread_resume(fprof_target);
+				/* Do not continue a run after an unbalanced suspension. No retry with extra holds. */
+				if (resumed != KERN_SUCCESS) _exit(125);
+			} else {
+				t1 = t2 = t3 = mach_absolute_time();
+				suspend_errors++;
+			}
+			t4 = mach_absolute_time();
+			stop_ticks += t1 - t0; state_ticks += t2 - t1;
+			walk_ticks += t3 - t2; resume_ticks += t4 - t3;
+			int64_t cpu_end = fprof_cpu_us();
+			if (cpu_end >= cpu_began && cpu_began >= 0) sampler_cpu_us += cpu_end - cpu_began;
+			suspend_us += now_us() - began;
+			if (s.depth) fprof_samples[samples++] = s;
+		}
+		uint64_t now = now_us();
+		if (now - last >= 1000000) {
+			say("tl: prof state run %u wait %u total %u at %llu span_us %llu errors %u suspend_us %llu suspend_errors %u\n",
+			    run, wait, run + wait + errors, now, now - last, errors, suspend_us, suspend_errors);
+			say("tl: prof cost at %llu stop_us %llu state_us %llu walk_us %llu resume_us %llu cpu_us %llu wall_us %llu run %u\n",
+			    now, (unsigned long long)(((__uint128_t)stop_ticks * fprof_timebase.numer) / fprof_timebase.denom / 1000),
+			    (unsigned long long)(((__uint128_t)state_ticks * fprof_timebase.numer) / fprof_timebase.denom / 1000),
+			    (unsigned long long)(((__uint128_t)walk_ticks * fprof_timebase.numer) / fprof_timebase.denom / 1000),
+			    (unsigned long long)(((__uint128_t)resume_ticks * fprof_timebase.numer) / fprof_timebase.denom / 1000),
+			    (unsigned long long)sampler_cpu_us, (unsigned long long)suspend_us, run);
+			run = wait = errors = suspend_errors = 0; suspend_us = 0; last = now;
+			stop_ticks = state_ticks = walk_ticks = resume_ticks = sampler_cpu_us = 0;
+		}
+		if (samples == FPROF_SAMPLES) { fprof_report(samples); samples = 0; }
+	}
+	return NULL;
+}
+
+static void
+fprof_start(void)
+{
+	unsigned expected = 0;
+	if (!__atomic_compare_exchange_n(&fprof_started, &expected, 1, false, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) return;
+	pthread_t self = pthread_self(), sampler;
+	__atomic_store_n(&fprof_pthread, self, __ATOMIC_RELEASE);
+	uintptr_t high = (uintptr_t)pthread_get_stackaddr_np(self);
+	size_t size = pthread_get_stacksize_np(self);
+	fprof_stack_high = high;
+	fprof_stack_low = size <= high ? high - size : high;
+	fprof_target = mach_thread_self();
+	if (pthread_create(&sampler, NULL, fprof_sampler, NULL) == 0) {
+		pthread_detach(sampler);
+		say("tl: prof enabled interval_us %u stack_bytes %zu state_semantics runnable\n", fprof_interval, size);
+	} else {
+		mach_port_deallocate(mach_task_self(), fprof_target);
+		say("tl: prof disabled sampler_create_failed\n");
+	}
+}
