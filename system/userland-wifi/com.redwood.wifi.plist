<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.redwood.wifi</string>
	<!-- with wifi=1 among the kernel's arguments: has configd configure the radio's interface (src/net_test.m,
	     "wifi"); without, it ends at once -->
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/net_test</string>
		<string>restartconfd</string>
		<string>waitaddr</string>
		<string>en0</string>
		<string>540</string>
		<string>show</string>
		<string>path</string>
		<string>3</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
